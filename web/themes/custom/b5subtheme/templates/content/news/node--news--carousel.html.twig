<div class="slide-item">
  <div class="slide-item-inner">
    <div class="slide-item-img">
      {% set image_class = ( node.field_images.0 ) ? 'img' : 'no-img' %}
      <figure class={{ image_class }} style="background-image: url({{ node.field_images.0|file_url }});"></figure>
    </div>
    <div class="slide-item-body">
      {% if label and not page %}
      <h2 class="card-title">
        <a href="{{ url }}" rel="bookmark">{{ node.label | smart_trim_chars(50, '…') }}</a>
      </h2>
      {% endif %}
      {% if display_submitted %}
      <div{{ author_attributes.addClass('node__submitted') }}>
        {{ date }}
      </div>
      {% endif %}
    </div>
  </div>
</div>
