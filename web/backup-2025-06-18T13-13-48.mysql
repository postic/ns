INSERT INTO `node_revision__body` VALUES ('article','0','44','451','en','0','<p>MILOVAN AMIDŽIĆ</p><p>Address: Trg slobode 1, Novi Sad<br>Phone: +381 21 525 850, 425 802<br>e-mail: <a href="mailto:milovan.amidzic@novisad.rs">milovan.amidzic@novisad.rs</a></p>','','basic_html'),('article','0','44','451','sr-Cyrl-RS','0','<p>МИЛОВАН АМИЏИЋ</p><p>Члан Градског већа за управу и прописе</p><p>Трг слободе 1, Нови Сад<br>Телефон: +381 21 525 850, 425 802</p><p>e-mail:&nbsp; <a href="mailto:milovan.amidzic@novisad.rs">milovan.amidzic@novisad.rs</a></p><p>Рођен је 28. новембра 1981. године у Јајцу. Завршио је Основну школу „Ђура Јакшић“ у Каћу, затим Гимназију „Светозар Марковић“ у Новом Саду. Дипломирао је на Правном факултету у Новом Саду 2008. године на смеру унутрашњих послова, а 2011. године на Правном факултету у Новом Саду, одбранио је мастер рад на тему „Уговори о кредиту са наменом“ из предмета банкарско право.</p><p>У претходном периоду, био је запослен у предузећу „Агрокоп” а.д. Нови Сад (2008-2010), као самостални стручни сарадник за опште и правне послове, а у предузећу „Фертил” доо Бачка Паланка био је руководилац Службе општих и правних послова (2010-2012).</p><p>У периоду од 2012. до 2016. године био је в.д. заменика начелника у Градској управи за опште и правне послове Града Новог Сада. Такође, био је и председник Надзорног одбора ЈКП „Зоохигијена и ветерина“ Нови Сад (2014-2015).</p><p>Дужност шефа Службе за заједничке послове Града Новог Сада&nbsp; врши у периоду од 2016. до 2017. године. В.д. директора ЈКП „Стан“ Нови Сад у периоду од 2017. до 2018, а в.д. директора ЈГСП „Нови Сад“ у периоду од 2018. до 2019. године.&nbsp;Директор ЈГСП „Нови Сад“ је у периоду од 2019. до 2020. године.</p><p>У периоду од 2020. до 2024. године именован је за члана Градског већа за управу, прописе и урбанизам.</p><p>У претходном мандату обаваљао је функцију члана Градског већа за управу, прописе, имовину и имовинско-правне послове, урбанизам и стамбене послове.</p><p>Ово му 