INSERT INTO `node_revision__body` VALUES ('page','0','4','134','sr-Latn-RS','0','<p>ЖАРКО МИЋИН</p><p>Градоначелник Новог Сада</p><p>Aдреса: Трг слободе 1, 21000 Нови Сад, Србија<br>Бр. тeл: + 381 21 522 451 и 522 377<br>Фaкс: + 381 21 525 931<br>e-mail: <a href="mailto:zarko.micin@novisad.rs">zarko.micin@novisad.rs</a></p><p>Жарко Мићин је рођен 1982. године у Новом Саду. Дипломирао је на Правном факултету у Новом Саду и положио правосудни испит. Успешно је завршио Високе студије безбедности и одбране као полазник 13. класе Школе националне одбране.</p><p>Своју професионалну каријеру започиње као адвокатски приправник у адвокатској канцеларији Бајић, а након тога као руководилац правне службе и директор у приватној компанији. Касније обавља функцију председника Надзорног одбора Хотела „Праг” Београд и члана Надзорног одбора Завода за судска вештачења АД.</p><p>Поседује искуство на руководећим позицијама у јавном сектору као извршни директор ЈП „Завод за изградњу Града“ Нови Сад, генерални директор ЈП „Спортски и пословни центар Војводина“ Нови Сад, извршни директор ЈП „Урбанизам“ – Завод за урбанизам Нови Сад. Обављао је функцију шефа Kабинета градоначелника Новог Сада и био координатор изградње и председник Kомисије за избор корисника 522 стана за избегла лица. Три пута је биран за народног посланика Народне скупштине Републике Србије. Био је члан Скупштинског одбора за европске интеграције, Одбора за правосуђе, државну управу и локалну самоуправу као и члан скупштинске делегације у Парламентарној скупштини Савета Европе.</p><p>Од 2018. до ступања на функцију 2021. године радио је као адвокат у сопственој адвокатској канцеларији Мићин. Председник је Управног одбора Југоимпорт СДПР Ј.П. Обављао је функцију шефа Kабинета потпредседника Владе и министра одбране, као и шефа Кабинета председника Владе.</p><p>За Градоначелника Новог Сада изабран је 24. фебруара 2025. године.</p><p>Редовно је одслужио војни рок. Течно говори енглески језик.</p><p>Ожењен је и отац две ћерке.</p>','','basic_html');
INSERT INTO `node_revision__body` VALUES ('page','0','4','135','en','0','<p>ЖАРКО МИЋИН</p><p>Градоначелник Новог Сада</p><p>Aдреса: Трг слободе 1, 21000 Нови Сад, Србија<br>Бр. тeл: + 381 21 522 451 и 522 377<br>Фaкс: + 381 21 525 931<br>e-mail: <a href="mailto:zarko.micin@novisad.rs">zarko.micin@novisad.rs</a></p><p>Жарко Мићин је рођен 1982. године у Новом Саду. Дипломирао је на Правном факултету у Новом Саду и положио правосудни испит. Успешно је завршио Високе студије безбедности и одбране као полазник 13. класе Школе националне одбране.</p><p>Своју професионалну каријеру започиње као адвокатски приправник у адвокатској канцеларији Бајић, а након тога као руководилац правне службе и директор у приватној компанији. Касније обавља функцију председника Надзорног одбора Хотела „Праг” Београд и члана Надзорног одбора Завода за судска вештачења АД.</p><p>Поседује искуство на руководећим позицијама у јавном сектору као извршни директор ЈП „Завод за изградњу Града“ Нови Сад, генерални директор ЈП „Спортски и пословни центар Војводина“ Нови Сад, извршни директор ЈП „Урбанизам“ – Завод за урбанизам Нови Сад. Обављао је функцију шефа Kабинета градоначелника Новог Сада и био координатор изградње и председник Kомисије за избор корисника 522 стана за избегла лица. Три пута је биран за народног посланика Народне скупштине Републике Србије. Био је члан Скупштинског одбора за европске интеграције, Одбора за правосуђе, државну управу и локалну самоуправу као и члан скупштинске делегације у Парламентарној скупштини Савета Европе.</p><p>Од 2018. до ступања на функцију 2021. године радио је као адвокат у сопственој адвокатској канцеларији Мићин. Председник је Управног одбора Југоимпорт СДПР Ј.П. Обављао је функцију шефа Kабинета потпредседника Владе и министра одбране, као и шефа Кабинета председника Владе.</p><p>За Градоначелника Новог Сада изабран је 24. фебруара 2025. године.</p><p>Редовно је одслужио војни рок. Течно говори енглески језик.</p><p>Ожењен је и отац две ћерке.</p>','','basic_html');
