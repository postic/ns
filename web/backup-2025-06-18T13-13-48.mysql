DROP TABLE IF EXISTS `node__body`;
CREATE TABLE `node__body` (   `bundle` varchar(128) CHARACTER SET ascii COLLATE ascii_general_ci NOT NULL DEFAULT '' COMMENT 'The field instance bundle to which this row belongs, used when deleting a field instance',   `deleted` tinyint(4) NOT NULL DEFAULT 0 COMMENT 'A boolean indicating whether this data item has been deleted',   `entity_id` int(10) unsigned NOT NULL COMMENT 'The entity id this data is attached to',   `revision_id` int(10) unsigned NOT NULL COMMENT 'The entity revision id this data is attached to',   `langcode` varchar(32) CHARACTER SET ascii COLLATE ascii_general_ci NOT NULL DEFAULT '' COMMENT 'The language code for this data item.',   `delta` int(10) unsigned NOT NULL COMMENT 'The sequence number for this data item, used for multi-value fields',   `body_value` longtext NOT NULL,   `body_summary` longtext DEFAULT NULL,   `body_format` varchar(255) CHARACTER SET ascii COLLATE ascii_general_ci DEFAULT NULL,   PRIMARY KEY (`entity_id`,`deleted`,`delta`,`langcode`),   KEY `bundle` (`bundle`),   KEY `revision_id` (`revision_id`),   KEY `body_format` (`body_format`) ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci COMMENT='Data storage for node field body.';
INSERT INTO `node__body` VALUES ('page','0','4','388','en','0','<p>ŽARKO MIĆIN</p><p>Mayor of Novi Sad</p><p>Address: Trg slobode 1, 21000 Novi Sad, Serbia<br>Tel. no.: + 381 21 522 451 and 522 377<br>Fax: + 381 21 525 931<br>e-mail: <a href="mailto:zarko.micin@novisad.rs">zarko.micin@novisad.rs</a></p><p>Žarko Mićin was born in 1982 in Novi Sad. He graduated from the Faculty of Law in Novi Sad and passed the bar exam. He successfully completed the Higher Studies in Security and Defense (Class 13) of the National Defense School.</p><p>He began his professional career as a law intern at the Bajić Law Firm, and later as the head of the legal department and director of a private company. Later, he was the Chairman of the Supervisory Board of the Hotel “Prague” in Belgrade, as well as a member of the Supervisory Board of the Institute for Forensic Expertise AD.</p><p>He has considerable experience in management positions in the public sector as the Executive Director of the Novi Sad PE “City Construction Institute”, General Director of the Novi Sad PE “Sports and Business Center of Vojvodina”, Executive Director of the Novi Sad PE “Urbanizam” – Institute for Urban Planning. He served as the Head of the Novi Sad Mayor’s Office and was the Construction Coordinator and Chairman of the Commission for the Selection of Users of 522 Apartments for Refugees. He was elected three times Member of the National Assembly of the Republic of Serbia, during which he was on the Parliamentary Committee for European Integration, Committee for Justice, State Administration and Local Self-Government, as well as in the parliamentary delegation to the Parliamentary Assembly of the Council of Europe.</p><p>From 2018, until taking office in 2021, he worked as a lawyer in his own Mićin Law Firm. He is the President of the Board of Directors of PE “Jugoimport SDPR”. He served as the Head of the Deputy Prime Minister’s and Minister of Defense’s Office, as well as the Head of the Prime Minister’s Office.</p><p>He was elected Mayor of the City of Novi Sad on February 24th 2025.</p><p>He completed full Military Service. He speaks English fluently.</p><p>He is married, a father of two daughters.</p>','','basic_html');
INSERT INTO `node__body` VALUES ('page','0','4','388','sr-Cyrl-RS','0','<p>ЖАРКО МИЋИН</p><p>Градоначелник Новог Сада</p><p>Aдреса: Трг слободе 1, 21000 Нови Сад, Србија<br>Бр. тeл: + 381 21 522 451 и 522 377<br>Фaкс: + 381 21 525 931<br>e-mail: <a href="mailto:zarko.micin@novisad.rs">zarko.micin@novisad.rs</a></p><p>Жарко Мићин је рођен 1982. године у Новом Саду. Дипломирао је на Правном факултету у Новом Саду и положио правосудни испит. Успешно је завршио Високе студије безбедности и одбране као полазник 13. класе Школе националне одбране.</p><p>Своју професионалну каријеру започиње као адвокатски приправник у адвокатској канцеларији Бајић, а након тога као руководилац правне службе и директор у приватној компанији. Касније обавља функцију председника Надзорног одбора Хотела „Праг” Београд и члана Надзорног одбора Завода за судска вештачења АД.</p><p>Поседује искуство на руководећим позицијама у јавном сектору као извршни директор ЈП „Завод за изградњу Града“ Нови Сад, генерални директор ЈП „Спортски и пословни центар Војводина“ Нови Сад, извршни директор ЈП „Урбанизам“ – Завод за урбанизам Нови Сад. Обављао је функцију шефа Kабинета градоначелника Новог Сада и био координатор изградње и председник Kомисије за избор корисника 522 стана за избегла лица. Три пута је биран за народног посланика Народне скупштине Републике Србије. Био је члан Скупштинског одбора за европске интеграције, Одбора за правосуђе, државну управу и локалну самоуправу као и члан скупштинске делегације у Парламентарној скупштини Савета Европе.</p><p>Од 2018. до ступања на функцију 2021. године радио је као адвокат у сопственој адвокатској канцеларији Мићин. Председник је Управног одбора Југоимпорт СДПР Ј.П. Обављао је функцију шефа Kабинета потпредседника Владе и министра одбране, као и шефа Кабинета председника Владе.</p><p>За Градоначелника Новог Сада изабран је 24. фебруара 2025. године.</p><p>Редовно је одслужио војни рок. Течно говори енглески језик.</p><p>Ожењен је и отац две ћерке.</p>','','basic_html');
INSERT INTO `node__body` VALUES ('page','0','4','388','sr-Latn-RS','0','<p>ŽARKO MIĆIN</p><p>Gradonačelnik Novog Sada</p><p>Adresa: Trg slobode 1, 21000 Novi Sad, Srbija<br>Br. tel: + 381 21 522 451 i 522 377<br>Faks: + 381 21 525 931<br>e-mail: <a href="mailto:zarko.micin@novisad.rs">zarko.micin@novisad.rs</a></p><p>Žarko Mićin je rođen 1982. godine u Novom Sadu. Diplomirao je na Pravnom fakultetu u Novom Sadu i položio pravosudni ispit. Uspešno je završio Visoke studije bezbednosti i odbrane kao polaznik 13. klase Škole nacionalne odbrane.</p><p>Svoju profesionalnu karijeru započinje kao advokatski pripravnik u advokatskoj kancelariji Bajić, a nakon toga kao rukovodilac pravne službe i direktor u privatnoj kompaniji. Kasnije obavlja funkciju predsednika Nadzornog odbora Hotela „Prag” Beograd i člana Nadzornog odbora Zavoda za sudska veštačenja AD.</p><p>Poseduje iskustvo na rukovodećim pozicijama u javnom sektoru kao izvršni direktor JP „Zavod za izgradnju Grada“ Novi Sad, generalni direktor JP „Sportski i poslovni centar Vojvodina“ Novi Sad, izvršni direktor JP „Urbanizam“ &amp;ndaš; Zavod za urbanizam Novi Sad. Obavljao je funkciju šefa Kabineta gradonačelnika Novog Sada i bio koordinator izgradnje i predsednik Komisije za izbor korisnika 522 stana za izbegla lica. Tri puta je biran za narodnog poslanika Narodne skupštine Republike Srbije. Bio je član Skupštinskog odbora za evropske integracije, Odbora za pravosuđe, državnu upravu i lokalnu samoupravu kao i član skupštinske delegacije u Parlamentarnoj skupštini Saveta Evrope.</p><p>Od 2018. do stupanja na funkciju 2021. godine radio je kao advokat u sopstvenoj advokatskoj kancelariji Mićin. Predsednik je Upravnog odbora Jugoimport SDPR J.P. Obavljao je funkciju šefa Kabineta potpredsednika Vlade i ministra odbrane, kao i šefa Kabineta predsednika Vlade.</p><p>Za Gradonačelnika Novog Sada izabran je 24. februara 2025. godine.</p><p>Redovno je odslužio vojni rok. Tečno govori engleski jezik.</p><p>Oženjen je i otac dve ćerke.</p>','','basic_html');
