INSERT INTO `locales_source` VALUES ('151','Cancel the selected user account(s)','','10.4.7'),('152','Unblock the selected user(s)','','10.4.7'),('153','Account cancellation request for [user:display-name] at [site:name]','','10.4.7'),('154','[user:display-name]\n\nA request to cancel your account has been made at [site:name].\n\nYou may now cancel your account on [site:url-brief] by clicking this link or copying and pasting it into your browser:\n\n[user:cancel-url]\n\nNOTE: The cancellation of your account is not reversible.\n\nThis link expires in one day and nothing will happen if it is not used.\n\n--  [site:name] team','','10.4.7'),('155','Replacement login information for [user:display-name] at [site:name]','','10.4.7'),('156','[user:display-name],\n\nA request to reset the password for your account has been made at [site:name].\n\nYou may now log in by clicking this link or copying and pasting it into your browser:\n\n[user:one-time-login-url]\n\nThis link can only be used once to log in and will lead you to a page where you can set your password. It expires after one day and nothing will happen if it''s not used.\n\n--  [site:name] team','','10.4.7'),('157','An administrator created an account for you at [site:name]','','10.4.7'),('158','[user:display-name],\n\nA site administrator at [site:name] has created an account for you. You may now log in by clicking this link or copying and pasting it into your browser:\n\n[user:one-time-login-url]\n\nThis link can only be used once to log in and will lead you to a page where you can set your password.\n\nAfter setting your password, you will be able to log in at [site:login-url] in the future using:\n\nusername: [user:name]\npassword: Your password\n\n--  [site:name] team','','10.4.7'),('159','Account details for [user:display-name] at [site:name]','','10.4.7'),('160','[user:display-name],\n\nThank you for registering at [site:name]. You may now log in by clicking this link or copying and pasting it into your browser:\n\n[user:one-time-login-url]\n\nThis link can only be used once to log in and will lead you to a page where you can set your password.\n\nAfter setting your password, you will be able to log in at [site:login-url] in the future using:\n\nusername: [user:name]\npassword: Your password\n\n--  [site:name] team','','10.4.7');
INSERT INTO `locales_source` VALUES ('161','Account details for [user:display-name] at [site:name] (pending admin approval)','','10.4.7'),('162','[user:display-name],\n\nThank you for registering at [site:name]. Your application for an account is currently pending approval. Once it has been approved, you will receive another email containing information about how to log in, set your password, and other details.\n\n--  [site:name] team','','10.4.7'),('163','[user:display-name] has applied for an account.\n\n[user:edit-url]','','10.4.7'),('164','Account details for [user:display-name] at [site:name] (approved)','','10.4.7'),('165','[user:display-name],\n\nYour account at [site:name] has been activated.\n\nYou may now log in by clicking this link or copying and pasting it into your browser:\n\n[user:one-time-login-url]\n\nThis link can only be used once to log in and will lead you to a page where you can set your password.\n\nAfter setting your password, you will be able to log in at [site:login-url] in the future using:\n\nusername: [user:account-name]\npassword: Your password\n\n--  [site:name] team','','10.4.7'),('166','Account details for [user:display-name] at [site:name] (blocked)','','10.4.7'),('167','[user:display-name],\n\nYour account on [site:name] has been blocked.\n\n--  [site:name] team','','10.4.7'),('168','Account details for [user:display-name] at [site:name] (canceled)','','10.4.7'),('169','[user:display-name],\n\nYour account on [site:name] has been canceled.\n\n--  [site:name] team','','10.4.7'),('170','Olivero Medium','','10.4.7'),('171','j  F,  Y','PHP date format','10.4.7'),('172','Content blocks','','10.4.8'),('173','Find and manage content blocks.','','10.4.7'),('174','Block description','','10.4.8'),('175',', ','','10.4.7'),('176','Block type','','10.4.8'),('177','Updated','','10.4.7'),('178','Operations','','10.4.8'),('179','Next ›','','10.4.7'),('180','‹ Previous','','10.4.7'),('181','Items per page','','10.4.8'),('182','- All -','','10.4.7'