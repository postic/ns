INSERT INTO `locales_target` VALUES ('1274','Корисничко име или е-мејл адреса','sr-Cyrl-RS','0'),('1275','Префериран језик овог налога за маилове.','sr-Cyrl-RS','0'),('1276','Инструкције за активацију налога су послате на вашу е-мејл адресу.','sr-Cyrl-RS','0'),('1277','Инструкције за поновно намештање лозинке ће Вам бити послате на %email. Морате се одјавити да би сте користили линк за поновно намештање лозинке из имејла.','sr-Cyrl-RS','0'),('1278','Максимална дубина за линк и све његове подређене линкове је фиксирана. Одређени линкови менија могу бити недоступни као надређени ако би њихов избор прекорачио лимит.','sr-Cyrl-RS','0'),('1279','Машинско име врсте формата','sr-Cyrl-RS','0'),('1280','Подешавања логичке променљиве','sr-Cyrl-RS','0'),('1281','Прикажи ознаку','sr-Cyrl-RS','0'),('1282','Сакриј ознаку','sr-Cyrl-RS','0'),('1283','Редефинисати скуп основних поља','sr-Cyrl-RS','0'),('1284','Подешавање формата приказа ознаке за датум/време','sr-Cyrl-RS','0'),('1285','Подешавање формата приказа поља за потврду у формату тачно/нетачно','sr-Cyrl-RS','0'),('1286','Инсталиране теме','sr-Cyrl-RS','0'),('1287','%file не постоји.','sr-Cyrl-RS','0'),('1288','%file постоји.','sr-Cyrl-RS','0'),('1289','%file није читљив.','sr-Cyrl-RS','0'),('1290','Подразумевана повратна вредност','sr-Cyrl-RS','0'),('1291','Подешавање формата приказа <em>URI</em> као линка','sr-Cyrl-RS','0'),('1292','Подешавање формата приказа временске ознаке у прошлости','sr-Cyrl-RS','0');
INSERT INTO `locales_target` VALUES ('1293','Зависности конфигурационих ентитета','sr-Cyrl-RS','0'),('1294','Зависности ентитета садржаја','sr-Cyrl-RS','0'),('1295','Зависности наметнутих конфигурација','sr-Cyrl-RS','0'),('1296','Подешавања (дугог) текста','sr-Cyrl-RS','0'),('1297','<em>URI</em> подешавања','sr-Cyrl-RS','0'),('1298','Капацитет складиштења базе података','sr-Cyrl-RS','0'),('1299','Текст и формат текста','sr-Cyrl-RS','0'),('1300','Виџети поља','sr-Cyrl-RS','0'),('1301','Виџет поља','sr-Cyrl-RS','0'),('1302','Машинско име врсте виџета','sr-Cyrl-RS','0'),('1303','Подешавање формата приказа поља за унос текста','sr-Cyrl-RS','0'),('1304','Линк ка ентитету','sr-Cyrl-RS','0'),('1305','Подешавање формата приказа целих бројева','sr-Cyrl-RS','0'),('1306','Слике морају бити веће од <strong>@min</strong> пиксела. Слике веће од <strong>@max</strong> пиксела ће бити смањене.','sr-Cyrl-RS','0'),('1307','Слике морају бити веће од <strong>@min</strong> пиксела.','sr-Cyrl-RS','0'),('1308','Ажурирање подешавања','sr-Cyrl-RS','0'),('1309','Наведа подешавања ће бити ажурирана.','sr-Cyrl-RS','0'),('1310','Подешавање чувања поља референце на ентитет','sr-Cyrl-RS','0'),('1311','Подешавање поља референце на ентитет','sr-Cyrl-RS','0'),('1312','Подешавање избора додатка за референцу на ентитет','sr-Cyrl-RS','0'),('1313','Приказ на матерњем језику','sr-Cyrl-RS','0'),('1314','<em>HTTP</em> заглавље','sr-Cyrl-RS','0'),('1315','Послато од @username у @datetime','sr-Cyrl-RS','0'),('1316','Ово мора бити спољашњи УРЛ као што је %url.','sr-Cyrl-RS','0');
INSERT INTO `locales_target` VALUES ('1317','Поднео @author_name на дан @date','sr-Cyrl-RS','0'),('1318','Дозволе за налог','sr-Cyrl-RS','0'),('1319','Хеширана лозинка','sr-Cyrl-RS','0'),('1320','Постојећа лозинка','sr-Cyrl-RS','0'),('1321','Садржи само <em>US ASCII</em> знакове','sr-Cyrl-RS','0'),('1322','Плаћање завршено! Хвала на куповини.','sr-Cyrl-RS','0'),('1323','Обриши @language превод.','sr-Cyrl-RS','0'),('1324','Обезбеђује линк за додавање новог блока.','sr-Cyrl-RS','0'),('1325','Подешавање формата приказа временске ознаке','sr-Cyrl-RS','0'),('1326','Будући формат','sr-Cyrl-RS','0'),('1327','Прошли формат','sr-Cyrl-RS','0'),('1328','Варијанта у множини','sr-Cyrl-RS','0'),('1329','Превод за %language се не може преузети. <a href=":url">Изаберите други језик</a> или изаберите Енглески и превидите ваш сајт касније.','sr-Cyrl-RS','0'),('1330','Проверите поруке и <a href=":retry">покушајте поново</a>, или можете да <a href=":cont">наставите у сваком случају</a>.','sr-Cyrl-RS','0'),('1331','Следећи модули су обавезни али нису пронађени. Поставите их у одговарајући директоријум, као што је <em>/modules</em>. Недостајући модули: @modules','sr-Cyrl-RS','0'),('1332','Ажурирање @module','sr-Cyrl-RS','0'),('1333','УПОЗОРЕЊЕ: Не користите сигурну везу па ће лозинка бити послата као обичан текст.  <a href=":https-link">Сазнај више</a>.','sr-Cyrl-RS','0'),('1334','Порука коју треба послати. Можете користити резервисана места као што су [node:title], [user:account-name], [user:display-name] и [comment:body] како би представили податке који ће бити другачији сваки пут кад се порука пошаље. Нису сва реезервисана места доступна у свим контекстима.','sr-Cyrl-RS','0');
INSERT INTO `locales_target` VALUES ('1335','Порука која ће се приказати тренутном кориснику. Можете користити резервисанa места као на пример [node:title], [user:account-name], [user:display-name] и [comment:body] да прикажете податке који ће се разликовати сваки пут кад се порука пошаље. Нису сва резервисана места доступна у свим контекстима.','sr-Cyrl-RS','0'),('1336','<a href=":login">Пријавите се</a> или се <a href=":register">региструјте</a> да би сте послали коментар','sr-Cyrl-RS','0'),('1337','<a href=":login">Пријавите се</a> да би сте послали коментар','sr-Cyrl-RS','0'),('1338','@message (@percent%).','sr-Cyrl-RS','0'),('1339','Било би добро да је дугачка барем 12 карактера','sr-Cyrl-RS','0'),('1340','Инструкције за креирање нове лозинке ће бити послате на е-мејл адресу са којом сте се регистровали.','sr-Cyrl-RS','0'),('1341','Само су неки од специјалних каракте дозвољени да буду део корисничког имена: размак, тачка (.), цртица (-), апостроф (''), доња црта (_) i @ znak.','sr-Cyrl-RS','0'),('1342','<q>Пријави се</q> за анонимне кориснике','sr-Cyrl-RS','0'),('1343','Обриши %label','sr-Cyrl-RS','0'),('1344','Максимално 1300x1300','sr-Cyrl-RS','0'),('1345','Максимално 2600x2600','sr-Cyrl-RS','0'),('1346','Максимално 325x325','sr-Cyrl-RS','0'),('1347','Максимално 650x650','sr-Cyrl-RS','0'),('1348','Уско','sr-Cyrl-RS','0'),('1349','Добро дошли на [site:name]','sr-Cyrl-RS','0'),('1350','Погледајте или уредите подешавања.','sr-Cyrl-RS','0'),('1351','Додај, пресложи или уклони филтере.','sr-Cyrl-RS','0');
INSERT INTO `locales_target` VALUES ('1352','Акције сортирања','sr-Cyrl-RS','0'),('1353','Додај, пресложи или уклони правила сортирања.','sr-Cyrl-RS','0'),('1354','Подразумевани конфигурациони хеш','sr-Cyrl-RS','0'),('1355','Величина поља за унос адресе електронске поште','sr-Cyrl-RS','0'),('1356','Тип додељен аутоматски креираним ентитетима','sr-Cyrl-RS','0'),('1357','Одређује да ли лозинка треба да се хешира','sr-Cyrl-RS','0'),('1358','%type: @message у %function (ред %line у %file) @backtrace_string.','sr-Cyrl-RS','0'),('1359','Савети за сигурну лозинку:','sr-Cyrl-RS','0'),('1360','Систем није препознао корисничко име или лозинку. <a href=":password">Затражите нову лозинку уколико мислите да сте је заборавили?</a>','sr-Cyrl-RS','0'),('1361','Можете такође користити токен: [node:author:mail], [comment:author:mail], итд. Одвојите примаоце зарезом.','sr-Cyrl-RS','0'),('1362','Подешавање управљача селекције референцираних ентитета','sr-Cyrl-RS','0'),('1363','Подешавања подразумеваног управљача селекције','sr-Cyrl-RS','0'),('1364','Акције ентитета','sr-Cyrl-RS','0'),('1365','Предлог','sr-Cyrl-RS','0'),('1366','Поврати у Предлог','sr-Cyrl-RS','0'),('1367','Направи нови Предлог','sr-Cyrl-RS','0'),('140','Glavna navigacija','sr-Latn-RS','1'),('141','Glavna navigacija','sr-Latn-RS','1');
DROP TABLE IF EXISTS `menu_link_content`;
CREATE TABLE `menu_link_content` (   `id` int(10) unsigned NOT NULL AUTO_INCREMENT,   `revision_id` int(10) unsigned DEFAULT NULL,   `bundle` varchar(32) CHARACTER SET ascii COLLATE ascii_general_ci NOT NULL,   `uuid` varchar(128) CHARACTER SET ascii COLLATE ascii_general_ci NOT NULL,   `langcode` varchar(12) CHARACTER SET ascii COLLATE ascii_general_ci NOT NULL,   PRIMARY KEY (`id`),   UNIQUE KEY `menu_link_content_field__uuid__value` (`uuid`),   UNIQUE KEY `menu_link_content__revision_id` (`revision_id`) ) ENGINE=InnoDB AUTO_INCREMENT=176 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci COMMENT='The base table for menu_link_content entities.' AUTO_INCREMENT=176;
