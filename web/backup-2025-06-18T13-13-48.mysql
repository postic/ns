INSERT INTO `search_dataset` VALUES ('103','sr-Latn-RS','node_search',' javno komunalno preduzece regionalni centar za upravljanje otpadom novi sad javno komunalno preduzece regionalni centar za upravljanje otpadom novi sad admin tue 5272025 2332 u cilju zastite i ocuvanja zastite zivotne sredine proizasla je potreba za formiranjem regionalnog centra za upravljanje otpadom putem udruzivanja jedinica lokalnih samouprava koje su nosioci ovog projekta a razlog formiranja je neadekvatno odlaganje otpada i sve veci broj divljih deponija i neodgovarajuci tretman otpada sporazum o saradnji grada novog sada i opstina backa palanka backi petrovac beocin zabalj srbobran temerin i vrbas u formiranju regiona za upravljanje komunalnim otpadom potisan je 27 maja 2010 godine sa aneksom sporazuma o saradnji grada novog sada opstina backa palanka backi petrovac beocin zabalj srbobran temerin i vrbas od 15 decembra 2010 godine na osnovu tog sporazuma 18 aprila 2024 godine zakljucen je ugovor o osnivanju javnog komunalnog preduzeca regionalni centar za upravljanje otpadom novi sad broj 35212023503aii a preduzece je zvanicno registrovano kod agencije za privredne registre 4 jula 2024 godine jkp regionalni centar za upravljanje otpadom novi sad ima za zadatak stvaranja okvira za implementaciju regionalnog sistema za upravljanje otpadom prema zahtevima nacionalne politike i zakonodavstva i direktiva evropske unije kao i unapredenja i podizanja svesti o zastiti zivotne sredine medu gradanima preduzece je osnovano sa vizijom dostizanja najvisih standarda u oblasti upravljanja otpadom u republici srbiji jedan od osnovnih ciljeva rada centra je izgradnja savremenog sistema za tretman i odlaganje otpada postepena sanacija i zatvaranje postojecih deponija u regionu kao i sprecavanje zagadenja zemljista vazduha i podzemnih voda osnovna delatnost jkp regionalni centar za upravljanje otpadom novi sad je prikupljanje tretman i odlaganje otpada koji nije opasan kontakt informacije adresa temerinski