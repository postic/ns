INSERT INTO `block_content__body` VALUES ('basic','0','1','1','en','0','<a href="https://imaspravo.rs/"><img src="/sites/default/files/inline-images/image0011.png" data-entity-uuid="3d57d9df-230b-454b-88b2-47ab53e75060" data-entity-type="file" width="216" height="432"></a>','','basic_html'),('basic','0','2','2','en','0','<img data-entity-uuid="7c4a3f1d-b736-44b5-91cf-b2ce5809b7b9" data-entity-type="file" src="/sites/default/files/inline-images/gradonacelnik_cyr.jpg" width="216" height="194">','','basic_html'),('basic','0','3','3','en','0','<p><strong>Телефон:</strong><br>+381 21 420-066</p><p><strong>Адреса:</strong><br>Трг слободе 1<br>21101 Нови Сад<br>Република Србија</p><img data-entity-uuid="75d3d620-1865-41b3-913f-5848db05ae67" data-entity-type="file" src="/sites/default/files/inline-images/gmap.png" width="165" height="350">','','basic_html'),('basic','0','5','5','sr-Cyrl-RS','0','<p><strong>Нови Сад један је од најразвијенијих градова у југоисточној Европи, богат културом, традицијом и урбаним садржајима, препознат као веома погодно и подстицајно место за живот, рад и инвестирање.</strong><br><strong>Град приступачних и солидарних људи који уважавају различитости и тако чине да се у Новом Саду сви осећају добродошлим.</strong></p><p><strong>Елементи визије као приоритети развоја:</strong></p><ul><li>Ефикасан административни центар Војводине са електронском локалном управом;</li><li>Урбанистички и комунално уређен, саобраћајно добро повезан;</li><li>Паметан град, који подстиче и подржава развој привреде и друштва, поштујући принципе одрживог развоја, заштите животне средине и бриге о људима;</li><li>Модеран образовни, универзитетски и научно-истраживачки центар региона и извор економије и знања;</li><li>Лидер у сектору информационих технологија, развоја здраве хране и еко-сектора, дистрибуције и логистике;</li><li>Културно, туристичко, сајамско и здравствено средиште региона.</li></ul>','','basic_html');
INSERT INTO `block_content__body` VALUES ('basic','0','5','5','sr-Latn-RS','0','<p><strong>Novi Sad jedan je od najrazvijenijih gradova u jugoistočnoj Evropi, bogat kulturom, tradicijom i urbanim sadržajima, prepoznat kao veoma pogodno i podsticajno mesto za život, rad i investiranje.</strong><br><strong>Grad pristupačnih i solidarnih ljudi koji uvažavaju različitosti i tako čine da se u Novom Sadu svi osećaju dobrodošlim.</strong></p><p><strong>Elementi vizije kao prioriteti razvoja:</strong></p><ul><li>Efikasan administrativni centar Vojvodine sa elektronskom lokalnom upravom;</li><li>Urbanistički i komunalno uređen, saobraćajno dobro povezan;</li><li>Pametan grad, koji podstiče i podržava razvoj privrede i društva, poštujući principe održivog razvoja, zaštite životne sredine i brige o ljudima;</li><li>Moderan obrazovni, univerzitetski i naučno-istraživački centar regiona i izvor ekonomije i znanja;</li><li>Lider u sektoru informacionih tehnologija, razvoja zdrave hrane i eko-sektora, distribucije i logistike;</li><li>Kulturno, turističko, sajamsko i zdravstveno središte regiona.</li></ul>','','basic_html'),('basic','0','6','6','en','0','<p><a href="https://www.youtube.com/@nszasve1930/videos">СЕРВИСНЕ ИНФОРМАЦИЈЕ НА ЗНАКОВНОМ ЈЕЗИКУ</a></p>','','basic_html'),('basic','0','7','7','en','0','<p><a href="ж">ПЛАН РАЗВОЈА ГРАДА НОВОГ САДА ЗА ПЕРИОД 2023-2030. ГОДИНЕ</a></p>','','basic_html'),('basic','0','8','8','en','0','<img data-entity-uuid="66188cdb-a7d6-4c50-90d2-4edfee2082a9" data-entity-type="file" src="/sites/default/files/inline-images/logo-footer-cirilica_0.png" width="115" height="41"><p><strong>Телефон:</strong><br>+381 21 480-7777</p><p><strong>Адреса:</strong><br>Трг слободе 1<br>21101 Нови Сад<br>Република Србија</p>','','basic_html'),('basic','0','9','9','en','0','<img data-entity-uuid="ef1ce418-da1c-4bf9-bc06-566408536801" data-entity-type="file" src="/sites/default/files/inline-images/img.jpeg" width="216" height="280">','','basic_html');
INSERT INTO `block_content__body` VALUES ('basic','0','10','10','en','0','<img data-entity-uuid="ebe06334-e0ff-4ee4-b962-756696cf56fa" data-entity-type="file" src="/sites/default/files/inline-images/pitajte_cyr.jpg" width="216" height="194">','','basic_html'),('basic','0','11','11','en','0','<p><a href="http://www.novisad.rs/node/205475">ЕЛЕКТРОНСКО ПЛАЋАЊЕ ТАКСИ У ПРИЈЕМНИМ КАНЦЕЛАРИЈАМА ГРАДСКИХ УПРАВА И ПИСАРНИЦИ ГРАДСКЕ КУЋЕ</a></p>','','basic_html'),('basic','0','12','12','sr-Cyrl-RS','0','<img src="/sites/default/files/inline-images/nsi-baner_new_sh2.png" data-entity-uuid="8ac06ff2-06d1-4cdb-92f3-182bd3790649" data-entity-type="file" width="216" height="113">','','basic_html'),('basic','0','13','13','en','0','<img data-entity-uuid="5a4cf5f5-2826-4f02-a7c3-54ec4a14ef4a" data-entity-type="file" src="/sites/default/files/inline-images/gradanski-vodic-kroz-budzet-grada-novog-sada-za-2020.png" width="216" height="278">','','basic_html'),('basic','0','14','14','en','0','<img data-entity-uuid="1cc02d95-deb4-4704-9490-95d3c5828e93" data-entity-type="file" src="/sites/default/files/inline-images/baner-216-dzh-150-1.jpg" width="216" height="150">','','basic_html'),('basic','0','15','15','en','0','<a href="https://tvojgradnovisad.rs/sr-SP/"><img src="/sites/default/files/inline-images/baner-216-dzh-150-1_0.jpg" data-entity-uuid="c8ef490b-14ef-4cf2-918b-9dd60c17fc8f" data-entity-type="file" width="216" height="150"></a>','','basic_html'),('basic','0','16','16','en','0','<p><a href="/biracki-spisak-obavestenja">БИРАЧКИ СПИСАК - ОБАВЕШТЕЊА</a></p>','','basic_html'),('basic','0','17','17','sr-Cyrl-RS','0','<p><a href="#">БРОЈ РАЧУНА ЗА ПОМОЋ ПОРОДИЦАМА НАСТРАДАЛИХ И ПОВРЕЂЕНИХ У НЕСРЕЋИ НА ЖЕЛЕЗНИЧКОЈ СТАНИЦИ</a></p>','','basic_html'),('basic','0','18','18','sr-Cyrl-RS','0','<p><a href="/node/45">БРОЈ РАЧУНА ЗА ПОМОЋ ПОРОДИЦАМА НАСТРАДАЛИХ И ПОВРЕЂЕНИХ У НЕСРЕЋИ НА ЖЕЛЕЗНИЧКОЈ СТАНИЦИ</a></p>','','basic_html');
INSERT INTO `block_content__body` VALUES ('basic','0','18','18','sr-Latn-RS','0','<p><a href="#">BROJ RAČUNA ZA POMOĆ PORODICAMA NASTRADALIH I POVREĐENIH U NESREĆI NA ŽELEZNIČKOJ STANICI</a></p>','','basic_html'),('basic','0','19','19','en','0','<img data-entity-uuid="4728f5fc-25e8-4e3c-9df2-6d63942cf619" data-entity-type="file" src="/sites/default/files/inline-images/gradonacelnik_cyr_0.jpg" width="216" height="194">','','basic_html'),('basic','0','20','20','en','0','<p><a href="#">Бирачки списак - обавештења</a></p>','','basic_html'),('basic','0','22','22','sr-Cyrl-RS','0','<a href="https://forms.office.com/pages/responsepage.aspx?id=_spRjTh_x0eOhM2BS3OsmXfXhZlon9tCjF8BPPFVOWZUOTZNVU9OMlhQTlRZUVFQSjJLVVcwSTRWTy4u&amp;route=shorturl"><img src="/sites/default/files/inline-images/%D0%91aja%20%D0%9B%D0%9E%D0%9A%D0%90%D0%9B.jpg" data-entity-uuid="286ad096-473c-4a0f-b04f-64fbd23e6b82" data-entity-type="file" width="1217" height="839"></a>','','basic_html');
