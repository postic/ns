DROP TABLE IF EXISTS `node_revision__field_kategorija`;
CREATE TABLE `node_revision__field_kategorija` (   `bundle` varchar(128) CHARACTER SET ascii COLLATE ascii_general_ci NOT NULL DEFAULT '' COMMENT 'The field instance bundle to which this row belongs, used when deleting a field instance',   `deleted` tinyint(4) NOT NULL DEFAULT 0 COMMENT 'A boolean indicating whether this data item has been deleted',   `entity_id` int(10) unsigned NOT NULL COMMENT 'The entity id this data is attached to',   `revision_id` int(10) unsigned NOT NULL COMMENT 'The entity revision id this data is attached to',   `langcode` varchar(32) CHARACTER SET ascii COLLATE ascii_general_ci NOT NULL DEFAULT '' COMMENT 'The language code for this data item.',   `delta` int(10) unsigned NOT NULL COMMENT 'The sequence number for this data item, used for multi-value fields',   `field_kategorija_target_id` int(10) unsigned NOT NULL COMMENT 'The ID of the target entity.',   PRIMARY KEY (`entity_id`,`revision_id`,`deleted`,`delta`,`langcode`),   KEY `bundle` (`bundle`),   KEY `revision_id` (`revision_id`),   KEY `field_kategorija_target_id` (`field_kategorija_target_id`) ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci COMMENT='Revision archive storage for node field field_kategorija.';
