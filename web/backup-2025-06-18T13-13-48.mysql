INSERT INTO `locales_source` VALUES ('1886','View name','','10.4.7'),('1887','A unique machine-readable name for this View. It must only contain lowercase letters, numbers, and underscores.','','10.4.7'),('1888','Provide description','','10.4.7'),('1889','View basic information','','10.4.7'),('1890','Content Block','','10.4.7'),('1891','Log entries','','10.4.7'),('1892','Content revisions','','10.4.7'),('1893','@entity_type revisions','','10.4.7'),('1894','Update "@title" choice','','10.4.7'),('1895','Unsorted','','10.4.7'),('1896','Newest first','','10.4.7'),('1897','Oldest first','','10.4.7'),('1898','sorted by','','10.4.7'),('1899','View settings','','10.4.7'),('1900','Create a page','','10.4.7'),('1901','Grid','','10.4.8'),('1902','HTML List','','10.4.8'),('1903','Responsive Grid','','10.4.8'),('1904','Slideshow','','10.4.7'),('1905','Table','','10.4.8'),('1906','teasers','','10.4.7'),('1907','full posts','','10.4.7'),('1908','titles','','10.4.7'),('1909','titles (linked)','','10.4.7'),('1910','fields','','10.4.8'),('1911','Page display settings','','10.4.7'),('1912','Items to display','','10.4.8'),('1913','Use a pager','','10.4.7'),('1914','Create a menu link','','10.4.7'),('1915','Include an RSS feed','','10.4.7');
