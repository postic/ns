INSERT INTO `node_revision__body` VALUES ('article','0','48','459','en','0','<p>DANIJELA ANDRIĆ</p><p>Address: Trg slobode 1, 21101 Novi Sad, Serbia<br>Telephone: +381 21 524 486<br>e-mail:<a href="mailto: danijela.andric@novisad.rs">&nbsp;danijela.andric@novisad.rs</a></p>','','basic_html'),('article','0','48','459','sr-Cyrl-RS','0','<p>ДАНИЈЕЛА АНДРИЋ</p><p>Трг слободе 1, 21101 Нови Сад<br>Телефон: +381 21 524 486<br>imejl: <a href="mailto:danijela.andric@novisad.rs">danijela.andric@novisad.rs</a></p><p>Рођена је 3. новембра 1975.године у Жабљаку, Црна Гора, где је завршила Природно математичку гимназију, смер сарадник у природно математичким наукама. Потом је&nbsp; завршила&nbsp; Природно математички факултет у Новом Саду, и стекла звање професор биологије, 2000.године, након чега је започела магистарске студије у области Генетике и оплемењивања биља на Пољопривредном факултету у Новом Саду.</p><p>РАДНО ИСКУСТВО</p><p>2021-2024 Помоћник директора за пројектовање, подизање, одржавање и производњу зеленила&nbsp; ЈКП ,,Градско зеленило" Нови Сад;<br>2013-2021 Руководилац производње и одржавања зеленила ЈКП,,Градско зеленило" Нови Сад;<br>2009-2013 Руководилац Одељења подизања и одржавања зеленила ЈКП,,Градско зеленило" Нови Сад;<br>2007 – 2009 Руководилац Радне јединице ,,Дендрологија и искоришћење биљног отпада" ЈКП „Градско зеленило" Нови Сад;<br>2006 -2007 Инжењер оперативац Радне јединице ,,Дендрологија и искоришћење биљног отпада" ЈКП „Градско зеленило" Нови Сад;<br>2004 -2006 Факултет техничких наука, Универзитет у Новом Саду - Центар за аутоматизацију и мехатронику, сарадник за екологију, Екологија и заштита животне средине.</p><p>Учесник је и предавач на словеначко - српским пословним скуповима у Љубљани и Марибору на тему зеленила у градским срединама и употреби биомасе за производњу компоста.&nbsp;</p><p>Поред тога, имала је активно учешће на пројектима од стане УНДП-а, као менаџер пројекта ,,Зациркулирај са компостом", као и&nbsp; менаџер пројекта ,,Употр