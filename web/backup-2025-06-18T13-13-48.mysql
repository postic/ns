INSERT INTO `locales_source` VALUES ('1400','Field to store number. I.e. id, price, or quantity.','','10.4.7'),('1401','Field to reference other content.','','10.4.7'),('1402','File upload','','10.4.7'),('1403','Field to upload any type of files.','','10.4.7'),('1404','Selection list','','10.4.7'),('1405','Field to select from predefined options.','','10.4.7'),('1406','Field to store date and time values.','','10.4.7'),('1407','Icons','','10.4.7'),('1408','One or more Font Awesome icons.','','10.4.7'),('1409','Field to store a true or false value.','','10.4.7'),('1410','This field manages configuration and presentation of comments on an entity.','','10.4.7'),('1411','Stores a URL string, optional varchar link text, and optional blob of attributes to assemble a link.','','10.4.7'),('1412','Field to store an email address.','','10.4.7'),('1413','Add field','','10.4.7'),('1414','No strings available.','','10.4.7'),('1415','The source of translation files for automatic interface translation.','','10.4.7'),('1416','Translation files are stored locally in the  %path directory. You can change this directory on the <a href=":url">File system</a> configuration page.','','10.4.7'),('1417','Never (manually)','','10.4.7'),('1418','Weekly','','10.4.7'),('1419','Monthly','','10.4.7'),('1420','Check for updates','','10.4.7'),('1421','Select how frequently you want to check for new interface translations for your currently installed modules and themes. <a href=":url">Check updates now</a>.','','10.4.7'),('1422','Drupal translation server and local files','','10.4.7'),('1423','Local files only','','10.4.7'),('1424','Translation source','','10.4.8'),('1425','Don''t overwrite existing translations.','','10.4.7'),('1426','Only overwrite imported translations, customized translations are kept.','','10.4.7'),('1427','Overwrite existing translations.','','10.4.7'),('1428','Import behavior','','10.4.7'),('1429','How to treat existing translations when automatically updating the interface translations.','','10.4.7');
INSERT INTO `locales_source` VALUES ('1430','Interface translation settings','','10.4.7'),('1431','In order to encrypt backup files, please install the Defuse PHP-encryption library via Composer with the following command: <code>composer require defuse/php-encryption</code>. See the <a href="@docs">Defuse PHP Encryption Documentation Page</a> for more information.','','10.4.7'),('1432','Upload a Backup File','','10.4.7'),('1433','Upload a backup file created by Backup and Migrate. For other database or file backups please use another tool for import. Max file size: %size','','10.4.7'),('1434','Restore To','','10.4.7'),('1435','Restore now','','10.4.7'),('1436','Backup','','10.4.8'),('1437','Schedules','','10.4.8'),('1438','Most recent backups in %dest','','10.4.7'),('1439','Wed','','10.4.8'),('1440','Sort descending','','10.4.7'),('1441','Download','','10.4.8'),('1442','View all backups in %dest','','10.4.7'),('1443','Backups','','10.4.7'),('1444','Are you sure you want to restore this backup?','','10.4.7'),('1445','Backups in @destination_name','','10.4.7'),('1446','Restore completed at @time','','10.4.7'),('1447','The website encountered an unexpected error. Try again later.','','10.4.8'),('1448','@lifecycle','','10.4.8'),('1449','View information on the @lifecycle status of the module @module','','10.4.8'),('1450','Allows configuration of tasks to be executed in response to events.','','10.4.8'),('1451','Displays recently added and updated content.','','10.4.8'),('1452','Provides an improved drop-down menu interface to the site Toolbar.','','10.4.8'),('1453','Adds menu links like Flush cache, Run cron, Run updates, and Logout under Drupal icon.','','10.4.8'),('1454','Provides a workaround for the common problem that users with ''Use the administration pages and help'' permission see menu links they don''t have access permission for. Deprecated from Drupal 10.3 and above.','','10.4.8'),('1455','Provides search of Admin Toolbar items.','','10.4.8'),('1456','Provides an automated way to run cron jobs, by executing them at the end of a server response.','','10.4.8'),('1457','Backup the Drupal database and files or migrate them to another environment.','','10.4.8');
INSERT INTO `locales_source` VALUES ('1458','Allows banning visits from specific IP addresses.','','10.4.8'),('1459','Sends pages using the BigPipe technique that allows browsers to show them much faster.','','10.4.8'),('1460','Allows users to configure blocks (containing content, forms, etc.) and to place them in the regions of a theme.','','10.4.8'),('1461','Allows the creation of content blocks and block types.','','10.4.8'),('1462','Allows users to create and organize related content in an outline.','','10.4.8'),('1463','Manages breakpoints and breakpoint groups for responsive designs.','','10.4.8'),('1464','Provides a number of utility and helper APIs for Drupal developers and site builders.','','10.4.8'),('1465','Provides improvements to blocks that will one day be added to Drupal core.','','10.4.8'),('1466','A set of improvements to the core Views code that allows for greater control over Blocks.','','10.4.8'),('1467','Provides the CKEditor 5 rich text editor.','','10.4.8'),('1468','Allows users to comment on content.','','10.4.8'),('1469','Allows importing and exporting configuration changes.','','10.4.8'),('1470','Allows users to translate configuration text.','','10.4.8'),('1471','Provides site-wide contact forms and forms to contact individual users.','','10.4.8'),('1472','Provides additional publication states that can be used by other modules to moderate content.','','10.4.8'),('1473','Allows users to translate content.','','10.4.8'),('1474','Provides contextual links to directly access tasks related to page elements.','','10.4.8'),('1475','Allows users to create menu links.','','10.4.8'),('1476','Logs system events in the database.','','10.4.8'),('1477','Defines field types for storing dates and times.','','10.4.8'),('1478','Provides the ability to store end dates.','','10.4.8'),('1479','Various blocks, pages, and functions for developers.','','10.4.8'),('1480','Generate test users, nodes, menus, taxonomy terms...','','10.4.8'),('1481','Sets the front page to an empty page','','10.4.8'),('1482','Allows an entity type to borrow the fields and display configuration of another entity type.','','10.4.8');
INSERT INTO `locales_source` VALUES ('1483','Provides the capabilities to add fields to entities.','','10.4.8'),('1484','Allows users to configure the display and form display by arranging fields in several columns.','','10.4.8'),('1485','Provides a user interface for the Field module.','','10.4.8'),('1486','Provides a field type for files and defines a "managed_file" Form API element.','','10.4.8'),('1487','Filters text content in preparation for display.','','10.4.8'),('1488','Integrate the FlexSlider 2 library with Drupal','','10.4.7'),('1489','Provide FlexSlider Example content type and related configuration. Used for generating example FlexSlider implementations','','10.4.7'),('1490','Adds a display mode in Fields for FlexSlider','','10.4.7'),('1491','Adds a Views style plugin for FlexSlider','','10.4.7'),('1492','The most popular icon set and toolkit on the web.','','10.4.8'),('1493','Provides an iconpicker widget for Font Awesome','','10.4.8'),('1494','Adds a Font Awesome Media Entity Type.','','10.4.8'),('1495','Provides discussion forums.','','10.4.8'),('1496','Generates help pages and provides a Help block with page-level help.','','10.4.8'),('1497','Displays help topics provided by themes and modules.','','10.4.8'),('1498','Records which content users have viewed and marks it as new or updated.','','10.4.8'),('1499','Provides an HTTP Basic authentication provider.','','10.4.8'),('1500','Defines a field type for image media and provides display configuration tools.','','10.4.8'),('1501','Places error messages adjacent to form inputs, for improved usability and accessibility.','','10.4.8'),('1502','Allows users to translate interface text and to switch between interface languages.','','10.4.8'),('1503','Caches pages, including those with dynamic content, for all users.','','10.4.8'),('1504','Caches pages for anonymous users and can be used when external page cache is not available.','','10.4.8'),('1505','Provides the js-cookie library as a dependency.','','10.4.8'),('1506','Provides jQuery UI library.','','10.4.8'),('1507','Provides jQuery UI Accordion library.','','10.4.8');
INSERT INTO `locales_source` VALUES ('1508','Provides jQuery UI Tabs library.','','10.4.8'),('1509','Exposes entities as a JSON:API-specification-compliant web API.','','10.4.8'),('1510','Allows users to configure available languages.','','10.4.8'),('1511','Allows users to add and arrange blocks and content fields directly on the content.','','10.4.8'),('1512','When enabled, this module exposes all fields for all entity view displays. When disabled, only entity type bundles that have layout builder enabled will have their fields exposed. Enabling this module could significantly decrease performance on sites with a large number of entity types and bundles.','','10.4.8'),('1513','Provides a way for modules or themes to register layouts.','','10.4.8'),('1514','Allows version-dependent and shared usage of external libraries.','','10.4.8'),('1515','Provides a field type for internal and external URLs.','','10.4.8'),('1516','Manages the creation, configuration, and display of media items.','','10.4.8'),('1517','Enhances the media list with additional features to more easily find and use existing media items.','','10.4.8'),('1518','Provides configurable blocks of menu links.','','10.4.8'),('1519','Improve Drupal 8 menu management and rendering.','','10.4.8'),('1520','Provides a user interface for managing menus.','','10.4.8'),('1521','Provides a framework for migrating data to Drupal.','','10.4.8'),('1522','Provides a framework to migrate data from previous versions of Drupal into the site.','','10.4.8'),('1523','Provides a user interface for migrating from older Drupal versions.','','10.4.8'),('1524','Provides the MySQL database driver.','','10.4.8'),('1525','New administration navigation','','10.4.8'),('1526','Manages the creation, configuration, and display of the main site content.','','10.4.8'),('1527','Defines field types with select lists, checkboxes, and radio buttons to select values from fixed lists of options.','','10.4.8'),('1528','Provides the password checking algorithm for user accounts created with Drupal prior to version 10.1.0.','','10.4.8'),('1529','Allows users to create custom URLs for existing paths on the site.','','10.4.8');
INSERT INTO `locales_source` VALUES ('1530','Provides a mechanism for modules to automatically generate aliases for the content they manage.','','10.4.8'),('1531','Provides the PostgreSQL database driver.','','10.4.8'),('1532','Render content with tabs and other display styles','','10.4.8'),('1533','Render content with a jQuery UI accordion style','','10.4.8'),('1534','Render content with a jQuery UI tab style','','10.4.8'),('1535','Provides functionality to output responsive images using the HTML5 picture tag.','','10.4.8'),('1536','Provides a framework for exposing REST resources.','','10.4.8'),('1537','Allows users to create search pages based on plugins provided by other modules.','','10.4.8'),('1538','Provides a service for converting data to and from formats such as JSON and XML.','','10.4.8'),('1539','Allows users to directly edit the configuration of blocks on the current page.','','10.4.8'),('1540','Allows users to create sets of shortcuts within the site.','','10.4.8'),('1541','Allows discovery and rendering of self-contained UI components.','','10.4.8'),('1542','Provides a more robust alternative to "summary or trimmed" textfield format','','10.4.8'),('1543','Provides the SQLite database driver.','','10.4.8'),('1544','Logs how many times content is viewed.','','10.4.8'),('1545','Logs events to the web server''s system log.','','10.4.8'),('1546','Provides user interfaces for core systems.','','10.4.8'),('1547','Enables the categorization of content.','','10.4.8'),('1548','Defines a field type for telephone numbers.','','10.4.8'),('1549','Defines field types for short and long text with optional summaries.','','10.4.8'),('1550','Provides a framework to associate text editors (like WYSIWYGs) and toolbars with text formats.','','10.4.8'),('1551','Provides a user interface for the Token API and some missing core tokens.','','10.4.8'),('1552','Provides an administration toolbar to display links provided by modules.','','10.4.8'),('1553','Displays guided tours of the site interface.','','10.4.8'),('1554','Provides some extra Twig functions and filters.','','10.4.8'),('1555','Checks for updates and allows users to manage them through a user interface.','','10.4.8');
INSERT INTO `locales_source` VALUES ('1556','Allows users to register and log in, and manages user roles and permissions.','','10.4.8'),('1557','Provides a framework to fetch information from the database and to display it in different formats.','','10.4.8'),('1558','Allows for different styles to be used in views to work with Bootstrap 5 components.','','10.4.8'),('1559','Provides a View style that displays rows as a jQuery slideshow. This is an API and requires Views Slideshow Cycle or another module that supports the API.','','10.4.8'),('1560','Adds a Rotating slideshow mode to Views Slideshow.','','10.4.7'),('1561','Provides a user interface for creating and managing views.','','10.4.8'),('1562','Provides an interface to create workflows with transitions between different states (for example publication or user status) provided by other modules.','','10.4.8'),('1563','Allows users to stage content or preview a full site by using multiple workspaces on a single site.','','10.4.8'),('1564','Core','','10.4.8'),('1565','Other','','10.4.8'),('1566','Chaos tool suite','','10.4.8'),('1567','Chaos tool suite (Experimental)','','10.4.8'),('1568','Multilingual','','10.4.8'),('1569','Field types','','10.4.8'),('1570','Custom','','10.4.8'),('1571','Core (Experimental)','','10.4.8'),('1572','jQuery UI','','10.4.8'),('1573','Migration','','10.4.8'),('1574','Fields','','10.4.8'),('1575','Install','','10.4.8'),('1576','Filter by name or description','','10.4.8'),('1577','Enter a part of the module name or description','','10.4.8'),('1578','@module','','10.4.8'),('1579','@module (<span class="admin-disabled">disabled</span>)','','10.4.8'),('1580','Installed','','10.4.8'),('1581','Machine name: <span dir="ltr" class="table-filter-text-source">@machine-name</span>','','10.4.8'),('1582','Version: @module-version','','10.4.8'),('1583','Requires: @module-list','','10.4.8'),('1584','Help <span class="visually-hidden">for @module</span>','','10.4.8'),('1585','Permissions <span class="visually-hidden">for @module</span>','','10.4.8');
INSERT INTO `locales_source` VALUES ('1586','Configure <span class="visually-hidden">@module</span>','','10.4.8'),('1587','Required by: @module-list','','10.4.8'),('1588','@module_name (<span class="admin-missing">missing</span>)','','10.4.8'),('1589','Requires Drupal core:','','10.4.8'),('1590','@low_version_number to @high_version_number','','10.4.8'),('1591','Out of date','','10.4.8'),('1592','There are updates available for one or more of your modules or themes. To ensure the proper functioning of your site, you should update as soon as possible.','','10.4.8'),('1593','See the <a href=":available_updates">available updates</a> page for more information and to update your software.','','10.4.8'),('1594','Extend','With components','10.4.8'),('1595','Edit custom parameters for Menu Manipulators on this site.','','10.4.8'),('1596','Menu Manipulator settings','','10.4.8'),('1597','Uninstall','','10.4.8'),('1598','Add <a href=":modules">contributed modules</a> to extend your site''s functionality.','','10.4.8'),('1599','Regularly review <a href=":updates">available updates</a> and update as required to maintain a secure and current site. Always run the <a href=":update-php">update script</a> each time you update software.','','10.4.8'),('1600','Contact form','','10.4.8'),('1601','Contact message','','10.4.8'),('1602','Content block','','10.4.8'),('1603','Shortcut link','','10.4.8'),('1604','Custom language settings','','10.4.7'),('1605','N/A','','10.4.7'),('1606','Site''s default language (@language)','','10.4.7'),('1607','Interface text language selected for page','','10.4.7'),('1608','Author''s preferred language','','10.4.7'),('1609','Default language','','10.4.7'),('1610','Explanation of the language options is found on the <a href=":languages_list_page">languages list page</a>.','','10.4.7'),('1611','Show language selector on create and edit pages','','10.4.7'),('1612','@label (Translation is not supported).','','10.4.7'),('1613','Hide non translatable fields on translation forms','','10.4.7'),('1614','Alt','','10.4.7'),('1615','Display','','10.4.8');
INSERT INTO `locales_source` VALUES ('1616','Change language settings for <em>content types</em>, <em>taxonomy vocabularies</em>, <em>user profiles</em>, or any other supported element on your site. By default, language settings hide the language selector and the language is the site''s default language.','','10.4.7'),('1617','Displays','','10.4.8'),('1618','No menu','','10.4.8'),('1619','Change the machine name of this display.','','10.4.8'),('1620','None','','10.4.8'),('1621','Comment or document this display.','','10.4.8'),('1622','Change the title that this display will use.','','10.4.8'),('1623','Unformatted list','','10.4.8'),('1624','Change the way content is formatted.','','10.4.8'),('1625','Change settings for this format','','10.4.8'),('1626','Change the way each row in the view is styled.','','10.4.8'),('1627','Change settings for this style','','10.4.8'),('1628','No','','10.4.8'),('1629','Change whether or not this display will use AJAX.','','10.4.8'),('1630','Change whether or not to display attachments when displaying a contextual filter summary.','','10.4.8'),('1631','Shown','','10.4.8'),('1632','Change whether or not to display contextual links for this view.','','10.4.8'),('1633','Change this display''s pager setting.','','10.4.8'),('1634','@count itemPaged, @count items','','10.4.8'),('1635','Change settings for this pager type.','','10.4.8'),('1636','Specify whether this display will provide a "more" link.','','10.4.8'),('1637','Allow grouping and aggregation (calculation) of fields.','','10.4.8'),('1638','Allow to set some advanced settings for the query plugin','','10.4.8'),('1639','Content language of view row','','10.4.8'),('1640','All content that supports translations will be displayed in the selected language.','','10.4.8'),('1641','Specify access control type for this display.','','10.4.8'),('1642','View published content','','10.4.8'),('1643','Change settings for this access type.','','10.4.8'),('1644','Tag based','','10.4.8'),('1645','S