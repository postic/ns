INSERT INTO `locales_source` VALUES ('807','Swiss German','','10.4.7'),('808','Galician','','10.4.7'),('809','Scots Gaelic','','10.4.7'),('810','Irish','','10.4.7'),('811','Frisian, Western','','10.4.7'),('812','French','','10.4.7'),('813','Faeroese','','10.4.7'),('814','Filipino','','10.4.7'),('815','Finnish','','10.4.7'),('816','Persian, Farsi','','10.4.7'),('817','Basque','','10.4.7'),('818','English, British','','10.4.7'),('819','Estonian','','10.4.7'),('820','Spanish','','10.4.7'),('821','Esperanto','','10.4.7'),('822','Simple English','','10.4.7'),('823','Translation file','','10.4.7'),('824','A Gettext Portable Object file.','','10.4.7'),('825','Treat imported strings as custom translations','','10.4.7'),('826','Overwrite non-customized translations','','10.4.7'),('827','Overwrite existing customized translations','','10.4.7'),('828','Interface translation import','','10.4.7'),('829','Translation files are automatically downloaded and imported when <a title="Languages" href=":language">languages</a> are added, or when modules or themes are installed.','','10.4.7'),('830','This page allows translators to manually import translated strings contained in a Gettext Portable Object (.po) file. Manual import may be used for customized translations or for the translation of custom modules and themes. To customize translations you can download a translation file from the <a href=":url">Drupal translation server</a> or <a title="User interface translation export" href=":export">export</a> translations from the site, customize the translations using a Gettext translation editor, and import the result using this page.','','10.4.7'),('831','Note that importing large .po files may take several minutes.','','10.4.7'),('832','For security reasons, your upload has been renamed to %filename.','','10.4.7'),('833','Initializing.','','10.4.7'),('834','Starting configuration update','','10.4.7'),('835','Error importing interface translations','','10.4.7'),('836','Continue to <a href=":error_url">the error page</a>','','10.4.7');
