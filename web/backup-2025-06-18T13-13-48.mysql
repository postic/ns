INSERT INTO `node_revision__body` VALUES ('news','0','154','509','sr-Latn-RS','0','<p class="rtejustify">Gradonačelnik Novog Sada Žarko Mićin prisustvovao je svečanosti povodom promocije 46, 47, 48. i 49. klase polaznika Centra za osnovnu policijsku obuku u Sremskoj Kamenici, a tom prilikom prisutnima se obratio Ministar unutrašnjih poslova Ivica Dačić.</p><p class="rtejustify">Ministarstvo unutrašnjih poslova raspisalo je 14.12.2023. godine, konkurs za prijem 1100 polaznika na stručno osposobljavanje za obavljanje poslova uniformisanog policijskog službenika na radnom mestu policajca, saobraćajnog policajca za poslove saobraćajnih nezgoda i graničnog policajca, za potrebe 27 policijskih uprava. Po okončanju selekcione procedure donete su odluke o prijemu ukupno 780 polaznika, koji su raspoređeni u 46, 47, 48. i 49. klasu.</p><p class="rtejustify">- Želim da čestitam svim kandidatima koji su prošli rigoroznu selekciju i koji su osposobljeni za obavljanje različitih policijskih poslova, ali i da se zahvalim ovoj specifičnoj obrazovnoj ustanovi - Centru za policijsku obuku, na tome što stvaraju kadrove od vitalnog značaja za sve nas. Značajni su, jer štite zakon, a samim tim i zagarantovana prava svih građana. Pripadnici bezbednosnih snaga uvek su tu kada treba da se reaguje u vanrednim situacijama bilo koje vrste, i uvek rade u opštem interesu. Treba nagraditi one koji na sebe preuzimaju veliku odgovornost da rade za dobro svih drugih, a Grad će nastaviti da pomaže rad i policije i vatrogasaca i da sarađuje sa resornim ministarstvom, jer su bezbednost, sigurnost ljudi, javne i privatne imovine, prioritet bez presedana – naglasio je gradonačelnik Žarko Mićin.</p><p>Obuka polaznika trajala je između 22 i 29 nedelja, u odnosu na radno mesto za koje su osposobljavani, a najbolje rangiranim polaznicima nagrade je uručio direktor policije Dragan Vasiljević.</p><p class="rtejustify">Novi Sad, 28. maj 2025. godine</p>','','full_html'),('news','0','155','500','sr-Cyrl-RS','0','<p class="rtejustify">Градоначелник Новог Сада Жарко Мићин и чланица Градског већа за спорт и омладину Татјана Медвед састали су се данас у Градској кући са представницима ватерполо клуба „Војводина“. Делегацију су чинили председник Клуба Срђан Миљанић, директор Клуба Војислав Јовановић и шеф стручног штаба женских селекција ВК „Војводина“ Слађана Дрезгић. Они су на састанку разговарали о модалитетима унапређивања досадашње успешне сарадње, о предстојећем наступу женске ватерполо репрезентације Србије на квалификацијама за Европско првенство у Новом Саду, као и о обележавању важног јубилеја - 90 година од оснивања клуба.</p><p class="rtejustify">- Увек се радујем сусретима са спортским радницима и спортистима, а посебно смо сви поносни на успехе ватерполо клуба „Војводина“ из којег је поникло пет освајача златне Олимпијске медаље. И мушка и женска екипа овог Клуба континуирано постижу изванредне резултате, а посебно од деведесетих година. Наступају на највишем рангу у нашој земљи, и имају запажене успехе на европској сцени. ВК „Војводина“ слави 90 година неговања ватерполо спорта у Новом Саду и њихов допринос заједници је више него изузетан. Наш град претендује да буде Европски град спорта 2026. године, и на путу ка тој титули сигурно ће нам допринети традиција и активности овог успешног клуба – нагласио је градоначелник Жарко Мићин и додао – Град ће наставити да буде партнер спортским радницима и да подржава спорт, како улагањем у инфраструктуру, тако и кроз подршку клубовима, промоцију школског спорта, рекреације и физичких активности.</p><p class="rtejustify">Представници ватерполо клуба „Војводина“ захвалили су се градоначелнику на срдачном пријему и прилици да разговарају о важним питањима за новосадски ватеропло. Они су нагласили да Клуб тренутно броји 300 чланова који редовно тренирају и наступају, као и да су основ рада Клуба млађе категорије.</p><p class="rtejustify">Нови Сад, 28. мај 2025. године</p>','','full_html');
INSERT INTO `node_revision__body` VALUES ('news','0','155','501','sr-Cyrl-RS','0','<p class="rtejustify">Градоначелник Новог Сада Жарко Мићин и чланица Градског већа за спорт и омладину Татјана Медвед састали су се данас у Градској кући са представницима ватерполо клуба „Војводина“. Делегацију су чинили председник Клуба Срђан Миљанић, директор Клуба Војислав Јовановић и шеф стручног штаба женских селекција ВК „Војводина“ Слађана Дрезгић. Они су на састанку разговарали о модалитетима унапређивања досадашње успешне сарадње, о предстојећем наступу женске ватерполо репрезентације Србије на квалификацијама за Европско првенство у Новом Саду, као и о обележавању важног јубилеја - 90 година од оснивања клуба.</p><p class="rtejustify">- Увек се радујем сусретима са спортским радницима и спортистима, а посебно смо сви поносни на успехе ватерполо клуба „Војводина“ из којег је поникло пет освајача златне Олимпијске медаље. И мушка и женска екипа овог Клуба континуирано постижу изванредне резултате, а посебно од деведесетих година. Наступају на највишем рангу у нашој земљи, и имају запажене успехе на европској сцени. ВК „Војводина“ слави 90 година неговања ватерполо спорта у Новом Саду и њихов допринос заједници је више него изузетан. Наш град претендује да буде Европски град спорта 2026. године, и на путу ка тој титули сигурно ће нам допринети традиција и активности овог успешног клуба – нагласио је градоначелник Жарко Мићин и додао – Град ће наставити да буде партнер спортским радницима и да подржава спорт, како улагањем у инфраструктуру, тако и кроз подршку клубовима, промоцију школског спорта, рекреације и физичких активности.</p><p class="rtejustify">Представници ватерполо клуба „Војводина“ захвалили су се градоначелнику на срдачном пријему и прилици да разговарају о важним питањима за новосадски ватеропло. Они су нагласили да Клуб тренутно броји 300 чланова који редовно тренирају и наступају, као и да су основ рада Клуба млађе категорије.</p><p class="rtejustify">Нови Сад, 28. мај 2025. године</p>','','full_html');
INSERT INTO `node_revision__body` VALUES ('news','0','155','501','sr-Latn-RS','0','<p class="rtejustify">Gradonačelnik Novog Sada Žarko Mićin i članica Gradskog veća za sport i omladinu Tatjana Medved sastali su se danas u Gradskoj kući sa predstavnicima vaterpolo kluba „Vojvodina“. Delegaciju su činili predsednik Kluba Srđan Miljanić, direktor Kluba Vojislav Jovanović i šef stručnog štaba ženskih selekcija VK „Vojvodina“ Slađana Drezgić. Oni su na sastanku razgovarali o modalitetima unapređivanja dosadašnje uspešne saradnje, o predstojećem nastupu ženske vaterpolo reprezentacije Srbije na kvalifikacijama za Evropsko prvenstvo u Novom Sadu, kao i o obeležavanju važnog jubileja - 90 godina od osnivanja kluba.</p><p class="rtejustify">- Uvek se radujem susretima sa sportskim radnicima i sportistima, a posebno smo svi ponosni na uspehe vaterpolo kluba „Vojvodina“ iz kojeg je poniklo pet osvajača zlatne Olimpijske medalje. I muška i ženska ekipa ovog Kluba kontinuirano postižu izvanredne rezultate, a posebno od devedesetih godina. Nastupaju na najvišem rangu u našoj zemlji, i imaju zapažene uspehe na evropskoj sceni. VK „Vojvodina“ slavi 90 godina negovanja vaterpolo sporta u Novom Sadu i njihov doprinos zajednici je više nego izuzetan. Naš grad pretenduje da bude Evropski grad sporta 2026. godine, i na putu ka toj tituli sigurno će nam doprineti tradicija i aktivnosti ovog uspešnog kluba – naglasio je gradonačelnik Žarko Mićin i dodao – Grad će nastaviti da bude partner sportskim radnicima i da podržava sport, kako ulaganjem u infrastrukturu, tako i kroz podršku klubovima, promociju školskog sporta, rekreacije i fizičkih aktivnosti.</p><p class="rtejustify">Predstavnici vaterpolo kluba „Vojvodina“ zahvalili su se gradonačelniku na srdačnom prijemu i prilici da razgovaraju o važnim pitanjima za novosadski vateroplo. Oni su naglasili da Klub trenutno broji 300 članova koji redovno treniraju i nastupaju, kao i da su osnov rada Kluba mlađe kategorije.</p><p class="rtejustify">Novi Sad, 28. maj 2025. godine</p>','','full_html');
INSERT INTO `node_revision__body` VALUES ('news','0','155','502','sr-Cyrl-RS','0','<p class="rtejustify">Градоначелник Новог Сада Жарко Мићин и чланица Градског већа за спорт и омладину Татјана Медвед састали су се данас у Градској кући са представницима ватерполо клуба „Војводина“. Делегацију су чинили председник Клуба Срђан Миљанић, директор Клуба Војислав Јовановић и шеф стручног штаба женских селекција ВК „Војводина“ Слађана Дрезгић. Они су на састанку разговарали о модалитетима унапређивања досадашње успешне сарадње, о предстојећем наступу женске ватерполо репрезентације Србије на квалификацијама за Европско првенство у Новом Саду, као и о обележавању важног јубилеја - 90 година од оснивања клуба.</p><p class="rtejustify">- Увек се радујем сусретима са спортским радницима и спортистима, а посебно смо сви поносни на успехе ватерполо клуба „Војводина“ из којег је поникло пет освајача златне Олимпијске медаље. И мушка и женска екипа овог Клуба континуирано постижу изванредне резултате, а посебно од деведесетих година. Наступају на највишем рангу у нашој земљи, и имају запажене успехе на европској сцени. ВК „Војводина“ слави 90 година неговања ватерполо спорта у Новом Саду и њихов допринос заједници је више него изузетан. Наш град претендује да буде Европски град спорта 2026. године, и на путу ка тој титули сигурно ће нам допринети традиција и активности овог успешног клуба – нагласио је градоначелник Жарко Мићин и додао – Град ће наставити да буде партнер спортским радницима и да подржава спорт, како улагањем у инфраструктуру, тако и кроз подршку клубовима, промоцију школског спорта, рекреације и физичких активности.</p><p class="rtejustify">Представници ватерполо клуба „Војводина“ захвалили су се градоначелнику на срдачном пријему и прилици да разговарају о важним питањима за новосадски ватеропло. Они су нагласили да Клуб тренутно броји 300 чланова који редовно тренирају и наступају, као и да су основ рада Клуба млађе категорије.</p><p class="rtejustify">Нови Сад, 28. мај 2025. године</p>','','full_html');
