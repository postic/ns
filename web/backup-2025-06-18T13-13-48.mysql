DROP TABLE IF EXISTS `node_revision__body`;
CREATE TABLE `node_revision__body` (   `bundle` varchar(128) CHARACTER SET ascii COLLATE ascii_general_ci NOT NULL DEFAULT '' COMMENT 'The field instance bundle to which this row belongs, used when deleting a field instance',   `deleted` tinyint(4) NOT NULL DEFAULT 0 COMMENT 'A boolean indicating whether this data item has been deleted',   `entity_id` int(10) unsigned NOT NULL COMMENT 'The entity id this data is attached to',   `revision_id` int(10) unsigned NOT NULL COMMENT 'The entity revision id this data is attached to',   `langcode` varchar(32) CHARACTER SET ascii COLLATE ascii_general_ci NOT NULL DEFAULT '' COMMENT 'The language code for this data item.',   `delta` int(10) unsigned NOT NULL COMMENT 'The sequence number for this data item, used for multi-value fields',   `body_value` longtext NOT NULL,   `body_summary` longtext DEFAULT NULL,   `body_format` varchar(255) CHARACTER SET ascii COLLATE ascii_general_ci DEFAULT NULL,   PRIMARY KEY (`entity_id`,`revision_id`,`deleted`,`delta`,`langcode`),   KEY `bundle` (`bundle`),   KEY `revision_id` (`revision_id`),   KEY `body_format` (`body_format`) ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci COMMENT='Revision archive storage for node field body.';
INSERT INTO `node_revision__body` VALUES ('page','0','4','9','en','0','<p>ЖАРКО МИЋИН</p><p>Градоначелник Новог Сада</p><p>Aдреса: Трг слободе 1, 21000 Нови Сад, Србија<br>Бр. тeл: + 381 21 522 451 и 522 377<br>Фaкс: + 381 21 525 931<br>e-mail: <a href="mailto:zarko.micin@novisad.rs">zarko.micin@novisad.rs</a></p><p>Жарко Мићин је рођен 1982. године у Новом Саду. Дипломирао је на Правном факултету у Новом Саду и положио правосудни испит. Успешно је завршио Високе студије безбедности и одбране као полазник 13. класе Школе националне одбране.</p><p>Своју професионалну каријеру започиње као адвокатски приправник у адвокатској канцеларији Бајић, а након тога као руководилац правне службе и директор у приватној компанији. Касније обавља функцију председника Надзорног одбора Хотела „Праг” Београд и члана Надзорног одбора Завода за судска вештачења АД.</p><p>Поседује искуство на руководећим позицијама у јавном сектору као извршни директор ЈП „Завод за изградњу Града“ Нови Сад, генерални директор ЈП „Спортски и пословни центар Војводина“ Нови Сад, извршни директор ЈП „Урбанизам“ – Завод за урбанизам Нови Сад. Обављао је функцију шефа Kабинета градоначелника Новог Сада и био координатор изградње и председник Kомисије за избор корисника 522 стана за избегла лица. Три пута је биран за народног посланика Народне скупштине Републике Србије. Био је члан Скупштинског одбора за европске интеграције, Одбора за правосуђе, државну управу и локалну самоуправу као и члан скупштинске делегације у Парламентарној скупштини Савета Европе.</p><p>Од 2018. до ступања на функцију 2021. године радио је као адвокат у сопственој адвокатској канцеларији Мићин. Председник је Управног одбора Југоимпорт СДПР Ј.П. Обављао је функцију шефа Kабинета потпредседника Владе и министра одбране, као и шефа Кабинета председника Владе.</p><p>За Градоначелника Новог Сада изабран је 24. фебруара 2025. године.</p><p>Редовно је одслужио војни рок. Течно говори енглески језик.</p><p>Ожењен је и отац две ћерке.</p>','','basic_html');
INSERT INTO `node_revision__body` VALUES ('page','0','4','132','sr-Cyrl-RS','0','<p>ЖАРКО МИЋИН</p><p>Градоначелник Новог Сада</p><p>Aдреса: Трг слободе 1, 21000 Нови Сад, Србија<br>Бр. тeл: + 381 21 522 451 и 522 377<br>Фaкс: + 381 21 525 931<br>e-mail: <a href="mailto:zarko.micin@novisad.rs">zarko.micin@novisad.rs</a></p><p>Жарко Мићин је рођен 1982. године у Новом Саду. Дипломирао је на Правном факултету у Новом Саду и положио правосудни испит. Успешно је завршио Високе студије безбедности и одбране као полазник 13. класе Школе националне одбране.</p><p>Своју професионалну каријеру започиње као адвокатски приправник у адвокатској канцеларији Бајић, а након тога као руководилац правне службе и директор у приватној компанији. Касније обавља функцију председника Надзорног одбора Хотела „Праг” Београд и члана Надзорног одбора Завода за судска вештачења АД.</p><p>Поседује искуство на руководећим позицијама у јавном сектору као извршни директор ЈП „Завод за изградњу Града“ Нови Сад, генерални директор ЈП „Спортски и пословни центар Војводина“ Нови Сад, извршни директор ЈП „Урбанизам“ – Завод за урбанизам Нови Сад. Обављао је функцију шефа Kабинета градоначелника Новог Сада и био координатор изградње и председник Kомисије за избор корисника 522 стана за избегла лица. Три пута је биран за народног посланика Народне скупштине Републике Србије. Био је члан Скупштинског одбора за европске интеграције, Одбора за правосуђе, државну управу и локалну самоуправу као и члан скупштинске делегације у Парламентарној скупштини Савета Европе.</p><p>Од 2018. до ступања на функцију 2021. године радио је као адвокат у сопственој адвокатској канцеларији Мићин. Председник је Управног одбора Југоимпорт СДПР Ј.П. Обављао је функцију шефа Kабинета потпредседника Владе и министра одбране, као и шефа Кабинета председника Владе.</p><p>За Градоначелника Новог Сада изабран је 24. фебруара 2025. године.</p><p>Редовно је одслужио војни рок. Течно говори енглески језик.</p><p>Ожењен је и отац две ћерке.</p>','','basic_html');
