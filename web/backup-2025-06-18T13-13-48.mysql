INSERT INTO `locales_source` VALUES ('695','This page allows a translator to search for specific translated and untranslated strings, and is used when creating or editing translations. (Note: Because translation tasks involve many strings, it may be more convenient to <a title="User interface translation export" href=":export">export</a> strings for offline editing in a desktop Gettext translation editor.) Searches may be limited to strings in a specific language.','','10.4.7'),('696','Weight','','10.4.8'),('697','Interface translation','','10.4.7'),('698','Set @title as default','','10.4.7'),('699','Weight for @title','','10.4.8'),('700','not applicable','','10.4.7'),('701','Edit @entity_label','','10.4.8'),('702','@translated/@total (@ratio%)','','10.4.7'),('703','Delete @entity_label','','10.4.8'),('704','Save configuration','','10.4.7'),('705','Reorder the configured languages to set their order in the language switcher block and, when editing content, in the list of selectable languages. This ordering does not impact <a href=":detection">detection and selection</a>.','','10.4.7'),('706','The site default language can also be set. It is not recommended to change the default language on a working site. <a href=":language-detection">Configure the Selected language</a> setting on the detection and selection page to change the fallback language for language selection.','','10.4.7'),('707','Interface translations are automatically imported when a language is added, or when new modules or themes are installed. The report <a href=":update">Available translation updates</a> shows the status. Interface text can be customized in the <a href=":translate">user interface translation</a> page.','','10.4.7'),('708','List additional actions','','10.4.8'),('709','You have unsaved changes.','','10.4.8'),('710','Hide row weights','','10.4.8'),('711','Show row weights','','10.4.8'),('712','Change order','','10.4.8'),('713','Move in any direction','','10.4.8'),('714','Configuration saved.','','10.4.7'),('715','Existing languages','','10.4.7'),('716','Languages not yet added','','10.4.7');
