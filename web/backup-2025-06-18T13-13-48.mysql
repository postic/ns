DROP TABLE IF EXISTS `search_dataset`;
CREATE TABLE `search_dataset` (   `sid` int(10) unsigned NOT NULL DEFAULT 0 COMMENT 'Search item ID, e.g. node ID for nodes.',   `langcode` varchar(12) CHARACTER SET ascii COLLATE ascii_general_ci NOT NULL DEFAULT '' COMMENT 'The "languages".langcode of the item variant.',   `type` varchar(64) CHARACTER SET ascii COLLATE ascii_general_ci NOT NULL COMMENT 'Type of item, e.g. node.',   `data` longtext NOT NULL COMMENT 'List of space-separated words from the item.',   `reindex` int(10) unsigned NOT NULL DEFAULT 0 COMMENT 'Set to force node reindexing.',   PRIMARY KEY (`sid`,`langcode`,`type`) ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci COMMENT='Stores items that will be searched.';
INSERT INTO `search_dataset` VALUES ('1','en','help_search',' importing your complete site configuration goal import the complete configuration of your site from an archive file such as one that was previously exported see exporting your complete site configuration see managing and deploying configuration for more information about configuration steps in the manage administrative menu navigate to configuration   development   configuration synchronization   import  browse to find the configuration archive that you want to import click upload  your configuration archive will be unpacked and placed in the configuration synchronization directory and you will be redirected to the synchronize page review the differences between your uploaded configuration and the active configuration if any and click import all to import the changes  ','0'),('1','sr-Cyrl-RS','help_search',' importing your complete site configuration goal import the complete configuration of your site from an archive file such as one that was previously exported see exporting your complete site configuration see managing and deploying configuration for more information about configuration steps in the manage administrative menu navigate to configuration   development   configuration synchronization   увоз  browse to find the configuration archive that you want to import click upload  your configuration archive will be unpacked and placed in the configuration synchronization directory and you will be redirected to the synchronize page review the differences between your uploaded configuration and the active configuration if any and click import all to import the changes  ','0'),('1','sr-Latn-RS','help_search',' importing your complete site configuration goal import the complete configuration of your site from an archive file such as one that was previously exported see exporting your complete site configuration see managing and deploying configuration for more information about configuration steps in the manage administrative menu navigate to configuration   development   configuration synchronization   import  browse to find the configuration archive that you want to import click upload  your configuration archive will be unpacked and placed in the configuration synchronization directory and you will be redirected to the synchronize page review the differences between your uploaded configuration and the active configuration if any and click import all to import the changes  ','0');
INSERT INTO `search_dataset` VALUES ('2','en','help_search',' exporting your complete site configuration goal create and download an archive containing all your site s configuration exported as yaml files see managing and deploying configuration for more information about configuration steps in the manage administrative menu navigate to configuration   development   configuration synchronization   export  click export and save the archive file  ','0'),('2','sr-Cyrl-RS','help_search',' exporting your complete site configuration goal create and download an archive containing all your site s configuration exported as yaml files see managing and deploying configuration for more information about configuration steps in the manage administrative menu navigate to configuration   development   configuration synchronization   извоз  click export and save the archive file  ','0'),('2','sr-Latn-RS','help_search',' exporting your complete site configuration goal create and download an archive containing all your site s configuration exported as yaml files see managing and deploying configuration for more information about configuration steps in the manage administrative menu navigate to configuration   development   configuration synchronization   export  click export and save the archive file  ','0'),('3','en','help_search',' exporting a single configuration item goal export a single configuration item to a file see managing and deploying configuration for more information about configuration steps in the manage administrative menu navigate to configuration   development   configuration synchronization   export   single item  select the configuration type that you want to export and then select the specific configuration name to export use your browser to copy the text in the box marked here is your configuration to the clipboard paste the copied text into a plaintext editor on your computer or other device and save it using the suggested file name below the text box  ','0'),('3','sr-Cyrl-RS','help_search',' exporting a single configuration item goal export a single configuration item to a file see managing and deploying configuration for more information about configuration steps in the manage administrative menu navigate to configuration   development   configuration synchronization   export   single item  select the configuration type that you want to export and then select the specific configuration name to export use your browser to copy the text in the box marked here is your configuration to the clipboard paste the copied text into a plaintext editor on your computer or other device and save it using the suggested file name below the text box  ','0');
INSERT INTO `search_dataset` VALUES ('3','sr-Latn-RS','help_search',' exporting a single configuration item goal export a single configuration item to a file see managing and deploying configuration for more information about configuration steps in the manage administrative menu navigate to configuration   development   configuration synchronization   export   single item  select the configuration type that you want to export and then select the specific configuration name to export use your browser to copy the text in the box marked here is your configuration to the clipboard paste the copied text into a plaintext editor on your computer or other device and save it using the suggested file name below the text box  ','0'),('4','en','help_search',' importing a single configuration item goal import a single configuration item in yaml format such as one that was previously exported see exporting a single configuration item see managing and deploying configuration for more information about configuration steps in the manage administrative menu navigate to configuration   development   configuration synchronization   import   single item  select the configuration type that you want to import on your computer or other device copy the yamlformat configuration that you want to import to the clipboard paste the clipboard text into the box labeled paste your configuration here  click import   ','0'),('4','en','node_search',' biography biography admin fri 5232025 1812 zarko micin mayor of novi sad address trg slobode 1 21000 novi sad serbia tel no 381 21 522 451 and 522 377 fax 381 21 525 931 email  zarkomicin novisadrs zarko micin was born in 1982 in novi sad he graduated from the faculty of law in novi sad and passed the bar exam he successfully completed the higher studies in security and defense class 13 of the national defense school he began his professional career as a law intern at the bajic law firm and later as the head of the legal department and director of a private company later he was the chairman of the supervisory board of the hotel prague in belgrade as well as a member of the supervisory board of the institute for forensic expertise ad he has considerable experience in management positions in the public sector as the executive director of the novi sad pe city construction institute general director of the novi sad pe sports and business center of vojvodina executive director of the novi sad pe urbanizam institute for urban planning he served as the head of the novi sad mayor s office and was the construction coordinator and chairman of the commission for the selection of users of 522 apartments for refugees he was elected three times member of the national assembly of the republic of serbia during which he was on the parliamentary committee for european integration committee for justice state administration and local selfgovernment as well as in the parliamentary delegation to the parliamentary assembly of the council of europe from 2018 until taking office in 2021 he worked as a lawyer in his own micin law firm he is the president of the board of directors of pe jugoimport sdpr he served as the head of the deputy prime minister s and minister of defense s office as well as the head of the prime minister s office he was elected mayor of the city of novi sad on february 24th 2025 he completed full military service he speaks english fluently he is married a father of two daughters ','0');
INSERT INTO `search_dataset` VALUES ('4','sr-Cyrl-RS','help_search',' importing a single configuration item goal import a single configuration item in yaml format such as one that was previously exported see exporting a single configuration item see managing and deploying configuration for more information about configuration steps in the manage administrative menu navigate to configuration   development   configuration synchronization   import   single item  select the configuration type that you want to import on your computer or other device copy the yamlformat configuration that you want to import to the clipboard paste the clipboard text into the box labeled paste your configuration here  click import   ','0'),('4','sr-Cyrl-RS','node_search',' биографија биографија admin mon 4282025 921 жарко мићин градоначелник новог сада aдреса трг слободе 1 21000 нови сад србија бр тeл 381 21 522 451 и 522 377 фaкс 381 21 525 931 email  zarkomicin novisadrs жарко мићин је рођен 1982 године у новом саду дипломирао је на правном факултету у новом саду и положио правосудни испит успешно је завршио високе студије безбедности и одбране као полазник 13 класе школе националне одбране своју професионалну каријеру започиње као адвокатски приправник у адвокатској канцеларији бајић а након тога као руководилац правне службе и директор у приватној компанији касније обавља функцију председника надзорног одбора хотела праг београд и члана надзорног одбора завода за судска вештачења ад поседује искуство на руководећим позицијама у јавном сектору као извршни директор јп завод за изградњу града нови сад генерални директор јп спортски и пословни центар војводина нови сад извршни директор јп урбанизам завод за урбанизам нови сад обављао је функцију шефа kабинета градоначелника новог сада и био координатор изградње и председник kомисије за избор корисника 522 стана за избегла лица три пута је биран за народног посланика народне скупштине републике србије био је члан скупштинског одбора за европске интеграције одбора за правосуђе државну управу и локалну самоуправу као и члан скупштинске делегације у парламентарној скупштини савета европе од 2018 до ступања на функцију 2021 године радио је као адвокат у сопственој адвокатској канцеларији мићин председник је управног одбора југоимпорт сдпр јп обављао је функцију шефа kабинета потпредседника владе и министра одбране као и шефа кабинета председника владе за градоначелника новог сада изабран је 24 фебруара 2025 године редовно је одслужио војни рок течно говори енглески језик ожењен је и отац две ћерке ','0');
INSERT INTO `search_dataset` VALUES ('4','sr-Latn-RS','help_search',' importing a single configuration item goal import a single configuration item in yaml format such as one that was previously exported see exporting a single configuration item see managing and deploying configuration for more information about configuration steps in the manage administrative menu navigate to configuration   development   configuration synchronization   import   single item  select the configuration type that you want to import on your computer or other device copy the yamlformat configuration that you want to import to the clipboard paste the clipboard text into the box labeled paste your configuration here  click import   ','0'),('4','sr-Latn-RS','node_search',' biografija biografija admin fri 5232025 1756 zarko micin gradonacelnik novog sada adresa trg slobode 1 21000 novi sad srbija br tel 381 21 522 451 i 522 377 faks 381 21 525 931 email  zarkomicin novisadrs zarko micin je roden 1982 godine u novom sadu diplomirao je na pravnom fakultetu u novom sadu i polozio pravosudni ispit uspesno je zavrsio visoke studije bezbednosti i odbrane kao polaznik 13 klase skole nacionalne odbrane svoju profesionalnu karijeru zapocinje kao advokatski pripravnik u advokatskoj kancelariji bajic a nakon toga kao rukovodilac pravne sluzbe i direktor u privatnoj kompaniji kasnije obavlja funkciju predsednika nadzornog odbora hotela prag beograd i clana nadzornog odbora zavoda za sudska vestacenja ad poseduje iskustvo na rukovodecim pozicijama u javnom sektoru kao izvrsni direktor jp zavod za izgradnju grada novi sad generalni direktor jp sportski i poslovni centar vojvodina novi sad izvrsni direktor jp urbanizam ndas zavod za urbanizam novi sad obavljao je funkciju sefa kabineta gradonacelnika novog sada i bio koordinator izgradnje i predsednik komisije za izbor korisnika 522 stana za izbegla lica tri puta je biran za narodnog poslanika narodne skupstine republike srbije bio je clan skupstinskog odbora za evropske integracije odbora za pravosude drzavnu upravu i lokalnu samoupravu kao i clan skupstinske delegacije u parlamentarnoj skupstini saveta evrope od 2018 do stupanja na funkciju 2021 godine radio je kao advokat u sopstvenoj advokatskoj kancelariji micin predsednik je upravnog odbora jugoimport sdpr jp obavljao je funkciju sefa kabineta potpredsednika vlade i ministra odbrane kao i sefa kabineta predsednika vlade za gradonacelnika novog sada izabran je 24 februara 2025 godine redovno je odsluzio vojni rok tecno govori engleski jezik ozenjen je i otac dve cerke ','0');
INSERT INTO `search_dataset` VALUES ('5','en','help_search',' setting a default contact form goal set a sitewide contact form to be the default contact form  the form displayed on the default contact page  for example   contact   steps in the manage administrative menu navigate to structure   contact forms  click edit for the sitewide form you want to be the default check make this the default form and click save   ','0'),('5','sr-Cyrl-RS','help_search',' setting a default contact form goal set a sitewide contact form to be the default contact form  the form displayed on the default contact page  for example   contact   steps in the manage administrative menu navigate to structure   contact forms  click edit for the sitewide form you want to be the default check make this the default form and click save   ','0'),('5','sr-Latn-RS','help_search',' setting a default contact form goal set a sitewide contact form to be the default contact form  the form displayed on the default contact page  for example   contact   steps in the manage administrative menu navigate to structure   contact forms  click edit for the sitewide form you want to be the default check make this the default form and click save   ','0'),('6','en','help_search',' configuring personal contact forms goal configure personal contact forms for registered users on the website steps in the manage administrative menu navigate to configuration   people   account settings  in the contact settings section check uncheck the box to enable disable the contact form for new user accounts click save configuration  in the manage administrative menu navigate to people   permissions  verify that permissions are correct for your site s roles including the generic anonymous user and authenticated user  in order to use personal contact forms users need both view user information  in the user section which enables them to view user profiles and use users personal contact forms  in the contact section which enables them to use contact forms if they can view user profiles click save permissions  the contact form will always have subject and message fields if you want to add more fields follow the steps in managing the fields of contact forms  ','0');
INSERT INTO `search_dataset` VALUES ('6','sr-Cyrl-RS','help_search',' configuring personal contact forms goal configure personal contact forms for registered users on the website steps in the manage administrative menu navigate to configuration   people   account settings  in the contact settings section check uncheck the box to enable disable the contact form for new user accounts click save configuration  in the manage administrative menu navigate to people   permissions  verify that permissions are correct for your site s roles including the generic anonymous user and authenticated user  in order to use personal contact forms users need both view user information  in the user section which enables them to view user profiles and use users personal contact forms  in the contact section which enables them to use contact forms if they can view user profiles click save permissions  the contact form will always have subject and message fields if you want to add more fields follow the steps in managing the fields of contact forms  ','0'),('6','sr-Latn-RS','help_search',' configuring personal contact forms goal configure personal contact forms for registered users on the website steps in the manage administrative menu navigate to configuration   people   account settings  in the contact settings section check uncheck the box to enable disable the contact form for new user accounts click save configuration  in the manage administrative menu navigate to people   permissions  verify that permissions are correct for your site s roles including the generic anonymous user and authenticated user  in order to use personal contact forms users need both view user information  in the user section which enables them to view user profiles and use users personal contact forms  in the contact section which enables them to use contact forms if they can view user profiles click save permissions  the contact form will always have subject and message fields if you want to add more fields follow the steps in managing the fields of contact forms  ','0');
INSERT INTO `search_dataset` VALUES ('7','en','help_search',' managing contact forms what are contact forms  there are two different types of contact forms provided by the core contact module personal contact forms which allow users to contact other users on the site and sitewide contact forms which allow users to contact site managers or administrators a site can have more than one sitewide contact form each has its own fields to fill out recipients and url you can also change the fields that are shown on personal contact forms using the personal contact form site visitors can email registered users on your site by using the personal contact form without knowing or learning the email address of the recipient when a user with the correct permissions is viewing another user s profile the viewer will see a contact tab or link which leads to the personal contact form if the user whose profile is being viewed has their personal contact form enabled this is a user account setting  contact form management tasks see the related topics below for specific tasks  ','0'),('7','sr-Cyrl-RS','help_search',' managing contact forms what are contact forms  there are two different types of contact forms provided by the core contact module personal contact forms which allow users to contact other users on the site and sitewide contact forms which allow users to contact site managers or administrators a site can have more than one sitewide contact form each has its own fields to fill out recipients and url you can also change the fields that are shown on personal contact forms using the personal contact form site visitors can email registered users on your site by using the personal contact form without knowing or learning the email address of the recipient when a user with the correct permissions is viewing another user s profile the viewer will see a contact tab or link which leads to the personal contact form if the user whose profile is being viewed has their personal contact form enabled this is a user account setting  contact form management tasks see the related topics below for specific tasks  ','0');
INSERT INTO `search_dataset` VALUES ('7','sr-Latn-RS','help_search',' managing contact forms what are contact forms  there are two different types of contact forms provided by the core contact module personal contact forms which allow users to contact other users on the site and sitewide contact forms which allow users to contact site managers or administrators a site can have more than one sitewide contact form each has its own fields to fill out recipients and url you can also change the fields that are shown on personal contact forms using the personal contact form site visitors can email registered users on your site by using the personal contact form without knowing or learning the email address of the recipient when a user with the correct permissions is viewing another user s profile the viewer will see a contact tab or link which leads to the personal contact form if the user whose profile is being viewed has their personal contact form enabled this is a user account setting  contact form management tasks see the related topics below for specific tasks  ','0'),('8','en','help_search',' managing the fields of contact forms goal add remove or rearrange the fields on personal and sitewide contact forms what are the fields on contact forms  both personal and sitewide contact forms will always have subject and message fields you can add additional fields for users to fill out if desired note that if you want to display other content on a form page such as text or images you can use a content block steps in the manage administrative menu navigate to structure   contact forms  click manage fields for the form you want to change the fields of and add or remove one or more fields on the form click manage form display to change the order or configuration of the fields on the form  ','0'),('8','en','node_search',' биографија заменика градоначелника новог сада биографија заменика градоначелника новог сада admin fri 4252025 1058 ad erat saluto comis luctus nutus pecus wisi abigo aptent dignissim distineo letalis quae refoveo vulputate aliquip commoveo odio similis vindico camur inhibeo ut veniam abico ludus nisl pecus persto valetudo camur in mauris nisl vulputate abluo augue fere inhibeo meus patria proprius quibus quidne verto accumsan consectetuer ille sudo suscipit ymo cui genitus jus nisl praemitto distineo erat eros facilisis neo praesent quia damnum magna tum adipiscing consectetuer erat quia saepius aptent autem bene dignissim humo nostrud nulla rusticus erat eu genitus lobortis luctus neque odio quadrum vicis ad amet causa cui distineo incassum ut vereor zelus blandit obruo valde at esse lobortis populus sino ut utinam virtus haero luptatum neque brevitas esse melior sino ullamcorper comis defui ex ibidem neo pala paratus torqueo utinam consequat eros ibidem macto nimis quibus singularis verto virtus vulputate fere immitto probo brevitas consequat mos vulpes duis euismod facilisis venio abluo commodo iriure ut abigo at enim importunus patria pertineo praesent vel attachment size screenshot 20250509 at 133225 биографија заменика градоначелника новог сада novi sad3txt 40954 kb some description some description some description 40954 kb најава догађаја саопштење сервисна информација ','1748073635');
INSERT INTO `search_dataset` VALUES ('8','sr-Cyrl-RS','help_search',' managing the fields of contact forms goal add remove or rearrange the fields on personal and sitewide contact forms what are the fields on contact forms  both personal and sitewide contact forms will always have subject and message fields you can add additional fields for users to fill out if desired note that if you want to display other content on a form page such as text or images you can use a content block steps in the manage administrative menu navigate to structure   contact forms  click manage fields for the form you want to change the fields of and add or remove one or more fields on the form click manage form display to change the order or configuration of the fields on the form  ','0'),('8','sr-Cyrl-RS','node_search',' биографија заменика градоначелника новог сада биографија заменика градоначелника новог сада admin fri 4252025 1058 ad erat saluto comis luctus nutus pecus wisi abigo aptent dignissim distineo letalis quae refoveo vulputate aliquip commoveo odio similis vindico camur inhibeo ut veniam abico ludus nisl pecus persto valetudo camur in mauris nisl vulputate abluo augue fere inhibeo meus patria proprius quibus quidne verto accumsan consectetuer ille sudo suscipit ymo cui genitus jus nisl praemitto distineo erat eros facilisis neo praesent quia damnum magna tum adipiscing consectetuer erat quia saepius aptent autem bene dignissim humo nostrud nulla rusticus erat eu genitus lobortis luctus neque odio quadrum vicis ad amet causa cui distineo incassum ut vereor zelus blandit obruo valde at esse lobortis populus sino ut utinam virtus haero luptatum neque brevitas esse melior sino ullamcorper comis defui ex ibidem neo pala paratus torqueo utinam consequat eros ibidem macto nimis quibus singularis verto virtus vulputate fere immitto probo brevitas consequat mos vulpes duis euismod facilisis venio abluo commodo iriure ut abigo at enim importunus patria pertineo praesent vel attachment 