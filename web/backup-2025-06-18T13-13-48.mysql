INSERT INTO `node_revision__body` VALUES ('article','0','48','459','sr-Latn-RS','0','<p>DANIJELA ANDRIĆ</p><p>Trg slobode 1, 21101 Novi Sad<br>Telefon: +381 21 524 486<br>imejl: <a href="mailto:danijela.andric@novisad.rs">danijela.andric@novisad.rs</a></p><p>Rođena je 3. novembra 1975.godine u Žabljaku, Crna Gora, gde je završila Prirodno matematičku gimnaziju, smer saradnik u prirodno matematičkim naukama. Potom je&nbsp; završila&nbsp; Prirodno matematički fakultet u Novom Sadu, i stekla zvanje profesor biologije, 2000.godine, nakon čega je započela magistarske studije u oblasti Genetike i oplemenjivanja bilja na Poljoprivrednom fakultetu u Novom Sadu.</p><p>RADNO ISKUSTVO</p><p>2021-2024 Pomoćnik direktora za projektovanje, podizanje, održavanje i proizvodnju zelenila&nbsp; JKP ,,Gradsko zelenilo" Novi Sad;<br>2013-2021 Rukovodilac proizvodnje i održavanja zelenila JKP,,Gradsko zelenilo" Novi Sad;<br>2009-2013 Rukovodilac Odeljenja podizanja i održavanja zelenila JKP,,Gradsko zelenilo" Novi Sad;<br>2007 – 2009 Rukovodilac Radne jedinice ,,Dendrologija i iskorišćenje biljnog otpada" JKP „Gradsko zelenilo" Novi Sad;<br>2006 -2007 Inženjer operativac Radne jedinice ,,Dendrologija i iskorišćenje biljnog otpada" JKP „Gradsko zelenilo" Novi Sad;<br>2004 -2006 Fakultet tehničkih nauka, Univerzitet u Novom Sadu - Centar za automatizaciju i mehatroniku, saradnik za ekologiju, Ekologija i zaštita životne sredine.</p><p>Učesnik je i predavač na slovenačko - srpskim poslovnim skupovima u Ljubljani i Mariboru na temu zelenila u gradskim sredinama i upotrebi biomase za proizvodnju komposta.&nbsp;</p><p>Pored toga, imala je aktivno učešće na projektima od stane UNDP-a, kao menadžer projekta ,,Zacirkuliraj sa kompostom", kao i&nbsp; menadžer projekta ,,Upotreba biomase za proizvodnju komposta" GIZ-a.</p><p>Učestvovala je na realizaciji projekata IPA programa prekogranične saradnje Hrvatska-Srbija, u projektu ,,GreEnergy“&nbsp; kao i na projektu ,,Zeleni gradovi Srbije" u organizaciji Holandske ambasade u Srbiji, gde su realizovani projekti na teritoriji Grada Novog Sada. Aktivni učesnik i predavač na stručnim skupovima i konferencijama posvećenim urbanom zelenilu i održivom pejzažnom uređenju, kao i na temu&nbsp; „Proizvodnja drvorednih sadnica i kalemljenih lišćara i njihova primena“ u Inženjerskoj&nbsp; komori Srbije i u realizaciji publikacije Novi Sad –biodiverzitetski grad.</p><p>Član je Radne grupe za zaštitu životne sredine Grada Novog Sada.</p><p>Govori engleski jezik.</p><p>Majka je dvoje dece.</p>','','basic_html');
INSERT INTO `node_revision__body` VALUES ('article','0','48','460','en','0','<p>DANIJELA ANDRIĆ</p><p>Address: Trg slobode 1, 21101 Novi Sad, Serbia<br>Telephone: +381 21 524 486<br>e-mail:<a href="mailto: danijela.andric@novisad.rs">&nbsp;danijela.andric@novisad.rs</a></p>','','basic_html'),('article','0','48','460','sr-Cyrl-RS','0','<p>ДАНИЈЕЛА АНДРИЋ</p><p>Трг слободе 1, 21101 Нови Сад<br>Телефон: +381 21 524 486<br>imejl: <a href="mailto:danijela.andric@novisad.rs">danijela.andric@novisad.rs</a></p><p>Рођена је 3. новембра 1975.године у Жабљаку, Црна Гора, где је завршила Природно математичку гимназију, смер сарадник у природно математичким наукама. Потом је&nbsp; завршила&nbsp; Природно математички факултет у Новом Саду, и стекла звање професор биологије, 2000.године, након чега је започела магистарске студије у области Генетике и оплемењивања биља на Пољопривредном факултету у Новом Саду.</p><p>РАДНО ИСКУСТВО</p><p>2021-2024 Помоћник директора за пројектовање, подизање, одржавање и производњу зеленила&nbsp; ЈКП ,,Градско зеленило" Нови Сад;<br>2013-2021 Руководилац производње и одржавања зеленила ЈКП,,Градско зеленило" Нови Сад;<br>2009-2013 Руководилац Одељења подизања и одржавања зеленила ЈКП,,Градско зеленило" Нови Сад;<br>2007 – 2009 Руководилац Радне јединице ,,Дендрологија и искоришћење биљног отпада" ЈКП „Градско зеленило" Нови Сад;<br>2006 -2007 Инжењер оперативац Радне јединице ,,Дендрологија и искоришћење биљног отпада" ЈКП „Градско зеленило" Нови Сад;<br>2004 -2006 Факултет техничких наука, Универзитет у Новом Саду - Центар за аутоматизацију и мехатронику, сарадник за екологију, Екологија и заштита животне средине.</p><p>Учесник је и предавач на словеначко - српским пословним скуповима у Љубљани и Марибору на тему зеленила у градским срединама и употреби биомасе за производњу компоста.&nbsp;</p><p>Поред тога, имала је активно учешће на пројектима од стане УНДП-а, као менаџер пројекта ,,Зациркулирај са компостом", као и&nbsp; менаџер пројекта ,,Употреба биомасе за производњу компоста" ГИЗ-а.</p><p>Учествовала је на реализацији пројеката ИПА програма прекограничне сарадње Хрватска-Србија, у пројекту ,,GreEnergy“&nbsp; као и на пројекту ,,Зелени градови Србије" у организaцији Холандске амбасаде у Србији, где су реализовани пројекти на територији Града Новог Сада. Активни учесник и предавач на стручним скуповима и конференцијама посвећеним урбаном зеленилу и одрживом пејзажном уређењу, као и на тему&nbsp; „Производња дрворедних садница и калемљених лишћара и њихова примена“ у Инжењерској&nbsp; комори Србије и у реализацији публикације Нови Сад –биодиверзитетски град.</p><p>Члан је Радне групе за заштиту животне средине Града Новог Сада.</p><p>Говори енглески језик.</p><p>Mајка je двоје деце.</p>','','basic_html');
INSERT INTO `node_revision__body` VALUES ('article','0','48','460','sr-Latn-RS','0','<p>DANIJELA ANDRIĆ</p><p>Trg slobode 1, 21101 Novi Sad<br>Telefon: +381 21 524 486<br>imejl: <a href="mailto:danijela.andric@novisad.rs">danijela.andric@novisad.rs</a></p><p>Rođena je 3. novembra 1975.godine u Žabljaku, Crna Gora, gde je završila Prirodno matematičku gimnaziju, smer saradnik u prirodno matematičkim naukama. Potom je&nbsp; završila&nbsp; Prirodno matematički fakultet u Novom Sadu, i stekla zvanje profesor biologije, 2000.godine, nakon čega je započela magistarske studije u oblasti Genetike i oplemenjivanja bilja na Poljoprivrednom fakultetu u Novom Sadu.</p><p>RADNO ISKUSTVO</p><p>2021-2024 Pomoćnik direktora za projektovanje, podizanje, održavanje i proizvodnju zelenila&nbsp; JKP ,,Gradsko zelenilo" Novi Sad;<br>2013-2021 Rukovodilac proizvodnje i održavanja zelenila JKP,,Gradsko zelenilo" Novi Sad;<br>2009-2013 Rukovodilac Odeljenja podizanja i održavanja zelenila JKP,,Gradsko zelenilo" Novi Sad;<br>2007 – 2009 Rukovodilac Radne jedinice ,,Dendrologija i iskorišćenje biljnog otpada" JKP „Gradsko zelenilo" Novi Sad;<br>2006 -2007 Inženjer operativac Radne jedinice ,,Dendrologija i iskorišćenje biljnog otpada" JKP „Gradsko zelenilo" Novi Sad;<br>2004 -2006 Fakultet tehničkih nauka, Univerzitet u Novom Sadu - Centar za automatizaciju i mehatroniku, saradnik za ekologiju, Ekologija i zaštita životne sredine.</p><p>Učesnik je i predavač na slovenačko - srpskim poslovnim skupovima u Ljubljani i Mariboru na temu zelenila u gradskim sredinama i upotrebi biomase za proizvodnju komposta.&nbsp;</p><p>Pored toga, imala je aktivno učešće na projektima od stane UNDP-a, kao menadžer projekta ,,Zacirkuliraj sa kompostom", kao i&nbsp; menadžer projekta ,,Upotreba biomase za proizvodnju komposta" GIZ-a.</p><p>Učestvovala je na realizaciji projekata IPA programa prekogranične saradnje Hrvatska-Srbija, u projektu ,,GreEnergy“&nbsp; kao i na projektu ,,Zeleni gradovi Srbije" u organizaciji Holandske ambasade u Srbiji, gde su realizovani projekti na teritoriji Grada Novog Sada. Aktivni učesnik i predavač na stručnim skupovima i konferencijama posvećenim urbanom zelenilu i održivom pejzažnom uređenju, kao i na temu&nbsp; „Proizvodnja drvorednih sadnica i kalemljenih lišćara i njihova primena“ u Inženjerskoj&nbsp; komori Srbije i u realizaciji publikacije Novi Sad –biodiverzitetski grad.</p><p>Član je Radne grupe za zaštitu životne sredine Grada Novog Sada.</p><p>Govori engleski jezik.</p><p>Majka je dvoje dece.</p>','','basic_html');
