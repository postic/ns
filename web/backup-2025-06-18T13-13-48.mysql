INSERT INTO `search_dataset` VALUES ('127','sr-Cyrl-RS','node_search',' културни центар новог сада културни центар новог сада admin wed 5282025 1200 културни центар новог сада некада трибина младих израстао је на традицији дугој преко педесет година и једна је од највећих и најзначајнијих културних институција интердисциплинарног и мултимедијалног карактера у новом саду и војводини наше поље деловања обухвата промовисање и креирање филмског сценског музичког ликовног стваралаштва књижевности друштвених и других трибина интердисциплинарних и мултимедијалних пројеката акција и манифестација уз то издајемо часопис за књижевност и теорију поља и организујемо четири престижна интернационална фестивала прозе фест фестивал прозе април инфант алтернативни и нови театар јун новосадски jazz фестивал новембар и еуроин европски и независни филм децембар своје програмске делатности реализујемо преко редакција филмска редакција креирајући и негујући филмски репертоар ова редакција посебно место даје презентовању стваралаштва аутора са естетски високом и ауторски индивидуалном свешћу ауторски филм незанемарујући бројне фестивале и филмске манифестације дани италијанског филма синеманија фестивали документарног и краткометражног ауторског еколошког филма такође посебну пажња обраћа на ширење филмске културе организовањем филмских трибина и некомерцијалних арт цинема програма као и кинофикације еуроин је аутентична филмска манифестација отворене форме која презентује савремени европски и независни светски филм без жанровских тематских или ограничења у уметничкој форми која наилази на велико интересовање како синеаста тако и љубитеља филма музичка редакција презентује музичко стваралаштво младих музичких стваралаца композитора инструменталиста оркестара и стваралаца који су у жижи интересовања домаћих и страних концертних сцена у области сериозне класичне јазз и блуз музике највећи број програма ове редакције нема комерцијални карактер новосадски јазз фестивал је високим стандардима својих садржаја главни концертни програм радионице изложбе видео инфо начина припреме и реализације високо рангиран на мапи европских јазз фестивала и већ је постао жељена дестинација најеминентнијих музичара из наше земље европе и света као и публике која све више пристиже и из других ближих и даљих градова сценска редакција бавећи се превасходно новим и алтернативним театром редакција сценског програма посебну пажњу поклања продукцији сценских пројеката и њиховом пласирању у србији у сарадњи са другим редакцијама посленицима и поклоницима театра пружа увид у савремене позоришне токове организујући радионице трибине објављујући публикације или представљајући угледне позоришне ствараоце инфант интернационални фестивал алтернативног и новог театра постао је тачка сусретања ставаралаца који позоришну уметност промишљају на другачији и нов начин ово је једини фестивал тога типа у земљи аутентичан и веома уважен у другим европским земљама међу уметницима и критичарима који прате најновије тенденције у области сценског стваралаштва програм ове редакције такође нема комерцијални карактер редакција часописа поља поред часописа за књижевност и теорију поља који се по оцени књижевне критике читалаца и самих књижевних стваралаца налази баш у самом врху књижевних часописа у нас ова редакција покреће и нове едиције па се избором тема и одабиром књижевних стваралаца и дела уписује у ред занимљивих и несвакидашњих издавача редакција говорног програма бавећи се организовањем књижевних трибина и промоција ова редакција има за циљ да књижевној публици представи савремена кретања у нашој књижевности презентујући дела најеминентнијих аутора дајући предност награђеним делима као и делима младих још неафирмисаних писаца у оквиру ове редакције промовишу се и публикације најразноврснијег садржаја све промоције иако високог естетског квалитета спадају у некомерцијалне редакција ликовних програма разнородним програмом и акцијама ова редакција настоји да промовише ауторе млађе и средње генер