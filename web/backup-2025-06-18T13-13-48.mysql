INSERT INTO `node_revision__body` VALUES ('article','0','50','484','en','0','<p>SONJA RADAKOVIĆ</p><p>Address: Trg slobode 1, Novi Sad, Serbia<br>Phone: +381 21 525 850, 425 802<br>e-mail: <a href="mailto:sonja.radakovic@novisad.rs">sonja.radakovic@novisad.rs</a></p>','','basic_html'),('article','0','50','484','sr-Cyrl-RS','0','<p>СОЊА РАДАКОВИЋ</p><p>Трг слободе 1, Нови Сад<br>Телефон: +381 21 525 850, 425 802<br>e-mail: <a href="mailto:sonja.radakovic@novisad.rs">sonja.radakovic@novisad.rs</a> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;&nbsp;</p><p>Рођена је 17. маја 1989. године у Добоју. Завршила je Oсновну школу ,,Душан Радовић“ у Новом Саду као одличан ђак, затим је матурирала као одличан ђак у Гимназији ,,22. октобар“ у Жабљу. На Правном факултету је дипломирала 2016. године. Уписала је мастер студије на Правном факултету за привреду и правосуђе 2018/2019 године, на смеру привредно право, које је завршила са просечном оценом 9,57. Одбранила је мастер рад на тему ,,Правни и институционални оквир Републике Србије у контексту пружања подршке особама са инвалидитетом“.</p><p>Од 2013. године запослена је у Електропривреди Србије, Јавном предузећу „Електровојводина“, односно „Електродистрибуција Србије" д.о.о. Београд.</p><p>Одборник је у Скупштини Града Новог Сада од 2014. године. У два мандата од 2012. до 2016. године и 2016. до 2020. године била је један од најмлађих одборника у Скупштини Града Новог Сада. Обављала је више важних функција кроз радна тела Скупштине Града међу којима су: члан Комисије за родну равноправност, заменик председника Савета за младе, председник Савета за особе са посебним потребама, заменик председника Савета за примену етичког кодекса, председник Савета за особе са инвалидитетом, заменик председника Комисије за прописе, члан Комисије за кадровска, административна и мандатно-имунитетна питања, председавајући Савета за особе са инвалидитетом у име Града Новог Сада, који је преузео званичну организацију и обележавање 3. децембра, Међународног дана особа са инвалидитетом.</p><p>Била је учесник више различитих конференција, округлих столова на тему положаја особа са инвалидитетом и бораца у Републици Србији.</p><p>2021. године, испред Града Новог Сада, је учествовала у реализацији пројекта „Успостављање међуопштинске сарадње у циљу сервисне подршке у мобилности и комуникацији“, који су реализовали Град Нови Сад, Град Београд и градске општине Савски венац и Врачар. Кроз наведени пројекат је обезбеђена опрема за све наведене општине и тим поводом уручен штампач на Брајевом писму Граду Новом Саду, који је грађанима доступан у Канцеларији за особе са инвалидитетом.</p><p>Кроз вођење Савета за особе са инвалидитетом осам година значајно су унапређени односи овог радног тела са удружењима и организацијама особа са инвалидитетом, те су подигнуте на виши ниво.</p><p>Активно се бави хуманитарним радом, посебно се истакла и ангажовала у доласку српске деце са Косова и Метохије у Нови Сад.</p><p>Добитник је многих захвалница у области социјалне заштите и хуманитарног рада.</p><p>Говори енглески језик. Удата је, мајка једног сина.</p>','','basic_html');
INSERT INTO `node_revision__body` VALUES ('article','0','50','484','sr-Latn-RS','0','<p>SONJA RADAKOVIĆ</p><p>Trg slobode 1, Novi Sad<br>Telefon: +381 21 525 850, 425 802<br>e-mail: <a href="mailto:sonja.radakovic@novisad.rs">sonja.radakovic@novisad.rs</a> &nbsp; &nbsp; &nbsp; &nbsp;</p><p>Rođena je 17. maja 1989. godine u Doboju. Završila je Osnovnu školu ,,Dušan Radović“ u Novom Sadu kao odličan đak, zatim je maturirala kao odličan đak u Gimnaziji ,,22. oktobar“ u Žablju. Na Pravnom fakultetu je diplomirala 2016. godine. Upisala je master studije na Pravnom fakultetu za privredu i pravosuđe 2018/2019 godine, na smeru privredno pravo, koje je završila sa prosečnom ocenom 9,57. Odbranila je master rad na temu ,,Pravni i institucionalni okvir Republike Srbije u kontekstu pružanja podrške osobama sa invaliditetom“.</p><p>Od 2013. godine zaposlena je u Elektroprivredi Srbije, Javnom preduzeću „Elektrovojvodina“, odnosno „Elektrodistribucija Srbije" d.о.о. Beograd.</p><p>Odbornik je u Skupštini Grada Novog Sada od 2014.godine. U dva mandata od 2012. do 2016. godine i 2016. do 2020. godine bila je jedan od najmlađih odbornika u Skupštini Grada Novog Sada. Obavljala je više važnih funkcija kroz radna tela Skupštine Grada među kojima su: član Komisije za rodnu ravnopravnost, zamenik predsednika Saveta za mlade, predsednik Saveta za osobe sa posebnim potrebama, zamenik predsednika Saveta za primenu etičkog kodeksa, predsednik Saveta za osobe sa invaliditetom, zamenik predsednika Komisije za propise, član Komisije za kadrovska, administrativna i mandatno-imunitetna pitanja, predsedavajući Saveta za osobe sa invaliditetom u ime Grada Novog Sada, koji je preuzeo zvaničnu organizaciju i obeležavanje 3. decembra, Međunarodnog dana osoba sa invaliditetom.</p><p>Bila je učesnik više različitih konferencija, okruglih stolova na temu položaja osoba sa invaliditetom i boraca u Republici Srbiji.</p><p>2021. godine, ispred Grada Novog Sada, je učestvovala u realizaciji projekta „Uspostavljanje međuopštinske saradnje u cilju servisne podrške u mobilnosti i komunikaciji“, koji su realizovali Grad Novi Sad, Grad Beograd i gradske opštine Savski venac i Vračar. Kroz navedeni projekat je obezbeđena oprema za sve navedene opštine i tim povodom uručen štampač na Brajevom pismu Gradu Novom Sadu, koji je građanima dostupan u Kancelariji za osobe sa invaliditetom.</p><p>Kroz vođenje Saveta za osobe sa invaliditetom osam godina značajno su unapređeni odnosi ovog radnog tela sa udruženjima i organizacijama osoba sa invaliditetom, te su podignute na viši nivo.</p><p>Aktivno se bavi humanitarnim radom, posebno se istakla i angažovala u dolasku srpske dece sa Kosova i Metohije u Novi Sad.</p><p>Dobitnik je mnogih zahvalnica u oblasti socijalne zaštite i humanitarnog rada.</p><p>Govori engleski jezik. Udata je, majka jednog sina.</p>','','basic_html');
INSERT INTO `node_revision__body` VALUES ('article','0','51','165','sr-Cyrl-RS','0','<p>ДЕЈАН МАНДИЋ</p><p>Члан Градског већа за буџет и финансије</p><p>Трг слободе 1, Нови Сад<br>Телефон: +381 21 525863<br>e-mail: <a href="mailto:dejan.mandic@novisad.rs">dejan.mandic@novisad.rs</a></p><p>Рођен&nbsp; је 4. јула 1970. године у Новом Саду.<br>Електротехничку школу „9. мај“&nbsp; завршио је у Бачкој Паланци и дипломирао на Економском факултету у Суботици, Универзитета у Новом Саду.</p><p>Од 2017. године до данас обављао је дужност начелника Градске управе за грађевинско земљиште и инвестиције Града Новог Сада. Био је директор ЈП „Завод за изградњу Града Новог Сада“,&nbsp; у периоду од 2015. до 2017. године.</p><p>У претходном периоду обављао је и функцију члана Градског већа Града Новог Сада задуженог за буџет и финансије (2012-2015).<br>Био је помоћник директора ЈКП „Тржница“, Нови Сад за финансијске и комерцијалне послове (2004-2012).</p><p>У Одсеку за сузбијање привредног криминалитета, Одељења криминалистичке полиције, ПУ Нови Сад&nbsp; био је оперативни радник&nbsp; у периоду од 2000. до 2004. године.</p><p>Говори енглески језик.</p><p>Ожењен је, отац једног детета.</p>','','basic_html'),('article','0','51','166','sr-Cyrl-RS','0','<p>ДЕЈАН МАНДИЋ</p><p>Члан Градског већа за буџет и финансије</p><p>Трг слободе 1, Нови Сад<br>Телефон: +381 21 525863<br>e-mail: <a href="mailto:dejan.mandic@novisad.rs">dejan.mandic@novisad.rs</a></p><p>Рођен&nbsp; је 4. јула 1970. године у Новом Саду.<br>Електротехничку школу „9. мај“&nbsp; завршио је у Бачкој Паланци и дипломирао на Економском факултету у Суботици, Универзитета у Новом Саду.</p><p>Од 2017. године до данас обављао је дужност начелника Градске управе за грађевинско земљиште и инвестиције Града Новог Сада. Био је директор ЈП „Завод за изградњу Града Новог Сада“,&nbsp; у периоду од 2015. до 2017. године.</p><p>У претходном периоду обављао је и функцију члана Градског већа Града Новог Сада задуженог за буџет и финансије (2012-2015).<br>Био је помоћник директора ЈКП „Тржница“, Нови Сад за финансијске и комерцијалне послове (2004-2012).</p><p>У Одсеку за сузбијање привредног криминалитета, Одељења криминалистичке полиције, ПУ Нови Сад&nbsp; био је оперативни радник&nbsp; у периоду од 2000. до 2004. године.</p><p>Говори енглески језик.</p><p>Ожењен је, отац једног детета.</p>','','basic_html');
INSERT INTO `node_revision__body` VALUES ('article','0','51','166','sr-Latn-RS','0','<p>DEJAN MANDIĆ</p><p>Član Gradskog veća za budžet i finansije</p><p>Trg slobode 1, Novi Sad<br>Telefon: +381 21 525 863<br>e-mail: <a href="mailto:dejan.mandic@novisad.rs">dejan.mandic@novisad.rs</a></p><p>Rođen&nbsp; je 4. jula 1970. godine u Novom Sadu.</p><p>Elektrotehničku školu „9. maj“&nbsp; završio je u Bačkoj Palanci i diplomirao na Ekonomskom fakultetu u Subotici, Univerziteta u Novom Sadu.<br>Od 2017. godine do danas obavljao je dužnost načelnika Gradske uprave za građevinsko zemljište i investicije Grada Novog Sada. Bio je direktor JP „Zavod za izgradnju Grada Novog Sada“,&nbsp; u periodu od 2015. do 2017. godine.</p><p>U prethodnom periodu obavljao je i funkciju člana Gradskog veća Grada Novog Sada zaduženog za budžet i finansije (2012-2015).<br>Bio je pomoćnik direktora JKP „Tržnica“, Novi Sad za finansijske i komercijalne poslove (2004-2012).</p><p>U Odseku za suzbijanje privrednog kriminaliteta, Odeljenja kriminalističke policije, PU Novi Sad&nbsp; bio je operativni radnik&nbsp; u periodu od 2000. do 2004. godine.</p><p>Govori engleski jezik.</p><p>Oženjen je, otac jednog deteta.</p>','','basic_html'),('article','0','51','167','en','0','<p>DEJAN MANDIĆ</p><p>Address: Trg slobode 1, Novi Sad, Serbia<br>Phone: +381 21 525 863, 021 525 747<br>e-mail: <a href="mailto:dejan.mandic@novisad.rs">dejan.mandic@novisad.rs</a></p>','','basic_html'),('article','0','51','167','sr-Cyrl-RS','0','<p>ДЕЈАН МАНДИЋ</p><p>Члан Градског већа за буџет и финансије</p><p>Трг слободе 1, Нови Сад<br>Телефон: +381 21 525863<br>e-mail: <a href="mailto:dejan.mandic@novisad.rs">dejan.mandic@novisad.rs</a></p><p>Рођен&nbsp; је 4. јула 1970. године у Новом Саду.<br>Електротехничку школу „9. мај“&nbsp; завршио је у Бачкој Паланци и дипломирао на Економском факултету у Суботици, Универзитета у Новом Саду.</p><p>Од 2017. године до данас обављао је дужност начелника Градске управе за грађевинско земљиште и инвестиције Града Новог Сада. Био је директор ЈП „Завод за изградњу Града Новог Сада“,&nbsp; у периоду од 2015. до 2017. године.</p><p>У претходном периоду обављао је и функцију члана Градског већа Града Новог Сада задуженог за буџет и финансије (2012-2015).<br>Био је помоћник директора ЈКП „Тржница“, Нови Сад за финансијске и комерцијалне послове (2004-2012).</p><p>У Одсеку за сузбијање привредног криминалитета, Одељења криминалистичке полиције, ПУ Нови Сад&nbsp; био је оперативни радник&nbsp; у периоду од 2000. до 2004. године.</p><p>Говори енглески језик.</p><p>Ожењен је, отац једног детета.</p>','','basic_html');
INSERT INTO `node_revision__body` VALUES ('article','0','51','167','sr-Latn-RS','0','<p>DEJAN MANDIĆ</p><p>Član Gradskog veća za budžet i finansije</p><p>Trg slobode 1, Novi Sad<br>Telefon: +381 21 525 863<br>e-mail: <a href="mailto:dejan.mandic@novisad.rs">dejan.mandic@novisad.rs</a></p><p>Rođen&nbsp; je 4. jula 1970. godine u Novom Sadu.</p><p>Elektrotehničku školu „9. maj“&nbsp; završio je u Bačkoj Palanci i diplomirao na Ekonomskom fakultetu u Subotici, Univerziteta u Novom Sadu.<br>Od 2017. godine do danas obavljao je dužnost načelnika Gradske uprave za građevinsko zemljište i investicije Grada Novog Sada. Bio je direktor JP „Zavod za izgradnju Grada Novog Sada“,&nbsp; u periodu od 2015. do 2017. godine.</p><p>U prethodnom periodu obavljao je i funkciju člana Gradskog veća Grada Novog Sada zaduženog za budžet i finansije (2012-2015).<br>Bio je pomoćnik direktora JKP „Tržnica“, Novi Sad za finansijske i komercijalne poslove (2004-2012).</p><p>U Odseku za suzbijanje privrednog kriminaliteta, Odeljenja kriminalističke policije, PU Novi Sad&nbsp; bio je operativni radnik&nbsp; u periodu od 2000. do 2004. godine.</p><p>Govori engleski jezik.</p><p>Oženjen je, otac jednog deteta.</p>','','basic_html'),('article','0','51','456','en','0','<p>DEJAN MANDIĆ</p><p>Address: Trg slobode 1, Novi Sad, Serbia<br>Phone: +381 21 525 863, 021 525 747<br>e-mail: <a href="mailto:dejan.mandic@novisad.rs">dejan.mandic@novisad.rs</a></p>','','basic_html'),('article','0','51','456','sr-Cyrl-RS','0','<p>ДЕЈАН МАНДИЋ</p><p>Члан Градског већа за буџет и финансије</p><p>Трг слободе 1, Нови Сад<br>Телефон: +381 21 525863<br>e-mail: <a href="mailto:dejan.mandic@novisad.rs">dejan.mandic@novisad.rs</a></p><p>Рођен&nbsp; је 4. јула 1970. године у Новом Саду.<br>Електротехничку школу „9. мај“&nbsp; завршио је у Бачкој Паланци и дипломирао на Економском факултету у Суботици, Универзитета у Новом Саду.</p><p>Од 2017. године до данас обављао је дужност начелника Градске управе за грађевинско земљиште и инвестиције Града Новог Сада. Био је директор ЈП „Завод за изградњу Града Новог Сада“,&nbsp; у периоду од 2015. до 2017. године.</p><p>У претходном периоду обављао је и функцију члана Градског већа Града Новог Сада задуженог за буџет и финансије (2012-2015).<br>Био је помоћник директора ЈКП „Тржница“, Нови Сад за финансијске и комерцијалне послове (2004-2012).</p><p>У Одсеку за сузбијање привредног криминалитета, Одељења криминалистичке полиције, ПУ Нови Сад&nbsp; био је оперативни радник&nbsp; у периоду од 2000. до 2004. године.</p><p>Говори енглески језик.</p><p>Ожењен је, отац једног детета.</p>','','basic_html');
INSERT INTO `node_revision__body` VALUES ('article','0','51','456','sr-Latn-RS','0','<p>DEJAN MANDIĆ</p><p>Član Gradskog veća za budžet i finansije</p><p>Trg slobode 1, Novi Sad<br>Telefon: +381 21 525 863<br>e-mail: <a href="mailto:dejan.mandic@novisad.rs">dejan.mandic@novisad.rs</a></p><p>Rođen&nbsp; je 4. jula 1970. godine u Novom Sadu.</p><p>Elektrotehničku školu „9. maj“&nbsp; završio je u Bačkoj Palanci i diplomirao na Ekonomskom fakultetu u Subotici, Univerziteta u Novom Sadu.<br>Od 2017. godine do danas obavljao je dužnost načelnika Gradske uprave za građevinsko zemljište i investicije Grada Novog Sada. Bio je direktor JP „Zavod za izgradnju Grada Novog Sada“,&nbsp; u periodu od 2015. do 2017. godine.</p><p>U prethodnom periodu obavljao je i funkciju člana Gradskog veća Grada Novog Sada zaduženog za budžet i finansije (2012-2015).<br>Bio je pomoćnik direktora JKP „Tržnica“, Novi Sad za finansijske i komercijalne poslove (2004-2012).</p><p>U Odseku za suzbijanje privrednog kriminaliteta, Odeljenja kriminalističke policije, PU Novi Sad&nbsp; bio je operativni radnik&nbsp; u periodu od 2000. do 2004. godine.</p><p>Govori engleski jezik.</p><p>Oženjen je, otac jednog deteta.</p>','','basic_html'),('article','0','51','470','en','0','<p>DEJAN MANDIĆ</p><p>Address: Trg slobode 1, Novi Sad, Serbia<br>Phone: +381 21 525 863, 021 525 747<br>e-mail: <a href="mailto:dejan.mandic@novisad.rs">dejan.mandic@novisad.rs</a></p>','','basic_html'),('article','0','51','470','sr-Cyrl-RS','0','<p>ДЕЈАН МАНДИЋ</p><p>Члан Градског већа за буџет и финансије</p><p>Трг слободе 1, Нови Сад<br>Телефон: +381 21 525863<br>e-mail: <a href="mailto:dejan.mandic@novisad.rs">dejan.mandic@novisad.rs</a></p><p>Рођен&nbsp; је 4. јула 1970. године у Новом Саду.<br>Електротехничку школу „9. мај“&nbsp; завршио је у Бачкој Паланци и дипломирао на Економском факултету у Суботици, Универзитета у Новом Саду.</p><p>Од 2017. године до данас обављао је дужност начелника Градске управе за грађевинско земљиште и инвестиције Града Новог Сада. Био је директор ЈП „Завод за изградњу Града Новог Сада“,&nbsp; у периоду од 2015. до 2017. године.</p><p>У претходном периоду обављао је и функцију члана Градског већа Града Новог Сада задуженог за буџет и финансије (2012-2015).<br>Био је помоћник директора ЈКП „Тржница“, Нови Сад за финансијске и комерцијалне послове (2004-2012).</p><p>У Одсеку за сузбијање привредног криминалитета, Одељења криминалистичке полиције, ПУ Нови Сад&nbsp; био је оперативни радник&nbsp; у периоду од 2000. до 2004. године.</p><p>Говори енглески језик.</p><p>Ожењен је, отац једног детета.</p>','','basic_html');
