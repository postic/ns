INSERT INTO `node_revision__body` VALUES ('page','0','144','425','sr-Latn-RS','0','<p>Mesne zajednice, predsednici saveta mesnih zajednica, adrese i telefoni:</p><p>01. „Žitni trg“ Radojka Jokanić Novi Sad, Dimitrija Avramovića 8 452-029<br>02. „Stari grad“ Kristina Žarić Novi Sad, Kralja Aleksandra 1 451-526<br>03. „I vojvođanska brigada“ Sandra Žepinić Novi Sad, Vojvođanskih brigada 17 452-029<br>04. „Sonja Marinković“ Lazar Pavlović Novi Sad, Kej žrtava racije 4 457-538<br>05. „Liman“ Nataša Matijević Novi Sad, Drage Spasić 1 455-098<br>06. „Boško Buha“ Branislav Jovović Novi Sad, Fruškogorska 8 450-820<br>07. „Liman III“ Hana Ljiljak Novi Sad, Narodnog fronta 46 6365-280<br>08. „Ostrvo“ Dušan Penezić Novi Sad, Narodnog fronta 71 466-430<br>09. „Ivo Andrić“ Aleksandra Tadijin Novi Sad, Banović Strahinje 20 6364-199<br>10. „Vera Pavlović“ Vojislav Joksović Novi Sad, Gogoljeva 1 543-119<br>11. „7. juli“ Zora Purić Novi Sad,<br>Cara Dušana 27 6364-263<br>12. „Južni Telep“ Dragan Kosovac Novi Sad, Janošikova 1a 505-646<br>13. „Bratstvo Telep“ Aleksandar Ilić Novi Sad, Ilariona Ruvarca 18/a 6394-242<br>14. „Nikola Tesla – Telep“ Marija Pajović Novi Sad, Geri Karolja 5 6394-296<br>15. „Gavrilo Princip“ Jovan Dragić Novi Sad, Bul. Jovana Dučića 3 400-915<br>16. „Bistrica“ Vukašin Milović Novi Sad, Braće Dronjak 11 402-484<br>17. „Adice“ Vasilija Bojić Novi Sad, Sime Šolaje 2a 6506-755<br>18. „Jugovićevo“ Đuro Šušnjar Novi Sad, Tarasa Ševčenka 1 512-310<br>19. „Radnički“ Jovan Vojnović Novi Sad, Braće Mogin 2 512-190<br>20. „Detelinara“ Radojica Graovac Novi Sad, Braće Popović 4 512-359</p><p>Napomena: Mesna zajednica „Prva vojvođanska brigada “&nbsp; je&nbsp; izmeštena iz objekta i privremeno je na adresi&nbsp; Mesne&nbsp; zajednice „ Žitni trg “, Mesna zajednica&nbsp; „7. juli“ je preseljena na novu adresu, Cara Dušana 27.</p><p>21. „Narodni heroji“ Ranka Malešević Novi Sad, Majevička 2b 6613-336<br>22. „Omladinski pokret“ Čedo Gromilić Novi Sad,Omladinskog pokreta 11 444-826<br>23. „Sava Kovačević“ Vanja Momčilović Novi Sad, Save Kovačevića 15 444-980<br>24. „Dunav“ Milan Ilić Novi Sad, Beogradski kej 19a 525-486<br>25. „Podbara“ Srba Jankov Novi Sad, Kosovska 41 529-727<br>26. „Slana bara“ Nenad Erdeljan Novi Sad, Čenejska 54 6413-564<br>27. „Klisa“ Dragan Hemon Novi Sad, Savska 27 6414-453<br>28. „Vidovdansko naselje“ Drago Stojičić Novi Sad, Dr Jovana Andrejevića 2a 6414-723<br>29. „Salajka“ Maja Matić Novi Sad, Šajkaška 26 446-010<br>30. „Šangaj“ Saša Kitanović Novi Sad, Ulica VIII br. 8 6520-152<br>31. „Sajlovo“ Dejan Latinović Gornje Sajlovo 37<br>452-558<br>32. „Petrovaradin“ Dražen Malobabić Petrovaradin, Čajkovskog 1a 6433-000<br>33. „Sremska Kamenica“ Donald Božić Sremska Kamenica, Marka Oreškovića 1a 462-984<br>34. „Bukovac“ Zoran Sladojević Bukovac, Karađorđeva 76 826-022<br>35. „Ledinci“ Strahinja Stanković Ledinci, Zmaj Jovina 19 2986-007<br>36. „Stari Ledinci“ Tijana Marjanović Stari Ledinci, Vuka Karadžića 98 2986-140<br>37. „Kać“ Ostoja Drinić Kać, Kralja Petra I&nbsp; 2 6213-034</p><p>38. „Budisava“ Jasna Daničić Budisava, Vojvođanska 104 719-235<br>39. „Kovilj“ Sanja Samočeta Kovilj, Laze Kostića 70 2988-005</p><p>40. „Rumenka“ Momir Mišković Rumenka,<br>Vojvođanska 19 6216-07<br>41. „Kisač“ Jan Vozar Kisač, Slovačka 10 827-063</p><p>Napomena: Mesna zajednica i Mesna kancelarija „Čenej “&nbsp; je, zbog radova u objektu,&nbsp; izmeštena iz objekta i privremeno je na adresi&nbsp; Mesne&nbsp; zajednice „ Pejićevi salaši - Nemanovci“.&nbsp;</p><p>42. „Stepanovićevo“ Mlađan Biga Vojvode Stepe Stepanovića 112 717-054<br>43. „Veternik“ Jasmina Rakić Veternik, Ive Lole Ribara 1a 821-050, 821-015<br>44. „Futog“ Zoran Crepulja Futog, Cara Lazara 42 895-077<br>45. „Begeč“ Milan Tatić Begeč, Kralja Petra I&nbsp; 31 29 98-021<br>46. „Čenej“ Miloš Vilotijević Čenej, Vuka Karadžića 289 714-012<br>47. „Pejićevi salaši – Nemanovci“ Zoran Podunavac Čenej, Pejićevi salaši 33 6414-121</p>','','basic_html');
