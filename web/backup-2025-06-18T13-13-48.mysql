DROP TABLE IF EXISTS `queue`;
CREATE TABLE `queue` (   `item_id` int(10) unsigned NOT NULL AUTO_INCREMENT COMMENT 'Primary Key: Unique item ID.',   `name` varchar(255) CHARACTER SET ascii COLLATE ascii_general_ci NOT NULL DEFAULT '' COMMENT 'The queue name.',   `data` longblob DEFAULT NULL COMMENT 'The arbitrary data for the item.',   `expire` bigint(20) NOT NULL DEFAULT 0 COMMENT 'Timestamp when the claim lease expires on the item.',   `created` bigint(20) NOT NULL DEFAULT 0 COMMENT 'Timestamp when the item was created.',   PRIMARY KEY (`item_id`),   KEY `name_created` (`name`,`created`),   KEY `expire` (`expire`) ) ENGINE=InnoDB AUTO_INCREMENT=756 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci COMMENT='Stores items in queues.' AUTO_INCREMENT=756;
DROP TABLE IF EXISTS `router`;
CREATE TABLE `router` (   `name` varchar(255) CHARACTER SET ascii COLLATE ascii_general_ci NOT NULL DEFAULT '' COMMENT 'Primary Key: Machine name of this route',   `path` varchar(255) NOT NULL DEFAULT '' COMMENT 'The path for this URI',   `pattern_outline` varchar(255) NOT NULL DEFAULT '' COMMENT 'The pattern',   `fit` int(11) NOT NULL DEFAULT 0 COMMENT 'A numeric representation of how specific the path is.',   `route` longblob DEFAULT NULL COMMENT 'A serialized Route object',   `number_parts` smallint(6) NOT NULL DEFAULT 0 COMMENT 'Number of parts in this router path.',   PRIMARY KEY (`name`),   KEY `pattern_outline_parts` (`pattern_outline`(191),`number_parts`) ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci COMMENT='Maps paths to various callbacks (access, page and title)';
