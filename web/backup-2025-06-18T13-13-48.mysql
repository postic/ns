INSERT INTO `search_dataset` VALUES ('129','sr-Latn-RS','node_search',' kc kisac  kc kisac admin wed 5282025 1241 kc kisac osnovan je 24 decembra 1987 godine u okviru kc kisac aktivne su sledece sekcije folklorna koja okuplja amatere u sledecim folklornim grupama decji folklorni ansambli krocik ml krocik st slniecko umetnicki rukovodilac marija piksijades deciji folklorni ansambl vienok umetnicki rukovodilac vladimir medved izvodacki folklorni ansambl vreteno umetnicki rukovodilac vladimir medved cetiri pevacke grupe decja devojacka zenska i muska umetnicki rukovodilac miloslav kardelis solo pevaci pozorisna okuplja amatere u tri pozorisne scene lutkarska decja i dramska umetnicki rukovodilac jan privizer muzicka radionica skola solfeda profesor ivana sretenovic i skola gitare profesor marko srdevic ove sekcije okupljaju oko 300 amatera raznih uzrasta od predskolaca do penzionera radio kisac prva lokalna radio stanica u vojvodini emitovanje svakodnevnog programa na fm 1038 mhz na slovackom i srpskom jeziku angazovan je urednik dnevnog programa i deset honorarnih saradnika u kcu je cetvoro zaposlenih direktor sekretar organizator urednik dnevnog programa radio kisac najznacajnije manifestacije koje kc kisac organizuje su decji folklorni festival zlata brana festival folklornog i muzickog stvaralastva dece slovacke nacionalne manjine koja zivi u vojvodini ciji je cilj druzenje dece posredstvom pesme i igre razmena iskustava strucnjaka i pedagoga podsticanje sakupljacke delatnosti zajednicka analiza i ocena fetsivala kao i strucno usmeravanje pocetnika putem seminara i predavanja kysacsky spevnik takmicenje pevaca u izvornim slovackim pesmama festival zuzane kardelis ucestvuju pozorisni ansambli sa predstavama u kojima je obradena tema zena i novogodisnja estrada prezentacija godisnje aktivnosti svih sekcija kc kisac kc kisac organizuje kulturnoumetnicke programe pozorisne predstave knjizevne veceri estradne manifestacije izlozbe akademskih i naivnih slikara u okviru z