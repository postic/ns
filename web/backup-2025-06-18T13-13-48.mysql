INSERT INTO `node_revision__body` VALUES ('article','0','43','468','sr-Latn-RS','0','<p>MILORAD RADOJEVIĆ<br>Član Gradskog veća za privredu</p><p>Trg slobode 1, Novi Sad<br>Telefon: +381 21 421 110<br>Faks: +381 21 526 732<br>e-mail: <a href="mailto:milorad.radojevic@novisad.rs">milorad.radojevic@novisad.rs</a></p><p>Rođen 6. januara 1976. godine u Vrbasu, završio Gimnaziju u Vrbasu, a zatim poljoprivredni fakultet (agroekonomski smer) u Novom Sadu.<br>Od 2006. godine zaposlen u Regionalnoj privrednoj komori Novi Sad, prvo na pozicijama stručnog saradnika u Centru za poljoprivredu i Centru za marketing, informisanje i sajmove, a od 2012. godine na poziciji direktora Komore.</p><p>Od 2016. godine član Gradskog veća za privredu.</p><p>Učestvovao na velikom broju projekata koji se finansiraju iz fondova EU.</p><p>Služi se engleskim jezikom.</p><p>Oženjen, otac troje dece.</p>','','basic_html'),('article','0','43','477','en','0','<p>MILORAD RADOJEVIĆ</p><p>Member of the City Council in charge of Economy</p><p>Addrеss: Тrg slоbоdе 1, 21 000 Nоvi Sаd, Serbia<br>Phone: + 381 21 421 110<br>Fаx: +381 21 526 732<br>e-mail: <a href="mailto:milorad.radojevic@novisad.rs">milorad.radojevic@novisad.rs</a></p>','','basic_html'),('article','0','43','477','sr-Cyrl-RS','0','<p>МИЛОРАД РАДОЈЕВИЋ<br>Члан Градског већа за привреду</p><p>Трг слободе 1, Нови Сад<br>Телефон: +381 21 421 110<br>Факс: +381 21 526 732<br>e-mail: <a href="mailto:milorad.radojevic@novisad.rs">milorad.radojevic@novisad.rs</a></p><p>Рођен 6. јануара 1976. године у Врбасу, завршио Гимназију у Врбасу, а затим пољопривредни факултет (агроекономски смер) у Новом Саду.<br>Од 2006. године запослен у Регионалној привредној комори Нови Сад, прво на позицијама стручног сарадника у Центру за пољопривреду и Центру за маркетинг, информисање и сајмове, а од 2012. године на позицији директора Коморе.</p><p>Од 2016. године члан Градског већа за привреду.</p><p>Учествовао на великом броју пројеката који се финансирају из фондова ЕУ.</p><p>Служи се енглеским језиком.</p><p>Ожењен, отац троје деце.</p>','','basic_html');
INSERT INTO `node_revision__body` VALUES ('article','0','43','477','sr-Latn-RS','0','<p>MILORAD RADOJEVIĆ<br>Član Gradskog veća za privredu</p><p>Trg slobode 1, Novi Sad<br>Telefon: +381 21 421 110<br>Faks: +381 21 526 732<br>e-mail: <a href="mailto:milorad.radojevic@novisad.rs">milorad.radojevic@novisad.rs</a></p><p>Rođen 6. januara 1976. godine u Vrbasu, završio Gimnaziju u Vrbasu, a zatim poljoprivredni fakultet (agroekonomski smer) u Novom Sadu.<br>Od 2006. godine zaposlen u Regionalnoj privrednoj komori Novi Sad, prvo na pozicijama stručnog saradnika u Centru za poljoprivredu i Centru za marketing, informisanje i sajmove, a od 2012. godine na poziciji direktora Komore.</p><p>Od 2016. godine član Gradskog veća za privredu.</p><p>Učestvovao na velikom broju projekata koji se finansiraju iz fondova EU.</p><p>Služi se engleskim jezikom.</p><p>Oženjen, otac troje dece.</p>','','basic_html'),('article','0','43','478','en','0','<p>MILORAD RADOJEVIĆ</p><p>Member of the City Council in charge of Economy</p><p>Addrеss: Тrg slоbоdе 1, 21 000 Nоvi Sаd, Serbia<br>Phone: + 381 21 421 110<br>Fаx: +381 21 526 732<br>e-mail: <a href="mailto:milorad.radojevic@novisad.rs">milorad.radojevic@novisad.rs</a></p>','','basic_html'),('article','0','43','478','sr-Cyrl-RS','0','<p>МИЛОРАД РАДОЈЕВИЋ<br>Члан Градског већа за привреду</p><p>Трг слободе 1, Нови Сад<br>Телефон: +381 21 421 110<br>Факс: +381 21 526 732<br>e-mail: <a href="mailto:milorad.radojevic@novisad.rs">milorad.radojevic@novisad.rs</a></p><p>Рођен 6. јануара 1976. године у Врбасу, завршио Гимназију у Врбасу, а затим пољопривредни факултет (агроекономски смер) у Новом Саду.<br>Од 2006. године запослен у Регионалној привредној комори Нови Сад, прво на позицијама стручног сарадника у Центру за пољопривреду и Центру за маркетинг, информисање и сајмове, а од 2012. године на позицији директора Коморе.</p><p>Од 2016. године члан Градског већа за привреду.</p><p>Учествовао на великом броју пројеката који се финансирају из фондова ЕУ.</p><p>Служи се енглеским језиком.</p><p>Ожењен, отац троје деце.</p>','','basic_html');
INSERT INTO `node_revision__body` VALUES ('article','0','43','478','sr-Latn-RS','0','<p>MILORAD RADOJEVIĆ<br>Član Gradskog veća za privredu</p><p>Trg slobode 1, Novi Sad<br>Telefon: +381 21 421 110<br>Faks: +381 21 526 732<br>e-mail: <a href="mailto:milorad.radojevic@novisad.rs">milorad.radojevic@novisad.rs</a></p><p>Rođen 6. januara 1976. godine u Vrbasu, završio Gimnaziju u Vrbasu, a zatim poljoprivredni fakultet (agroekonomski smer) u Novom Sadu.<br>Od 2006. godine zaposlen u Regionalnoj privrednoj komori Novi Sad, prvo na pozicijama stručnog saradnika u Centru za poljoprivredu i Centru za marketing, informisanje i sajmove, a od 2012. godine na poziciji direktora Komore.</p><p>Od 2016. godine član Gradskog veća za privredu.</p><p>Učestvovao na velikom broju projekata koji se finansiraju iz fondova EU.</p><p>Služi se engleskim jezikom.</p><p>Oženjen, otac troje dece.</p>','','basic_html'),('article','0','44','118','en','0','<p>МИЛОВАН АМИЏИЋ</p><p>Члан Градског већа за управу и прописе</p><p>Трг слободе 1, Нови Сад<br>Телефон: +381 21 525 850, 425 802</p><p>e-mail:&nbsp; <a href="mailto:milovan.amidzic@novisad.rs">milovan.amidzic@novisad.rs</a></p><p>Рођен је 28. новембра 1981. године у Јајцу. Завршио је Основну школу „Ђура Јакшић“ у Каћу, затим Гимназију „Светозар Марковић“ у Новом Саду. Дипломирао је на Правном факултету у Новом Саду 2008. године на смеру унутрашњих послова, а 2011. године на Правном факултету у Новом Саду, одбранио је мастер рад на тему „Уговори о кредиту са наменом“ из предмета банкарско право.</p><p>У претходном периоду, био је запослен у предузећу „Агрокоп” а.д. Нови Сад (2008-2010), као самостални стручни сарадник за опште и правне послове, а у предузећу „Фертил” доо Бачка Паланка био је руководилац Службе општих и правних послова (2010-2012).</p><p>У периоду од 2012. до 2016. године био је в.д. заменика начелника у Градској управи за опште и правне послове Града Новог Сада. Такође, био је и председник Надзорног одбора ЈКП „Зоохигијена и ветерина“ Нови Сад (2014-2015).</p><p>Дужност шефа Службе за заједничке послове Града Новог Сада&nbsp; врши у периоду од 2016. до 2017. године. В.д. директора ЈКП „Стан“ Нови Сад у периоду од 2017. до 2018, а в.д. директора ЈГСП „Нови Сад“ у периоду од 2018. до 2019. године.&nbsp;Директор ЈГСП „Нови Сад“ је у периоду од 2019. до 2020. године.</p><p>У периоду од 2020. до 2024. године именован је за члана Градског већа за управу, прописе и урбанизам.</p><p>У претходном мандату обаваљао је функцију члана Градског већа за управу, прописе, имовину и имовинско-правне послове, урбанизам и стамбене послове.</p><p>Ово му је трећи мандат на месту члана Градског већа Града Новог Сада.</p><p>Има положен државни стручни испит за рад у органима државне управе.</p><p>Политичко опредељење – Српска напредна странка.</p><p>Ожењен, отац&nbsp; двоје деце.</p>','','basic_html');
INSERT INTO `node_revision__body` VALUES ('article','0','44','136','sr-Cyrl-RS','0','<p>МИЛОВАН АМИЏИЋ</p><p>Члан Градског већа за управу и прописе</p><p>Трг слободе 1, Нови Сад<br>Телефон: +381 21 525 850, 425 802</p><p>e-mail:&nbsp; <a href="mailto:milovan.amidzic@novisad.rs">milovan.amidzic@novisad.rs</a></p><p>Рођен је 28. новембра 1981. године у Јајцу. Завршио је Основну школу „Ђура Јакшић“ у Каћу, затим Гимназију „Светозар Марковић“ у Новом Саду. Дипломирао је на Правном факултету у Новом Саду 2008. године на смеру унутрашњих послова, а 2011. године на Правном факултету у Новом Саду, одбранио је мастер рад на тему „Уговори о кредиту са наменом“ из предмета банкарско право.</p><p>У претходном периоду, био је запослен у предузећу „Агрокоп” а.д. Нови Сад (2008-2010), као самостални стручни сарадник за опште и правне послове, а у предузећу „Фертил” доо Бачка Паланка био је руководилац Службе општих и правних послова (2010-2012).</p><p>У периоду од 2012. до 2016. године био је в.д. заменика начелника у Градској управи за опште и правне послове Града Новог Сада. Такође, био је и председник Надзорног одбора ЈКП „Зоохигијена и ветерина“ Нови Сад (2014-2015).</p><p>Дужност шефа Службе за заједничке послове Града Новог Сада&nbsp; врши у периоду од 2016. до 2017. године. В.д. директора ЈКП „Стан“ Нови Сад у периоду од 2017. до 2018, а в.д. директора ЈГСП „Нови Сад“ у периоду од 2018. до 2019. године.&nbsp;Директор ЈГСП „Нови Сад“ је у периоду од 2019. до 2020. године.</p><p>У периоду од 2020. до 2024. године именован је за члана Градског већа за управу, прописе и урбанизам.</p><p>У претходном мандату обаваљао је функцију члана Градског већа за управу, прописе, имовину и имовинско-правне послове, урбанизам и стамбене послове.</p><p>Ово му је трећи мандат на месту члана Градског већа Града Новог Сада.</p><p>Има положен државни стручни испит за рад у органима државне управе.</p><p>Политичко опредељење – Српска напредна странка.</p><p>Ожењен, отац&nbsp; двоје деце.</p>','','basic_html');
INSERT INTO `node_revision__body` VALUES ('article','0','44','147','sr-Cyrl-RS','0','<p>МИЛОВАН АМИЏИЋ</p><p>Члан Градског већа за управу и прописе</p><p>Трг слободе 1, Нови Сад<br>Телефон: +381 21 525 850, 425 802</p><p>e-mail:&nbsp; <a href="mailto:milovan.amidzic@novisad.rs">milovan.amidzic@novisad.rs</a></p><p>Рођен је 28. новембра 1981. године у Јајцу. Завршио је Основну школу „Ђура Јакшић“ у Каћу, затим Гимназију „Светозар Марковић“ у Новом Саду. Дипломирао је на Правном факултету у Новом Саду 2008. године на смеру унутрашњих послова, а 2011. године на Правном факултету у Новом Саду, одбранио је мастер рад на тему „Уговори о кредиту са наменом“ из предмета банкарско право.</p><p>У претходном периоду, био је запослен у предузећу „Агрокоп” а.д. Нови Сад (2008-2010), као самостални стручни сарадник за опште и правне послове, а у предузећу „Фертил” доо Бачка Паланка био је руководилац Службе општих и правних послова (2010-2012).</p><p>У периоду од 2012. до 2016. године био је в.д. заменика начелника у Градској управи за опште и правне послове Града Новог Сада. Такође, био је и председник Надзорног одбора ЈКП „Зоохигијена и ветерина“ Нови Сад (2014-2015).</p><p>Дужност шефа Службе за заједничке послове Града Новог Сада&nbsp; врши у периоду од 2016. до 2017. године. В.д. директора ЈКП „Стан“ Нови Сад у периоду од 2017. до 2018, а в.д. директора ЈГСП „Нови Сад“ у периоду од 2018. до 2019. године.&nbsp;Директор ЈГСП „Нови Сад“ је у периоду од 2019. до 2020. године.</p><p>У периоду од 2020. до 2024. године именован је за члана Градског већа за управу, прописе и урбанизам.</p><p>У претходном мандату обаваљао је функцију члана Градског већа за управу, прописе, имовину и имовинско-правне послове, урбанизам и стамбене послове.</p><p>Ово му је трећи мандат на месту члана Градског већа Града Новог Сада.</p><p>Има положен државни стручни испит за рад у органима државне управе.</p><p>Политичко опредељење – Српска напредна странка.</p><p>Ожењен, отац&nbsp; двоје деце.</p>','','basic_html');
INSERT INTO `node_revision__body` VALUES ('article','0','44','147','sr-Latn-RS','0','<p>MILOVAN AMIDžIĆ</p><p>Član Gradskog veća za upravu i propise</p><p>Trg slobode 1, Novi Sad<br>Telefon: +381 21 525 850, 425 802</p><p>e-mail:&nbsp; <a href="mailto:milovan.amidzic@novisad.rs">milovan.amidzic@novisad.rs</a></p><p>Rođen je 28. novembra 1981. godine u Jajcu. Završio je Osnovnu školu „Đura Jakšić“ u Kaću, zatim Gimnaziju „Svetozar Marković“ u Novom Sadu. Diplomirao je na Pravnom fakultetu u Novom Sadu 2008. godine na smeru unutrašnjih poslova, a 2011. godine na Pravnom fakultetu u Novom Sadu, odbranio je master rad na temu „Ugovori o kreditu sa namenom“ iz predmeta bankarsko pravo.</p><p>U prethodnom periodu, bio je zaposlen u preduzeću „Agrokop” a.d. Novi Sad (2008-2010), kao samostalni stručni saradnik za opšte i pravne poslove, a u preduzeću „Fertil” doo Bačka Palanka bio je rukovodilac Službe opštih i pravnih poslova (2010-2012).</p><p>U periodu od 2012. do 2016. godine bio je v.d. zamenika načelnika u Gradskoj upravi za opšte i pravne poslove Grada Novog Sada. Takođe, bio je i predsednik Nadzornog odbora JKP „Zoohigijena i veterina“ Novi Sad (2014-2015).</p><p>Dužnost šefa Službe za zajedničke poslove Grada Novog Sada&nbsp; vrši u periodu od 2016. do 2017. godine. V.d. direktora JKP „Stan“ Novi Sad u periodu od 2017. do 2018, a v.d. direktora JGSP „Novi Sad“ u periodu od 2018. do 2019. godine.&nbsp;Direktor JGSP „Novi Sad“ je u periodu od 2019. do 2020. godine.</p><p>U periodu od 2020. do 2024. godine imenovan je za člana Gradskog veća za upravu, propise i urbanizam.</p><p>U prethodnom mandatu obavaljao je funkciju člana Gradskog veća za upravu, propise, imovinu i imovinsko-pravne poslove, urbanizam i stambene poslove.</p><p>Ovo mu je treći mandat na mestu člana Gradskog veća Grada Novog Sada.</p><p>Ima položen državni stručni ispit za rad u organima državne uprave.</p><p>Političko opredeljenje – Srpska napredna stranka.</p><p>Oženjen, otac&nbsp; dvoje dece.</p>','','basic_html');
INSERT INTO `node_revision__body` VALUES ('article','0','44','148','en','0','<p>МИЛОВАН АМИЏИЋ</p><p>Члан Градског већа за управу и прописе</p><p>Трг слободе 1, Нови Сад<br>Телефон: +381 21 525 850, 425 802</p><p>e-mail:&nbsp; <a href="mailto:milovan.amidzic@novisad.rs">milovan.amidzic@novisad.rs</a></p><p>Рођен је 28. новембра 1981. године у Јајцу. Завршио је Основну школу „Ђура Јакшић“ у Каћу, затим Гимназију „Светозар Марковић“ у Новом Саду. Дипломирао је на Правном факултету у Новом Саду 2008. године на смеру унутрашњих послова, а 2011. године на Правном факултету у Новом Саду, одбранио је мастер рад на тему „Уговори о кредиту са наменом“ из предмета банкарско право.</p><p>У претходном периоду, био је запослен у предузећу „Агрокоп” а.д. Нови Сад (2008-2010), као самостални стручни сарадник за опште и правне послове, а у предузећу „Фертил” доо Бачка Паланка био је руководилац Службе општих и правних послова (2010-2012).</p><p>У периоду од 2012. до 2016. године био је в.д. заменика начелника у Градској управи за опште и правне послове Града Новог Сада. Такође, био је и председник Надзорног одбора ЈКП „Зоохигијена и ветерина“ Нови Сад (2014-2015).</p><p>Дужност шефа Службе за заједничке послове Града Новог Сада&nbsp; врши у периоду од 2016. до 2017. године. В.д. директора ЈКП „Стан“ Нови Сад у периоду од 2017. до 2018, а в.д. директора ЈГСП „Нови Сад“ у периоду од 2018. до 2019. године.&nbsp;Директор ЈГСП „Нови Сад“ је у периоду од 2019. до 2020. године.</p><p>У периоду од 2020. до 2024. године именован је за члана Градског већа за управу, прописе и урбанизам.</p><p>У претходном мандату обаваљао је функцију члана Градског већа за управу, прописе, имовину и имовинско-правне послове, урбанизам и стамбене послове.</p><p>Ово му је трећи мандат на месту члана Градског већа Града Новог Сада.</p><p>Има положен државни стручни испит за рад у органима државне управе.</p><p>Политичко опредељење – Српска напредна странка.</p><p>Ожењен, отац&nbsp; двоје деце.</p>','','basic_html');
INSERT INTO `node_revision__body` VALUES ('article','0','44','148','sr-Cyrl-RS','0','<p>МИЛОВАН АМИЏИЋ</p><p>Члан Градског већа за управу и прописе</p><p>Трг слободе 1, Нови Сад<br>Телефон: +381 21 525 850, 425 802</p><p>e-mail:&nbsp; <a href="mailto:milovan.amidzic@novisad.rs">milovan.amidzic@novisad.rs</a></p><p>Рођен је 28. новембра 1981. године у Јајцу. Завршио је Основну школу „Ђура Јакшић“ у Каћу, затим Гимназију „Светозар Марковић“ у Новом Саду. Дипломирао је на Правном факултету у Новом Саду 2008. године на смеру унутрашњих послова, а 2011. године на Правном факултету у Новом Саду, одбранио је мастер рад на тему „Уговори о кредиту са наменом“ из предмета банкарско право.</p><p>У претходном периоду, био је запослен у предузећу „Агрокоп” а.д. Нови Сад (2008-2010), као самостални стручни сарадник за опште и правне послове, а у предузећу „Фертил” доо Бачка Паланка био је руководилац Службе општих и правних послова (2010-2012).</p><p>У периоду од 2012. до 2016. године био је в.д. заменика начелника у Градској управи за опште и правне послове Града Новог Сада. Такође, био је и председник Надзорног одбора ЈКП „Зоохигијена и ветерина“ Нови Сад (2014-2015).</p><p>Дужност шефа Службе за заједничке послове Града Новог Сада&nbsp; врши у периоду од 2016. до 2017. године. В.д. директора ЈКП „Стан“ Нови Сад у периоду од 2017. до 2018, а в.д. директора ЈГСП „Нови Сад“ у периоду од 2018. до 2019. године.&nbsp;Директор ЈГСП „Нови Сад“ је у периоду од 2019. до 2020. године.</p><p>У периоду од 2020. до 2024. године именован је за члана Градског већа за управу, прописе и урбанизам.</p><p>У претходном мандату обаваљао је функцију члана Градског већа за управу, прописе, имовину и имовинско-правне послове, урбанизам и стамбене послове.</p><p>Ово му је трећи мандат на месту члана Градског већа Града Новог Сада.</p><p>Има положен државни стручни испит за рад у органима државне управе.</p><p>Политичко опредељење – Српска напредна странка.</p><p>Ожењен, отац&nbsp; двоје деце.</p>','','basic_html');
INSERT INTO `node_revision__body` VALUES ('article','0','44','148','sr-Latn-RS','0','<p>MILOVAN AMIDžIĆ</p><p>Član Gradskog veća za upravu i propise</p><p>Trg slobode 1, Novi Sad<br>Telefon: +381 21 525 850, 425 802</p><p>e-mail:&nbsp; <a href="mailto:milovan.amidzic@novisad.rs">milovan.amidzic@novisad.rs</a></p><p>Rođen je 28. novembra 1981. godine u Jajcu. Završio je Osnovnu školu „Đura Jakšić“ u Kaću, zatim Gimnaziju „Svetozar Marković“ u Novom Sadu. Diplomirao je na Pravnom fakultetu u Novom Sadu 2008. godine na smeru unutrašnjih poslova, a 2011. godine na Pravnom fakultetu u Novom Sadu, odbranio je master rad na temu „Ugovori o kreditu sa namenom“ iz predmeta bankarsko pravo.</p><p>U prethodnom periodu, bio je zaposlen u preduzeću „Agrokop” a.d. Novi Sad (2008-2010), kao samostalni stručni saradnik za opšte i pravne poslove, a u preduzeću „Fertil” doo Bačka Palanka bio je rukovodilac Službe opštih i pravnih poslova (2010-2012).</p><p>U periodu od 2012. do 2016. godine bio je v.d. zamenika načelnika u Gradskoj upravi za opšte i pravne poslove Grada Novog Sada. Takođe, bio je i predsednik Nadzornog odbora JKP „Zoohigijena i veterina“ Novi Sad (2014-2015).</p><p>Dužnost šefa Službe za zajedničke poslove Grada Novog Sada&nbsp; vrši u periodu od 2016. do 2017. godine. V.d. direktora JKP „Stan“ Novi Sad u periodu od 2017. do 2018, a v.d. direktora JGSP „Novi Sad“ u periodu od 2018. do 2019. godine.&nbsp;Direktor JGSP „Novi Sad“ je u periodu od 2019. do 2020. godine.</p><p>U periodu od 2020. do 2024. godine imenovan je za člana Gradskog veća za upravu, propise i urbanizam.</p><p>U prethodnom mandatu obavaljao je funkciju člana Gradskog veća za upravu, propise, imovinu i imovinsko-pravne poslove, urbanizam i stambene poslove.</p><p>Ovo mu je treći mandat na mestu člana Gradskog veća Grada Novog Sada.</p><p>Ima položen državni stručni ispit za rad u organima državne uprave.</p><p>Političko opredeljenje – Srpska napredna stranka.</p><p>Oženjen, otac&nbsp; dvoje dece.</p>','','basic_html');
