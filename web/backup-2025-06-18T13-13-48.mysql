INSERT INTO `locales_source` VALUES ('3597','Pacific/Wake','','10.4.7'),('3598','Pacific/Wallis','','10.4.7'),('3599','UTC','','10.4.7'),('3600','Default country','','10.4.7'),('3601','Locale','','10.4.7'),('3602','Users may set their own time zone','','10.4.7'),('3603','Remind users at login if their time zone is not set','','10.4.7'),('3604','Only applied if users may set their own time zone.','','10.4.7'),('3605','Empty time zone','','10.4.7'),('3606','Users may set their own time zone at registration','','10.4.7'),('3607','Time zone for new users','','10.4.7'),('3608','Time zones','','10.4.7'),('3609','Successfully saved @language translation.','','10.4.7'),('3610','Settings successfully updated.','','10.4.7'),('3611','Read more<span class="visually-hidden"> about @title</span>','','10.4.8'),('3612','Has new content','','10.4.7'),('3613','@label (@name:delta)','','10.4.7'),('3614','Global','','10.4.7'),('3615','Has taxonomy term','','10.4.7'),('3616','Content access','','10.4.7'),('3617','@entity_type revision','','10.4.7'),('3618','File Usage','','10.4.7'),('3619','Original language','','10.4.7'),('3620','Has taxonomy terms (with depth)','','10.4.7'),('3621','User has a revision','','10.4.7'),('3622','Published status or admin user','','10.4.7'),('3623','Module','','10.4.7'),('3624','Publish status','','10.4.7'),('3625','Sticky status','','10.4.7'),('3626','Post date','','10.4.7');
INSERT INTO `locales_source` VALUES ('3627','Is Latest Revision','','10.4.7'),('3628','Is Latest Translation Affected Revision','','10.4.7'),('3629','Selected:','','10.4.7'),('3630','Category','','10.4.8'),('3631','Update @title','','10.4.7'),('3632','Combine fields filter','','10.4.7'),('3633','Search Keywords','','10.4.7'),('3634','Filter for content by view access. <strong>Not necessary if you are using node as your base table.</strong>','','10.4.7'),('3635','The ID of the entity that is related to the file.','','10.4.7'),('3636','The module managing this file relationship.','','10.4.7'),('3637','The number of times the file is used by this entity.','','10.4.7'),('3638','The type of entity that is related to the file.','','10.4.7'),('3639','Combine multiple fields together and search by them.','','10.4.7'),('3640','The date the content related to a term was posted.','','10.4.7'),('3641','Whether or not the content related to a term is published.','','10.4.7'),('3642','Whether or not the content related to a term is sticky.','','10.4.7'),('3643','The keywords to search for.','','10.4.7'),('3644','This is an alias of @group: @field.','','10.4.7'),('3645','Delta - Appears in: @bundles.','','10.4.7'),('3646','A flag indicating whether this is the default translation.','','10.4.7'),('3647','Show only content that is new or updated.','','10.4.7'),('3648','Display content if it has the selected taxonomy terms.','','10.4.7'),('3649','Display content if it has the selected taxonomy terms, or children of the selected terms. Due to additional complexity, this has fewer options than the versions without depth.','','10.4.7'),('3650','Filters out unpublished content if the current user cannot view it.','','10.4.7'),('3651','Indicates if the last edit of a translation belongs to current revision.','','10.4.7'),('3652','A boolean indicating whether the node should sort to the top of content lists.','','10.4.7'),('3653','A boolean indicating whether this translation needs to be updated.','','10.4.7'),('3654','The source language from which this translation was created.','','10.4.7'),('3655','All nodes where a certain user has a revision','','10.4.7');
INSERT INTO `locales_source` VALUES ('3656','A boolean indicating whether the node is visible on the front page.','','10.4.7'),('3657','The time that the node was last edited.','','10.4.7'),('3658','A flag indicating whether this was a default revision when it was saved.','','10.4.7'),('3659','Restrict the view to only revisions that are the latest revision of their entity.','','10.4.7'),('3660','Restrict the view to only revisions that are the latest translation affected revision of their entity.','','10.4.7'),('3661','The time that the current revision was created.','','10.4.7'),('3662','The user ID of the author of the current revision.','','10.4.7'),('3663','The language of the content or translation.','','10.4.7'),('3664','Add and configure @types','','10.4.7'),('3665','Add @type','','10.4.7'),('3666','This filter is not exposed. Expose it to allow the users to change it.','','10.4.7'),('3667','Expose this filter to visitors, to allow them to change it','','10.4.7'),('3668','Expose filter','','10.4.7'),('3669','Is one of','','10.4.7'),('3670','Is not one of','','10.4.7'),('3671','Operator','','10.4.7'),('3672','Select all','','10.4.7'),('3673','Administrative title','','10.4.7'),('3674','This title will be displayed on the views edit page instead of the default one. This might be useful if you have the same item twice.','','10.4.7'),('3675','Configure @type: @item','','10.4.7'),('3676','filter criterion','','10.4.7'),('3677','Unknown','','10.4.7'),('3678','in','','10.4.7'),('3679','This display has one or more validation errors.','','10.4.8'),('3680','No valid values found on filter: @filter.','','10.4.7'),('3681','Unable to preview due to validation errors.','','10.4.8'),('3682','@view: @display','','10.4.8'),('3683','QuickTabs','','10.4.8'),('3684','Enter a part of the block, theme or category to filter by.','','10.4.7'),('3685','Enter block, theme or category','','10.4.7');
INSERT INTO `locales_source` VALUES ('3686','block','','10.4.8'),('3687','Browse available tokens.','','10.4.8'),('3688','This field supports tokens. @browse_tokens_link','','10.4.8'),('3689','Language selection','','10.4.8'),('3690','Select languages to enforce. If none are selected, all languages will be allowed.','','10.4.8'),('3691','Success (@status_code)','','10.4.8'),('3692','Access denied (@status_code)','','10.4.8'),('3693','Page not found (@status_code)','','10.4.8'),('3694','Response status','','10.4.8'),('3695','Shows the block on pages with any matching response status. If nothing is checked, the block is shown on all pages. Other response statuses are not used.','','10.4.8'),('3696','Pages','','10.4.8'),('3697','Specify pages by using their paths. Enter one path per line. The ''*'' character is a wildcard. An example path is %user-wildcard for every user page. %front is the front page.','','10.4.8'),('3698','Show for the listed pages','','10.4.8'),('3699','Hide for the listed pages','','10.4.8'),('3700','Negate the condition','','10.4.8'),('3701','When the user has the following roles','','10.4.8'),('3702','Visibility','','10.4.8'),('3703','A unique name for this block instance. Must be alpha-numeric and underscore separated.','','10.4.8'),('3704','Navigation branding region','','10.4.8'),('3705','Main navigation region','','10.4.8'),('3706','Additional navigation region (eg search form, social icons, etc)','','10.4.8'),('3707','Content top','','10.4.8'),('3708','Main content','','10.4.8'),('3709','Content bottom','','10.4.8'),('3710','Sidebar first','','10.4.8'),('3711','Sidebar second','','10.4.8'),('3712','Footer first','','10.4.8'),('3713','Footer second','','10.4.8'),('3714','Footer third','','10.4.8'),('3715','Footer fourth','','10.4.8');
INSERT INTO `locales_source` VALUES ('3716','Footer fiveth','','10.4.8'),('3717','Footer sixth','','10.4.8'),('3718','Disclaimer','','10.4.8'),('3719','Select the region where this block should be displayed.','','10.4.8'),('3720','Save block','','10.4.8'),('3721','Not restricted','','10.4.8'),('3722','Restricted to certain pages','','10.4.8'),('3723','The block cannot be placed in this region.','','10.4.8'),('3724','(active tab)','','10.4.8'),('3725','1 block is available in the modified list.@count blocks are available in the modified list.','','10.4.8'),('3726','Insert this token into your form','','10.4.8'),('3727','First click a text field to insert your tokens into.','','10.4.8'),('3728','The block configuration has been saved.','','10.4.8'),('3729','menu','','10.4.7'),('3730','Menu description','','10.4.7'),('3731','Not in menu','','10.4.8'),('3732','(this translation)','','10.4.8'),('3733','all languages','','10.4.8'),('3734','Revision information','','10.4.8'),('3735','Create new revision','','10.4.8'),('3736','Provide a menu link','','10.4.8'),('3737','Menu link title','','10.4.8'),('3738','Shown when hovering over the menu link.','','10.4.8'),('3739','Menu links with lower weights are displayed before links with higher weights.','','10.4.8'),('3740','Menu settings','','10.4.8'),('3741','Generate automatic URL alias','','10.4.8'),('3742','Uncheck this to create a custom alias below. <a href="@admin_link">Configure URL alias patterns.</a>','','10.4.8'),('3743','<em>Edit @type</em> @title','','10.4.8'),('3744','@type %title has been updated.','','10.4.8'),('3745','Initial visibility level','','10.4.7');
INSERT INTO `locales_source` VALUES ('3746','The menu is only visible if the menu link for the current page is at this level or below it. Use level 1 to always display this menu.','','10.4.7'),('3747','Unlimited','','10.4.8'),('3748','Number of levels to display','','10.4.7'),('3749','This maximum number includes the initial level.','','10.4.7'),('3750','Expand all menu links','','10.4.7'),('3751','Override the option found on each menu link used for expanding children and instead display the whole menu tree as expanded.','','10.4.7'),('3752','Menu levels','','10.4.7'),('3753','Fixed parent item','','10.4.7'),('3754','Alter the options in “Menu levels” to be relative to the fixed parent item. The block will only contain children of the selected menu link.','','10.4.7'),('3755','<strong>Render parent item</strong>','','10.4.7'),('3756','If the <strong>Initial visibility level</strong> is greater than 1, or a <strong>Fixed parent item</strong> is chosen, only the children of that item will be displayed by default. Enable this option to <strong>always</strong> render the parent item in the menu.','','10.4.7'),('3757','Menu title','','10.4.7'),('3758','Parent title at initial visibility level','','10.4.7'),('3759','Fixed parent item''s title','','10.4.7'),('3760','Active item''s title','','10.4.7'),('3761','Active trail''s parent title','','10.4.7'),('3762','Active trail''s root title','','10.4.7'),('3763','Use as title','','10.4.7'),('3764','Replace the block title with an item from the menu.','','10.4.7'),('3765','Link the title?','','10.4.7'),('3766','<strong>Hide on pages not included in menu</strong>','','10.4.7'),('3767','If checked, this block will not appear on any pages that are not linked in the menu. If unchecked, this block will appear on all pages. This option is also affected by visibility settings below.','','10.4.7'),('3768','<strong>Make the initial visibility level follow the active menu item.</strong>','','10.4.7'),('3769','If the active menu item is deeper than the initial visibility level set above, the initial visibility level will be relative to the active menu item. Otherwise, the initial visibility level of the tree will remain fixed.','','10.4.7');
INSERT INTO `locales_source` VALUES ('3770','Active menu item','','10.4.7'),('3771','Children of active menu item','','10.4.7'),('3772','Initial visibility level will be','','10.4.7'),('3773','When following the active menu item, select whether the initial visibility level should be set to the active menu item, or its children.','','10.4.7'),('3774','<strong>Display empty block</strong>','','10.4.7'),('3775','Display block if block content is empty.','','10.4.7'),('3776','Theme hook suggestion','','10.4.7'),('3777','A theme hook suggestion can be used to override the default HTML and CSS classes for menus found in <code>menu.html.twig</code>.','','10.4.7'),('3778','HTML and style options','','10.4.7'),('3779','Specify which display or custom URL this display will link to.','','10.4.8'),('3780','Block name','','10.4.8'),('3781','Block category','','10.4.8'),('3782','Allow settings','','10.4.8'),('3783','Link display','','10.4.8'),('3784','Hide block if the view output is empty','','10.4.8'),('3785','This display has no path.','','10.4.8'),('3786','Select pager','','10.4.8'),('3787','settings','','10.4.8'),('3788','Display a specified number of items','','10.4.8'),('3789','Display all items','','10.4.8'),('3790','Paged output, mini pager','','10.4.8'),('3791','You may also adjust the @settings for the currently selected pager.','','10.4.8'),('3792','Pager options','','10.4.8'),('3793','Heading Level','','10.4.7'),('3794','Choose a heading level equal to or one lower than the preceding header.','','10.4.7'),('3795','Enter 0 for no limit.','','10.4.8'),('3796','Offset (number of items to skip)','','10.4.8'),('3797','For example, set this to 3 and the first 3 items will not be displayed.','','10.4.8'),('3798','Pager ID','','10.4.7'),('3799','Unless you''re experiencing problems with pagers related to this view, you should leave this at 0. If using multiple pagers on one page you may need to set this number to a higher value so as not to conflict within the ?page= array. Large values will add a lot of commas to your URLs, so avoid if possible.','','10.4.7');
INSERT INTO `locales_source` VALUES ('3800','Number of pages','','10.4.7'),('3801','Leave empty to show all pages.','','10.4.7'),('3802','Pager link labels','','10.4.7'),('3803','Allow user to control the number of items displayed in this view','','10.4.7'),('3804','Exposed items per page options','','10.4.7'),('3805','Set between which values the user can choose when determining the items per page. Separated by comma.','','10.4.7'),('3806','Allow user to display all items','','10.4.7'),('3807','Allow user to specify number of items skipped from beginning of this view.','','10.4.7'),('3808','Allow user to control selected display options for this view.','','10.4.7'),('3809','Number of pager links visible','','10.4.7'),('3810','Specify the number of links to pages to display in the pager.','','10.4.7'),('3811','All displays (except overridden)','','10.4.8'),('3812','Importing your complete site configuration','','10.4.8'),('3813','Exporting your complete site configuration','','10.4.8'),('3814','Import the complete configuration of your site from an archive file, such as one that was previously exported (see @export_full_topic). See @config_overview_topic for more information about configuration.','','10.4.8'),('3815','In the <em>Manage</em> administrative menu, navigate to <em>Configuration</em> &gt; <em>Development</em> &gt; <em>Configuration synchronization</em> &gt; <em>@import_link</em>.','','10.4.8'),('3816','Browse to find the <em>Configuration archive</em> that you want to import.','','10.4.8'),('3817','Click <em>Upload</em>. Your configuration archive will be unpacked and placed in the configuration synchronization directory, and you will be redirected to the <em>Synchronize</em> page.','','10.4.8'),('3818','Review the differences between your uploaded configuration and the active configuration, if any, and click <em>Import all</em> to import the changes.','','10.4.8'),('3819','Create and download an archive containing all your site''s configuration, exported as YAML files. See @config_overview_topic for more information about configuration.','','10.4.8');
INSERT INTO `locales_source` VALUES ('3820','In the <em>Manage</em> administrative menu, navigate to <em>Configuration</em> &gt; <em>Development</em> &gt; <em>Configuration synchronization</em> &gt; <em>@export_link</em>.','','10.4.8'),('3821','Click <em>Export</em> and save the archive file.','','10.4.8'),('3822','Exporting a single configuration item','','10.4.8'),('3823','Single item','','10.4.8'),('3824','Export a single configuration item to a file. See @config_overview_topic for more information about configuration.','','10.4.8'),('3825','In the <em>Manage</em> administrative menu, navigate to <em>Configuration</em> &gt; <em>Development</em> &gt; <em>Configuration synchronization</em> &gt; <em>Export</em> &gt; <em>@single_export_link</em>.','','10.4.8'),('3826','Select the <em>Configuration type</em> that you want to export, and then select the specific <em>Configuration name</em> to export.','','10.4.8'),('3827','Use your browser to copy the text in the box marked <em>Here is your configuration</em> to the clipboard.','','10.4.8'),('3828','Paste the copied text into a plain-text editor on your computer or other device, and save it using the suggested file name below the text box.','','10.4.8'),('3829','Importing a single configuration item','','10.4.8'),('3830','Import a single configuration item in YAML format, such as one that was previously exported (see @export_single_topic). See @config_overview_topic for more information about configuration.','','10.4.8'),('3831','In the <em>Manage</em> administrative menu, navigate to <em>Configuration</em> &gt; <em>Development</em> &gt; <em>Configuration synchronization</em> &gt; <em>Import</em> &gt; <em>@single_import_link</em>.','','10.4.8'),('3832','Select the <em>Configuration type</em> that you want to import.','','10.4.8'),('3833','On your computer or other device, copy the YAML-format configuration that you want to import to the clipboard.','','10.4.8'),('3834','Paste the clipboard text into the box labeled <em>Paste your configuration here</em>.','','10.4.8'),('3835','Click <em>Import</em>.','','10.4.8');
INSERT INTO `locales_source` VALUES ('3836','Mini','','10.4.7'),('3837','Mini pager, @count itemMini pager, @count items','','10.4.7'),('3838','Enabled','Plural','10.4.7'),('3839','Disabled','Plural','10.4.8'),('3840','Enter a part of the view name, machine name, description, or display path to filter by.','','10.4.7'),('3841','Filter by view name, machine name, description, or display path','','10.4.7'),('3842','Duplicate','','10.4.7'),('3843','@count item@count items','','10.4.8'),('3844','Administrative name','','10.4.8'),('3845','View language','','10.4.7'),('3846','Language of labels and other textual elements in this view.','','10.4.7'),('3847','Administrative tags','','10.4.7'),('3848','Enter a comma-separated list of words to describe your view.','','10.4.7'),('3849','Are you sure you want to delete the @entity-type %label?','','10.4.7'),('3850','The @entity-type %label has been deleted.','','10.4.7'),('3851','The name and the description of this display','','10.4.8'),('3852','Filter the contents of the %view_title view','','10.4.8'),('3853','Update this item','','10.4.8'),('3854','Sort ascending','','10.4.8'),('3855','Perform actions on the selected items in the %view_title view','','10.4.8'),('3856','Apply to selected items','','10.4.8'),('3857','Remove from %shortcut_set shortcuts','','10.4.8'),('3858','Publish','','10.4.7'),('3859','content block','','10.4.7'),('3860','custom menu link','','10.4.7'),('3861','content item','','10.4.7'),('3862','taxonomy term','','10.4.7'),('3863','Unpublish','','10.4.7'),('3864','Are you sure you want to delete this @item?Are you sure you want to delete these @items?','','10.4.7'),('3865','content items','','10.4.8');
INSERT INTO `locales_source` VALUES ('3866','Deleted @count content item.Deleted @count content items.','','10.4.7'),('3867','Reference type: @entity_type','','10.4.8'),('3868','Widget','','10.4.8'),('3869','Field','','10.4.8'),('3870','No field is displayed.','','10.4.8'),('3871','Label display for @title','','10.4.8'),('3872','Region for @title','','10.4.8'),('3873','Textfield','','10.4.8'),('3874','Plugin for @title','','10.4.8'),('3875','Textfield size: @size','','10.4.8'),('3876','Autocomplete','','10.4.8'),('3877','Autocomplete (Tags style)','','10.4.8'),('3878','Check boxes/radio buttons','','10.4.8'),('3879','Select list','','10.4.8'),('3880','Autocomplete matching: @match_operator','','10.4.8'),('3881','Contains','','10.4.8'),('3882','Autocomplete suggestion list size: @size','','10.4.8'),('3883','No placeholder','','10.4.8'),('3884','Language select','','10.4.8'),('3885','Datetime Timestamp','','10.4.8'),('3886','Single on/off checkbox','','10.4.8'),('3887','Use field label: @display_label','','10.4.8'),('3888','Text area with a summary','','10.4.8'),('3889','Number of rows: @rows','','10.4.8'),('3890','Number of summary rows: @rows','','10.4.8'),('3891','Progress indicator: @progress_indicator','','10.4.8'),('3892','Parents for @title','','10.4.8'),('3893','No field is hidden.','','10.4.8'),('3894','Refresh','','10.4.8'),('3895','Content items can be edited using different form modes. Here, you can define which fields are shown and hidden when %type content is edited in each form mode, and define how the field form widgets are displayed in each form mode.','','10.4.8');
INSERT INTO `locales_source` VALUES ('3896','Widget settings:','','10.4.7'),('3897','Include locked languages such as <em>Not specified</em> and <em>Not applicable</em>','','10.4.7'),('3898','Your settings have been saved.','','10.4.7'),('3899','The following @entity-type translations will be deleted:','','10.4.7'),('3900','The menu link %title has been deleted.','','10.4.7'),('3901','Menu %label has been updated.','','10.4.7'),('3902','No blocks in this region','','10.4.8'),('3903','Place block <span class="visually-hidden">in the %region region</span>','','10.4.8'),('3904','@label (disabled)','','10.4.8'),('3905','Region for @block block','','10.4.8'),('3906','Weight for @block block','','10.4.8'),('3907','Edit block','','10.4.8'),('3908','Save blocks','','10.4.8'),('3909','Block placement is specific to each theme on your site. Changes will not be saved until you click <em>Save blocks</em> at the bottom of the page.','','10.4.8'),('3910','Demonstrate block regions (@theme)','','10.4.8'),('3911','The content block language code.','','10.4.8'),('3912','The log entry explaining the changes in this revision.','','10.4.8'),('3913','Vertical Tabs','','10.4.8'),('3914','Edit content block %label','','10.4.8'),('3915','It is recommended to not use the "Entire site" backup as it has a tendency of failing on anything but the tiniest of sites. Hopefully this will be fixed in a future release.','','10.4.8'),('3916','Add a note to the backup','','10.4.8'),('3917','Note','','10.4.8'),('3918','Backup now','','10.4.8'),('3919','Quick Backup','','10.4.8'),('3920','Advanced Backup','','10.4.8'),('3921','No available releases found','','10.4.7'),('3922','There was a problem checking <a href=":update-report">available updates</a> for Drupal.','','10.4.8'),('3923','Your site is currently configured to send these emails when any updates are available. To get notified only for security updates, @url.','','10.4.7'),('3924','Revision','','10.4.7'),('3925','@date by @username','','10.4.7');
INSERT INTO `locales_source` VALUES ('3926','Current revision','','10.4.7'),('3927','@language_name revisions for %title','','10.4.7'),('3928','Revisions allow you to track differences between multiple versions of your content, and revert to older versions.','','10.4.7'),('3929','Is equal to','','10.4.7'),('3930','Is not equal to','','10.4.7'),('3931','False','','10.4.7'),('3932','All items','','10.4.8'),('3933','logged in users only','','10.4.7'),('3934','Add menu link','','10.4.7'),('3935','Short description of the image used by screen readers and displayed when the image is not loaded. This is important for accessibility.','','10.4.8'),('3936','File information','','10.4.8'),('3937','Weight for new file','','10.4.8'),('3938','@language translation was not added. To add a translation, you must modify the configuration.','','10.4.7'),('3939','Backup Complete.','','10.4.7'),('3940','The title is used as a tool tip when the user hovers the mouse over the image.','','10.4.8'),('3941','You can re-use a field from other sub-types of the same entity type. Re-using a field creates another usage of the same field storage.','','10.4.8'),('3942','Filter by field or field type','','10.4.8'),('3943','Field Type','','10.4.8'),('3944','Used in: @list','','10.4.8'),('3945','Reuse @field_name','','10.4.8'),('3946','Re-use','','10.4.8'),('3947','Single valueMultiple values: @cardinality','','10.4.8'),('3948','Instructions to present to the user below this field on the editing form.<br />Allowed HTML tags: @tags','','10.4.8'),('3949','This field supports tokens.','','10.4.8'),('3950','These settings apply to the %field field everywhere it is used. Some also impact the way that data is stored and cannot be changed once data has been created.','','10.4.8'),('3951','pixels','','10.4.8'),('3952','Optional subdirectory within the upload destination where files will be stored. Do not include preceding or trailing slashes.','','10.4.8'),('3953','Public files','','10.4.8'),('3954','Private files','','10.4.8'),('3955','Upload destination','','10.4.8');
INSERT INTO `locales_source` VALUES ('3956','Select where the final files should be stored. Private file storage has significantly more overhead than public files, but allows restricted access to files within this field.','','10.4.8'),('3957','Image to be shown if no image is uploaded.','','10.4.8'),('3958','The title attribute is used as a tooltip when the mouse hovers over the image.','','10.4.8'),('3959','Default image','','10.4.8'),('3960','If no image is uploaded, this image will be shown on display.','','10.4.8'),('3961','Update settings','','10.4.8'),('3962','Limited','','10.4.8'),('3963','Allowed number of values','','10.4.8'),('3964','Limit','','10.4.8'),('3965','Field Storage','','10.4.8'),('3966','Users may translate this field','','10.4.8'),('3967','If no image is uploaded, this image will be shown on display and will override the field''s default image.','','10.4.8'),('3968','Allowed file extensions','','10.4.8'),('3969','Separate extensions with a comma or space. Each extension can contain alphanumeric characters, ''.'', and ''_'', and should start and end with an alphanumeric character.','','10.4.8'),('3970','File directory','','10.4.8'),('3971','Maximum width','','10.4.8'),('3972','Maximum height','','10.4.8'),('3973','Maximum image dimensions','','10.4.8'),('3974','The maximum allowed image size expressed as WIDTH×HEIGHT (e.g. 640×480). Leave blank for no restriction. If a larger image is uploaded, it will be resized to reflect the given width and height. Resizing images on upload will cause the loss of <a href="http://wikipedia.org/wiki/Exchangeable_image_file_format">EXIF data</a> in the image.','','10.4.8'),('3975','Minimum width','','10.4.8'),('3976','Minimum height','','10.4.8'),('3977','Minimum image dimensions','','10.4.8'),('3978','The minimum allowed image size expressed as WIDTH×HEIGHT (e.g. 640×480). Leave blank for no restriction. If a smaller image is uploaded, it will be rejected.','','10.4.8'),('3979','Maximum upload size','','10.4.8'),('3980','Enter a value like "512" (bytes), "80 KB" (kilobytes) or "50 MB" (megabytes) in order to restrict the allowed file size. If left empty the file sizes could be limited only by PHP''s maximum post and file upload sizes (current limit <strong>%limit</strong>).','','10.4.8');
INSERT INTO `locales_source` VALUES ('3981','Enable <em>Alt</em> field','','10.4.8'),('3982','Short description of the image used by screen readers and displayed when the image is not loaded. Enabling this field is recommended.','','10.4.8'),('3983','<em>Alt</em> field required','','10.4.8'),('3984','Making this field required is recommended.','','10.4.8'),('3985','Enable <em>Title</em> field','','10.4.8'),('3986','The title attribute is used as a tooltip when the mouse hovers over the image. Enabling this field is not recommended as it can cause problems with screen readers.','','10.4.8'),('3987','<em>Title</em> field required','','10.4.8'),('3988','%field settings for %bundle','','10.4.8'),('3989','Saved %label configuration.','','10.4.8'),('3990','The human-readable name for this content type, displayed on the <em>Content types</em> page.','','10.4.7'),('3991','Unique machine-readable name: lowercase letters, numbers, and underscores only.','','10.4.7'),('3992','Displays on the <em>Content types</em> page.','','10.4.7'),('3993','Title field label','','10.4.7'),('3994','Optional','','10.4.7'),('3995','Required','','10.4.7'),('3996','Explanation or submission guidelines','','10.4.7'),('3997','This text will be displayed at the top of the page when creating or editing content of this type.','','10.4.7'),('3998','Submission form settings','','10.4.7'),('3999','Default options','','10.4.7'),('4000','Users with sufficient access rights will be able to override these options.','','10.4.7'),('4001','Publishing options','','10.4.7'),('4002','Enable translation','','10.4.7'),('4003','Display author and date information','','10.4.7'),('4004','Author username and publish date will be displayed.','','10.4.7'),('4005','Available menus','','10.4.7'),('4006','Content of this type can be placed in the selected menus.','','10.4.7'),('4007','Default parent link','','10.4.7'),('4008','Choose the menu link to be the default parent for a new link in the content authoring form.','','10.4.7'),('4009','Edit %label content type','','10.4.7'),('4010','Requires a title','','10.4.7');
INSERT INTO `locales_source` VALUES ('4011','Not published','','10.4.7'),('4012','Don''t display post information','','10.4.7'),('4013','no preview','','10.4.8'),('4014','Preview image style: @style','','10.4.8'),('4015','Visually Hidden','','10.4.7'),('4016','Links','','10.4.7'),('4017','Above','','10.4.7'),('4018','Inline','','10.4.7'),('4019','Smart trimmed','','10.4.7'),('4020','Trimmed','','10.4.7'),('4021','Summary or trimmed','','10.4.7'),('4022','Generic file','','10.4.7'),('4023','URL to file','','10.4.7'),('4024','Table of files','','10.4.7'),('4025','RSS enclosure','','10.4.7'),('4026','Use description as link text','','10.4.7'),('4027','URL to image','','10.4.7'),('4028','Image style: @style','','10.4.7'),('4029','Linked to content','','10.4.7'),('4030','Image loading: @attribute','','10.4.7'),('4031','FlexSlider (Entity view)','','10.4.7'),('4032','RSS category','','10.4.7'),('4033','Rendered entity','','10.4.7'),('4034','Link to the referenced entity','','10.4.7'),('4035','Use custom display settings for the following @display_context modes','','10.4.7'),('4036','Manage view modes','','10.4.7'),('4037','Custom display settings','','10.4.7'),('4038','Content items can be displayed using different view modes: Teaser, Full content, Print, RSS, etc. <em>Teaser</em> is a short format that is typically used in lists of multiple content items. <em>Full content</em> is typically used when the content is displayed on its own page.','','10.4.7'),('4039','Here, you can define which fields are shown and hidden when %type content is displayed in each view mode, and define how the fields are displayed in each view mode.','','10.4.7'),('4040','Enable <em>Display</em> field','','10.4.7');
INSERT INTO `locales_source` VALUES ('4041','The display option allows users to choose if a file should be shown when viewing the content.','','10.4.7'),('4042','Files displayed by default','','10.4.7'),('4043','This setting only has an effect if the display option is enabled.','','10.4.7'),('4044','Enable <em>Description</em> field','','10.4.7'),('4045','The description field allows users to enter a description about the uploaded file.','','10.4.7'),('4046','The description may be used as the label of the link to the file.','','10.4.7'),('4047','The content type %name has been updated.','','10.4.7'),('4048','Save and manage fields','','10.4.7'),('4049','Individual content types can have different fields, behaviors, and permissions assigned to them.','','10.4.7'),('4050','The content type %name has been added.','','10.4.7'),('4051','Back','','10.4.7'),('4052','A unique machine-readable name containing letters, numbers, and underscores.','','10.4.7'),('4053','Internal links only','','10.4.7'),('4054','External links only','','10.4.7'),('4055','Both internal and external links','','10.4.7'),('4056','Allowed link type','','10.4.7'),('4057','Allow link text','','10.4.7'),('4058','Set default value','','10.4.7'),('4059','Provide a pre-filled value for the editing form.','','10.4.7'),('4060','The default value for this field, used when creating new content.','','10.4.7'),('4061','Order','Sort order','10.4.7'),('4062','Weight for row @number','','10.4.7'),('4063','Add another item','','10.4.7'),('4064','This must be an internal path such as %add-node. You can also start typing the title of a piece of content to select it. Enter %front to link to the front page. Enter %nolink to display link text only. Enter %button to display keyboard-accessible link text only.','','10.4.7'),('4065','No placeholders','','10.4.7'),('4066','Placeholder for URL','','10.4.7'),('4067','Text that will be shown inside the field until a value is entered. This hint is usually a sample value or a brief description of the expected format.','','10.4.7'),('4068','Placeholder for link text','','10.4.7'),('4069','Duplicate of @label','','10.4.7');
INSERT INTO `locales_source` VALUES ('4070','The menu path or URL of this view','','10.4.8'),('4071','This view will be displayed by visiting this path on your site. You may use "%" or named route parameters like "%node" in your URL to represent values that will be used for contextual filters: For example, "node/%node/feed" or "view_path/%". Named route parameters are required when this path matches an existing path. For example, paths such as "taxonomy/term/%taxonomy_term" or "user/%user/custom-view".','','10.4.8'),('4072','@entity types','','10.4.7'),('4073','Manually entered paths should start with one of the following characters: / ? #','','10.4.7'),('4074','Edit @language translation for %label','','10.4.7'),('4075','Successfully updated @language translation.','','10.4.7'),('4076','Vocabulary name','','10.4.7'),('4077','List terms','','10.4.7'),('4078','Edit vocabulary','','10.4.7'),('4079','Add terms','','10.4.7'),('4080','Delete vocabulary','','10.4.7'),('4081','Taxonomy is for categorizing content. Terms are grouped into vocabularies. For example, a vocabulary called "Fruit" would contain the terms "Apple" and "Banana".','','10.4.7'),('4082','A unique machine-readable name. Can only contain lowercase letters, numbers, and underscores.','','10.4.7'),('4083','Create a new revision by default for this vocabulary.','','10.4.7'),('4084','Vocabulary language','','10.4.7'),('4085','Term language','','10.4.7'),('4086','Created new vocabulary %name.','','10.4.7'),('4087','You can reorganize the terms in %capital_name using their drag-and-drop handles, and group terms under a parent term by sliding them under and to the right of the parent.','','10.4.7'),('4088','No terms available. <a href=":link">Add term</a>.','','10.4.7'),('4089','Edit %label','','10.4.7'),('4090','Add term','','10.4.7'),('4091','root','','10.4.7'),('4092','The term language code.','','10.4.7'),('4093','Parent terms','','10.4.7'),('4094','Terms are displayed in ascending order by weight.','','10.4.7'),('4095','Relations','','10.4.7'),('4096','Save and go to list','','10.4.7'),('4097','Created new term %term.','','10.4.7');
INSERT INTO `locales_source` VALUES ('4098','Weight for added term','','10.4.7'),('4099','Reset to alphabetical','','10.4.7'),('4100','To configure translation for this field, <a href=":language-settings-url">enable language support</a> for this type.','','10.4.7'),('4101','Separate link text and URL','','10.4.7'),('4102','Link text trimmed to @limit characters','','10.4.7'),('4103','The %display_mode mode now uses custom display settings. You might want to <a href=":url">configure them</a>.','','10.4.7'),('4104','Trimmed limit: @trim_length characters','','10.4.7'),('4105','content type','','10.4.7'),('4106','The time that the term was last edited.','','10.4.7'),('4107','characters','','10.4.7'),('4108','Format settings:','','10.4.7'),('4109','Trim length','','10.4.7'),('4110','Characters','','10.4.7'),('4111','Words','','10.4.7'),('4112','Trim units','','10.4.7'),('4113','Unicode character identifiers of the form \\u2026 allowed.','','10.4.7'),('4114','Use summary if present, and do not trim','','10.4.7'),('4115','Use summary if present, honor trim settings','','10.4.7'),('4116','Do not use summary','','10.4.7'),('4117','Strip HTML','','10.4.7'),('4118','Honor a zero trim length','','10.4.7'),('4119','Replace tokens before trimming','','10.4.7'),('4120','Additional options','','10.4.7'),('4121','Wrap trimmed content?','','10.4.7'),('4122','Adds a wrapper div to trimmed content. This option is deprecated and will be removed in Smart Trim 3.0.0. Please override the smart-trim.html.twig template file to customize output.','','10.4.7'),('4123','Wrapped content class.','','10.4.7'),('4124','If wrapping, define the class name here.','','10.4.7'),('4125','Display <em>More</em> link?','','10.4.7'),('4126','Displays a link to the entity (if one exists)','','10.4.7'),('4127','Display <em>More</em> link only when content is trimmed?','','10.4.7');
INSERT INTO `locales_source` VALUES ('4128','Only display <em>More</em> link if content is actually trimmed.','','10.4.7'),('4129','Open <em>More</em> link in new window','','10.4.7'),('4130','<em>More</em> link text','','10.4.7'),('4131','If displaying <em>More</em> link, enter the text for the link. This field supports tokens.','','10.4.7'),('4132','<em>More</em> link aria-label','','10.4.7'),('4133','If displaying <em>More</em> link, provide additional context for screen-reader users. In most cases, the aria-label value will be announced instead of the link text. This field supports tokens.','','10.4.7'),('4134','<em>More</em> link class','','10.4.7'),('4135','If displaying <em>More</em> link, add a custom class for formatting.','','10.4.7'),('4136','<em>More</em> link','','10.4.7'),('4137','Suffix: %suffix','','10.4.7'),('4138','<em>More</em> link enabled, text: %text','','10.4.7'),('4139','<em>More</em> link aria-label: %label','','10.4.7'),('4140','<em>More</em> link class: %class','','10.4.7'),('4141','Choose an option below','','10.4.7'),('4142','An entity field containing an entity reference.','','10.4.7'),('4143','Configuration','Entity type group','10.4.7'),('4144','Content','Entity type group','10.4.7'),('4145','Entity view display','','10.4.7'),('4146','Base field override','','10.4.7'),('4147','Content language settings','','10.4.7'),('4148','Text editor','','10.4.7'),('4149','Field storage','','10.4.7'),('4150','Views: Filter by an entity reference view','','10.4.7'),('4151','Change handler','','10.4.7'),('4152','Update form','','10.4.7'),('4153','Reference type','','10.4.7'),('4154','Revisions for %title','','10.4.7'),('4155','Select which vocabulary to show terms for in the regular options.','','10.4.7'),('4156','Dropdown','','10.4.7'),('4157','Selection type','','10.4.7');
INSERT INTO `locales_source` VALUES ('4158','Show hierarchy in dropdown','','10.4.7'),('4159','Configure extra settings for @type %item','','10.4.7'),('4160','or','','10.4.7'),('4161','Is all of','','10.4.7'),('4162','Is none of','','10.4.7'),('4163','Is empty (NULL)','','10.4.7'),('4164','Is not empty (NOT NULL)','','10.4.7'),('4165','Select terms from vocabulary @voc','','10.4.7'),('4166','Leave blank for all. Otherwise, the first selected term will be the default instead of "Any".','','10.4.7'),('4167','Reduce duplicates','','10.4.7'),('4168','This filter can cause items that have more than one of the selected options to appear as duplicate results. If this filter causes duplicate results to occur, this checkbox can reduce those duplicates; however, the more terms it has to search for, the less performant the query will be, so use this with caution. Shouldn''t be set on single-value fields, as it may cause values to disappear from display, if used on an incompatible field.','','10.4.7'),('4169','Configure @type @current of @total: @item','','10.4.7'),('4170','Taxonomy term ID','','10.4.7'),('4171','This link is provided by the @name module. The title and path cannot be edited.','','10.4.7'),('4172','Enable menu link','','10.4.7'),('4173','Menu links that are not enabled will not be listed in any menu.','','10.4.7'),('4174','Edit menu link %title','','10.4.7'),('4175','Remove selected','','10.4.8'),('4176','@count (default setting)','','10.4.7'),('4177','Override title','','10.4.7'),('4178','Changing the title here means it cannot be dynamically altered anymore. (Try changing it directly in <a href=":url">@name</a>.)','','10.4.7'),('4179','Rewrite results','','10.4.7'),('4180','Block display options','','10.4.7'),('4181','Link path','','10.4.7'),('4182','Title text','','10.4.7'),('4183','Prefix text','','10.4.7'),('4184','Suffix text','','10.4.7'),('4185','More link label','','10.4.7'),('4186','The text to display for the more link.','','10.4.8'),('4187','Link URL','','10.4.7');
INSERT INTO `locales_source` VALUES ('4188','Are you sure you want to delete the @language translation of the @entity-type %label?','','10.4.7'),('4189','@language translation of the @type %label has been deleted.','','10.4.7'),('4190','The @type %title has been deleted.','','10.4.7'),('4191','@type %info has been updated.','','10.4.8'),('4192','The block settings have been updated.','','10.4.8'),('4193','more information','','10.4.7'),('4194','See the <a href=":performance_doc">setting MySQL transaction isolation level</a> page for more information.','','10.4.7'),('4195','@count second@count seconds','','10.4.7'),('4196','Upload progress','','10.4.7'),('4197','Database support for JSON','','10.4.7'),('4198','Module and theme update status','','10.4.7'),('4199','Drupal core security coverage','','10.4.7'),('4200','GD library','','10.4.7'),('4201','Transaction isolation level','','10.4.7'),('4202','Drupal core update status','','10.4.7'),('4203','Node Access Permissions','','10.4.7'),('4204','Markup caching disabled','','10.4.7'),('4205','Search index progress','','10.4.7'),('4206','Twig development mode','','10.4.7'),('4207','Trusted Host Settings','','10.4.7'),('4208','SameSite cookie attribute','','10.4.7'),('4209','Access to update.php','','10.4.7'),('4210','Web server','','10.4.7'),('4211','Entity/field definitions','','10.4.7'),('4212','Database updates','','10.4.7'),('4213','PHP extensions','','10.4.7'),('4214','Cron maintenance tasks','','10.4.7'),('4215','PHP OPcode caching','','10.4.7'),('4216','Configuration files','','10.4.7'),('4217','PHP APCu caching','','10.4.7');
INSERT INTO `locales_source` VALUES ('4218','PHP memory limit','','10.4.7'),('4219','Font Awesome','','10.4.7'),('4220','PHP APCu available caching','','10.4.7'),('4221','Database system version','','10.4.7'),('4222','Random number generation','','10.4.7'),('4223','Database system','','10.4.7'),('4224','Compress layout by hiding descriptions.','','10.4.7'),('4225','Hide descriptions','','10.4.7'),('4226','Alias','','10.4.7'),('4227','Path alias','','10.4.7'),('4228','Filter aliases','','10.4.7'),('4229','Patterns','','10.4.7'),('4230','Bulk generate','','10.4.7'),('4231','Delete aliases','','10.4.7'),('4232','An alias defines a different name for an existing URL path - for example, the alias ''about'' for the URL path ''node/1''. A URL path can have multiple aliases.','','10.4.7'),('4233','Add alias','','10.4.7'),('4234','Select the types of paths for which to generate URL aliases','','10.4.7'),('4235','Generate a URL alias for un-aliased paths only','','10.4.7'),('4236','Update the URL alias for paths having an old URL alias','','10.4.7'),('4237','Regenerate URL aliases for all paths','','10.4.7'),('4238','Select which URL aliases to generate','','10.4.7'),('4239','Bulk generation can be used to generate URL aliases for items that currently have no aliases. This is typically used when installing Pathauto on a site that has existing un-aliased content that needs to be aliased in bulk.','','10.4.7'),('4240','It can also be used to regenerate URL aliases for items that have an old alias and for which the Pathauto pattern has been changed.','','10.4.7'),('4241','Note that this will only affect items which are configured to have their URL alias automatically set. Items whose URL alias is manually set are not affected.','','10.4.7'),('4242','Bulk updating URL aliases','','10.4.7'),('4243','Updated alias for %label @id.','','10.4.7'),('4244','Generated 1 URL alias.Generated @count URL aliases.','','10.4.7'),('4245','Non-translatable fields can only be changed when updating the original language.','','10.4.7'),('4246','Select source language','','10.4.7'),('4247','Change','','10.4.7');
INSERT INTO `locales_source` VALUES ('4248','Source language: @language','','10.4.7'),('4249','Source language set to: %language','','10.4.7'),('4250','Menu block','','10.4.7'),('4251','@count hour@count hours','','10.4.7'),('4252','Syndicate','','10.4.8'),('4253','Language switcher','','10.4.8'),('4254','Enter a part of the block name to filter by.','','10.4.8'),('4255','Filter by block name','','10.4.8'),('4256','Announcements Feed','','10.4.8'),('4257','Place block','','10.4.8'),('4258','Save and configure','','10.4.8'),('4259','Updated vocabulary %name.','','10.4.7'),('4260','vocabulary','','10.4.7'),('4261','%capital_name contains terms grouped under parent terms. You can reorganize the terms in %capital_name using their drag-and-drop handles.','','10.4.7'),('4262','field','','10.4.7'),('4263','The field %field has been deleted from the %type %source_label.','','10.4.7'),('4264','Add %label for @entity-type','','10.4.7'),('4265','This text will be displayed on the @mode_label list page.','','10.4.7'),('4266','@label entities','','10.4.7'),('4267','Enable this @display-mode for the following @bundle-label types:','','10.4.7'),('4268','This @display-mode will still be available for the rest of the @bundle-label types if not checked here, but it will not be enabled by default.','','10.4.7'),('4269','Edit view mode','','10.4.7'),('4270','Saved the %label @entity-type.','','10.4.7'),('4271','<a href=":url">Configure the %display_mode_label %mode mode for %bundle_label</a>.','','10.4.7'),('4272','Original image','','10.4.7'),('4273','Menu link entry','','10.4.7'),('4274','No menu entry','','10.4.7'),('4275','Normal menu entry','','10.4.7'),('4276','Menu tab','','10.4.7'),('4277','Default menu tab','','10.4.7');
INSERT INTO `locales_source` VALUES ('4278','If selected and this menu link has children, the menu will always appear expanded.','','10.4.7'),('4279','In the menu, the heavier links will sink and the lighter links will be positioned nearer the top.','','10.4.7'),('4280','Context','','10.4.7'),('4281','Displays the link in contextual links','','10.4.7'),('4282','Trimmed limit','','10.4.7'),('4283','If the summary is not set, the trimmed %label field will end at the last full sentence before this character limit.','','10.4.7'),('4284','Edit term','','10.4.7'),('4285','Subscribe to @title','','10.4.7'),('4286','A simple client-side hierarchical select widget for taxonomy terms.','','10.4.8'),('4287','A client-side hierarchical selection of parents for the menu link. Works for node and term forms (with "taxonomy_menu_ui" enabled).','','10.4.8'),('4288','Allows your views to be draggable and gives you the ability to set the order of how they appear.','','10.4.8'),('4289','Demo module for Draggableviews.','','10.4.8'),('4290','Widgets','','10.4.8'),('4291','Module %name has been installed.@count modules have been installed: %names.','','10.4.7'),('4292','Client-side hierarchical select','','10.4.7'),('4293','- Please select -','','10.4.7'),('4294','Чланак','','10.4.7'),('4295','Parent: @parent','','10.4.7'),('4296','Hierarchy depth: @hierarchy_depth','','10.4.7'),('4297','Required depth: @required_depth','','10.4.7'),('4298','Force deepest: @force_deepest','','10.4.7'),('4299','Save lineage: @save_lineage','','10.4.7'),('4300','Level labels: @level_labels','','10.4.7'),('4301','The "no selection" label: @none_label','','10.4.7'),('4302','Select a parent term to use only a subtree of a vocabulary for this field.','','10.4.7'),('4303','Limits the nesting level. Use 0 to display all values. For the hierarchy like<br />"a" -> "b" -> "c" the selection of 2 will result in "b" being the deepest option.<br /><i>Ignored when the deepest selection is enforced.</i>','','10.4.7'),('4304','Requires item selection at the given nesting level. Use 0 to not impose the<br />requirement. For the hierarchy like "a" -> "b" -> "c" the selection of 2 will<br />obey a user to select at least "a" and "b".<br /><i>Ignored when the deepest selection is enforced.</i>','','10.4.7');
INSERT INTO `locales_source` VALUES ('4305','Force the deepest level selection','','10.4.7'),('4306','If checked the user will be forced to select terms from the deepest level.','','10.4.7'),('4307','Save lineage','','10.4.7'),('4308','<b class="color-error">There is data for this field in the database. This setting can no longer be changed.<br />The option can be enabled only for fields with unlimited cardinality.</b><br />Save all parents of the selected term. Please note that you will not have a<br />familiar field when multiple items can be added via the "Add more" button.<br />In fact, the field will look like a "single" and the selected terms will<br />be stored each as a separate field value.<br /><br /><b>Keep in mind</b> that this setting cannot be changed once the field storage<br />gets at least one item. The restriction is imposed across all bundles of<br />the "Садржај" entity type.','','10.4.7'),('4309','Labels per hierarchy-level','','10.4.7'),('4310','Enter labels for each hierarchy-level separated by comma.','','10.4.7'),('4311','The "no selection" label','','10.4.7'),('4312','The label for an empty option.','','10.4.7'),('4313','@label field is required.','','10.4.7'),('4314','<b class="color-error">There is data for this field in the database. This setting can no longer be changed.<br />The option can be enabled only for fields with unlimited cardinality.</b><br />Save all parents of the selected term. Please note that you will not have a<br />familiar field when multiple items can be added via the "Add more" button.<br />In fact, the field will look like a "single" and the selected terms will<br />be stored each as a separate field value.<br /><br /><b>Keep in mind</b> that this setting cannot be changed once the field storage<br />gets at least one item. The restriction is imposed across all bundles of<br />the "Content" entity type.','','10.4.7'),('4315','Convert entity bundles from one value to another','','10.4.8'),('4316','Action @label created from convert_bundles module.','','10.4.7'),('4317','Convert Entity Bundles','','10.4.8');
INSERT INTO `locales_source` VALUES ('4318','Convert Bundles','','10.4.8'),('4319','Select Bundles to Convert (Bundles are from all entities selected)','','10.4.7'),('4320','This module is experimental. PLEASE do not use on production databases without prior testing and a complete database dump.','','10.4.7'),('4321','Bundle Name(s)','','10.4.7'),('4322','Select the Bundle to Convert Selected Entities to','','10.4.7'),('4323','To Bundle','','10.4.7'),('4324','From Field [@field_name] @field_label:<br> To Field','','10.4.7'),('4325','Create field values for new fields in target content type','','10.4.7'),('4326','Are you sure you want to convert @target of type <em>@from_type</em> to type <em>@to_type</em>?','','10.4.7'),('4327','1 selected entity@count selected entities','','10.4.7'),('4328','Convert','','10.4.7'),('4329','Selected entities of type @from_type were converted to @to_type','','10.4.7'),('4330','Converting Base Tables...','','10.4.7'),('4331','Adding fields for entity @entity of @total.','','10.4.7'),('4332','One operation processed.@count operations processed.','','10.4.7'),('4333','Convert Bundle','','10.4.8'),('4334','Store new items in','','10.4.7'),('4335','Client-side Hierarchical Select','','10.4.7'),('4336','Rearrange @type','','10.4.7'),('4337','No filters have been added.','','10.4.7'),('4338','Drag to add filters.','','10.4.7'),('4339','And','','10.4.7'),('4340','Or','','10.4.7'),('4341','Default group','','10.4.7'),('4342','Weight for @id','','10.4.7'),('4343','Group for @id','','10.4.7'),('4344','Remove @id','','10.4.7'),('4345','Remove this item','','10.4.7'),('4346','Create new filter group','','10.4.7'),('4347','Configuration deletions','','10.4.7');
INSERT INTO `locales_source` VALUES ('4348','Deleting a term will delete all its children if there are any. This action cannot be undone.','','10.4.7'),('4349','Deleted term %name.','','10.4.7'),('4350','Установа','','10.4.7'),('4351','КЛЕР','','10.4.7'),('4352','@type %info has been created.','','10.4.8'),('4353','This will remove the block placement. You will need to <a href=":url">place it again</a> in order to undo this action.','','10.4.7'),('4354','Are you sure you want to remove the @entity-type %label from the %region region?','','10.4.7'),('4355','The @entity-type %label has been removed from the %region region.','','10.4.7'),('4356','No fields are present yet.','','10.4.7'),('4357','Урбанизам и архитектура','','10.4.7'),('4358','Deleting a vocabulary will delete all the terms in it. This action cannot be undone.','','10.4.7'),('4359','Are you sure you want to delete the vocabulary %title?','','10.4.7'),('4360','Deleted vocabulary %name.','','10.4.7'),('4361','Глобал','','10.4.7'),('4362','Историја','','10.4.7'),('4363','Урбанизам','','10.4.7'),('4364','Култура и религија','','10.4.7'),('4365','Filter modules','','10.4.8'),('4366','Uninstall @module module','','10.4.8'),('4367','The following reason prevents @module.module_name from being uninstalled:The following reasons prevent @module.module_name from being uninstalled:','','10.4.8'),('4368','There is content for the entity type: @entity_type. <a href=":url">Remove @entity_type_plural</a>.','','10.4.8'),('4369','content blocks','','10.4.8'),('4370','custom menu links','','10.4.8'),('4371','files','','10.4.8'),('4372','The %field_type_label field type is used in the following field: @fieldsThe %field_type_label field type is used in the following fields: @fields','','10.4.8'),('4373','Provides a filter plugin that is in use in the following filter formats: %formats','','10.4.8'),('4374','The module ''@module_name'' is providing the database driver ''@driver_name''.','','10.4.8'),('4375','shortcut links','','10.4.8'),('4376','Install with commonly used features pre-configured.','','10.4.8');
INSERT INTO `locales_source` VALUES ('4377','taxonomy terms','','10.4.8'),('4378','The uninstall process removes all data related to a module.','','10.4.8'),('4379','The following modules will be completely uninstalled from your site, and <em>all data from these modules will be lost</em>!','','10.4.8'),('4380','Would you like to continue with uninstalling the above?','','10.4.8'),('4381','Confirm uninstall','','10.4.8'),('4382','The selected modules have been uninstalled.','','10.4.8'),('4383','Translatable elements','','10.4.7'),('4384','Add a more link to the bottom of the display.','','10.4.8'),('4385','Create more link','','10.4.8'),('4386','This will add a more link to the bottom of this view, which will link to the page view. If you have more than one page view, the link will point to the display specified in ''Link display'' section under pager. You can override the URL at the link display setting.','','10.4.8'),('4387','Always display the more link','','10.4.8'),('4388','Check this to display the more link even if there are no more items to display.','','10.4.8'),('4389','More link text','','10.4.8'),('4390','Which display to use for path','','10.4.8'),('4391','Custom URL','','10.4.8'),('4392','Which display to use to get this display''s path for things like summary links, rss feed links, more links, etc.','','10.4.8'),('4393','A Drupal path or external URL the more link will point to. Note that this will override the link display setting above.','','10.4.8'),('4394','How should each row in this view be styled','','10.4.8'),('4395','Row','','10.4.8'),('4396','You may also adjust the @settings for the currently selected row style.','','10.4.8'),('4397','Row style options','','10.4.8'),('4398','How should this view be styled','','10.4.8'),('4399','Style','','10.4.8'),('4400','If the style you choose has settings, be sure to click the settings button that will appear next to it in the View summary.','','10.4.8'),('4401','You may also adjust the @settings for the currently selected style.','','10.4.8'),('4402','Style options','','10.4.7'),('4403','Row class','','10.4.7'),('4404','The class to provide on each row.','','10.4.7');
INSERT INTO `locales_source` VALUES ('4405','Add views row classes','','10.4.7'),('4406','Add the default row classes like @classes to the output. You can use this to quickly reduce the amount of markup the view provides by default, at the cost of making it more difficult to apply CSS.','','10.4.7'),('4407','Force using fields','','10.4.7'),('4408','If neither the row nor the style plugin supports fields, this field allows to enable them, so you can for example use groupby.','','10.4.7'),('4409','Unordered list','','10.4.7'),('4410','Ordered list','','10.4.7'),('4411','List type','','10.4.7'),('4412','Wrapper class','','10.4.7'),('4413','The class to provide on the wrapper, outside the list.','','10.4.7'),('4414','List class','','10.4.7'),('4415','The class to provide on the list element itself.','','10.4.7'),('4416','Choose view mode entity type','','10.4.7'),('4417','Add new @entity-type %label','','10.4.7'),('4418','@label (Original translation) - <em>The following @entity_type translations will be deleted:</em>','','10.4.7'),('4419','"On" label','','10.4.7'),('4420','"Off" label','','10.4.7'),('4421','This sort is not exposed. Expose it to allow the users to change it.','','10.4.7'),('4422','Expose this sort to visitors, to allow them to change it','','10.4.7'),('4423','Expose sort','','10.4.7'),('4424','The granularity is the smallest unit to use when determining whether two dates are the same; for example, if the granularity is "Year" then all dates in 1999, regardless of when they fall in 1999, will be considered the same date.','','10.4.7'),('4425','sort criterion','','10.4.7'),('4426','(version @version available)','','10.4.8'),('4427','There are updates available for your version of Drupal. To ensure the proper functioning of your site, you should update as soon as possible.','','10.4.8'),('4428','Deleted flexslider configuration','','10.4.7'),('4429','No available update data','','10.4.8'),('4430','No path is set','','10.4.8'),('4431','Display "@display" uses a path but the path is undefined.','','10.4.8'),('4432','Storage','','10.4.8'),('4433','Normal','','10.4.8'),('4434','Edit Quick Tab','','10.4.8');
INSERT INTO `locales_source` VALUES ('4435','Delete Quick Tab','','10.4.8'),('4436','Duplicate Quick Tab','','10.4.8'),('4437','Each QuickTabs instance has a corresponding block that is managed on the <a href=":link">blocks administration page</a>.','','10.4.8'),('4438','Add a Quick Tab Instance','','10.4.8'),('4439','quicktabs','','10.4.8'),('4440','accordion','','10.4.8'),('4441','jquery ui','','10.4.8'),('4442','view','','10.4.8'),('4443','qtabs','','10.4.8'),('4444','node','','10.4.8'),('4445','Enter name','','10.4.8'),('4446','This will appear as the block title.','','10.4.8'),('4447','A unique machine-readable name for this QuickTabs instance. It must only contain lowercase letters, numbers, and underscores. The machine name will be used internally by QuickTabs and will be used in the CSS ID of your QuickTabs block.','','10.4.8'),('4448','Renderer','','10.4.8'),('4449','Choose how to render the content.','','10.4.8'),('4450','Custom Tab Class','','10.4.8'),('4451','Additional classes to provide on each tab. Separated by a space.','','10.4.8'),('4452','-None-','','10.4.8'),('4453','Pamela','','10.4.8'),('4454','On the Gray','','10.4.8'),('4455','Tabs Bar','','10.4.8'),('4456','Material Tabs','','10.4.8'),('4457','Yes: Load only the first tab on page view','','10.4.8'),('4458','No: Load all tabs on page view.','','10.4.8'),('4459','Ajax','','10.4.8'),('4460','Choose how the content of tabs should be loaded.<p>By choosing "Yes", only the first tab will be loaded when the page first viewed. Content for other tabs will be loaded only when the user clicks the other tab. This will provide faster initial page loading, but subsequent tab clicks will be slower. This can place less load on a server.</p><p>By choosing "No", all tabs will be loaded when the page is first viewed. This will provide slower initial page loading, and more server load, but subsequent tab clicks will be faster for the user. Use with care if you have heavy views.</p><p>Warning: if you enable Ajax, any block you add to this quicktabs block will be accessible to anonymous users, even if you place role restrictions on the quicktabs block. Do not enable Ajax if the quicktabs block includes any blocks with potentially sensitive information.</p>','','10.4.8');
INSERT INTO `locales_source` VALUES ('4461','Collapsible','','10.4.8'),('4462','auto','','10.4.8'),('4463','fill','','10.4.8'),('4464','JQuery UI HeightStyle','','10.4.8'),('4465','JQuery UI options','','10.4.8'),('4466','Default tab','','10.4.8'),('4467','Hide empty tabs','','10.4.8'),('4468','Empty and restricted tabs will not be displayed. Could be useful when the tab content is not accessible.<br />This option does not work in ajax mode.','','10.4.8'),('4469','Tab title','','10.4.8'),('4470','Tab weight','','10.4.8'),('4471','Tab type','','10.4.8'),('4472','Tab content','','10.4.8'),('4473','Allowed html tags are <em>img</em>, <em>em</em>, <em>strong</em>, <em>h2</em>, <em>h3</em>, <em>h4</em>, <em>h5</em>, <em>h6</em>, <em>small</em>, <em>span</em>, <em>i</em>, and <em>br</em>.','','10.4.8'),('4474','Select a view','','10.4.8'),('4475','Additional arguments to send to the view as if they were part of the URL in the form of arg1/arg2/arg3. You may use %1, %2, ..., %N to grab arguments from the URL.','','10.4.8'),('4476','QuickTabs instance','','10.4.8'),('4477','The QuickTabs instance to put inside this tab.','','10.4.8'),('4478','Node','','10.4.8'),('4479','The node ID of the node.','','10.4.8'),('4480','Hide the title of this node','','10.4.8'),('4481','Select a block','','10.4.8'),('4482','Block Title','','10.4.8'),('4483','Display block title','','10.4.8'),('4484','Click here to delete this tab.','','10.4.8'),('4485','Click here to add more tabs.','','10.4.8'),('4486','Add tab','','10.4.8'),('4487','Your changes have been saved.','','10.4.8');
DROP TABLE IF EXISTS `locales_target`;
CREATE TABLE `locales_target` (   `lid` int(11) NOT NULL DEFAULT 0 COMMENT 'Source string ID. References "locales_source".lid.',   `translation` blob NOT NULL COMMENT 'Translation string value in this language.',   `language` varchar(12) CHARACTER SET ascii COLLATE ascii_general_ci NOT NULL DEFAULT '' COMMENT 'Language code. References "language".langcode.',   `customized` int(11) NOT NULL DEFAULT 0 COMMENT 'Boolean indicating whether the translation is custom to this site.',   PRIMARY KEY (`language`,`lid`),   KEY `lid` (`lid`) ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci COMMENT='Stores translated versions of strings.';
INSERT INTO `locales_target` VALUES ('2','Статусна порука','sr-Cyrl-RS','0'),('3','Порука о грешци','sr-Cyrl-RS','0'),('4','Порука о упозорењу','sr-Cyrl-RS','0'),('13','Произвољна порука: !customMessage','sr-Cyrl-RS','0'),('19','Промењен','sr-Cyrl-RS','0'),('34','затворена','sr-Cyrl-RS','0'),('38','Основни блок','sr-Cyrl-RS','0'),('40','Подразумевани коментари','sr-Cyrl-RS','0'),('41','Омогућава коментарисање садржаја','sr-Cyrl-RS','0'),('42','Повратна информација о сајту','sr-Cyrl-RS','0'),('43','Ваша порука је послата.','sr-Cyrl-RS','0'),('44','Постави на насловну страну','sr-Cyrl-RS','0'),('61','Главни текст','sr-Cyrl-RS','0'),('62','Коментар','sr-Cyrl-RS','0'),('66','Унеси листу одвојену зарезом. На пример: Амстердам, Мексико Сити, "Кливленд, Охајо"','sr-Cyrl-RS','0'),('68','Your virtual face or picture.','sr-Cyrl-RS','1'),('69','Основни HTML','sr-Cyrl-RS','0'),('70','Комплетан HTML','sr-Cyrl-RS','0'),('71','Ограничени ХТМЛ','sr-Cyrl-RS','0'),('72','Чланак','sr-Cyrl-RS','0'),('73','Користи <em>чланке</em> за садржаје за које су временски осетљиби. Као што су вести, саопштења за јавност или странице блога.','sr-Cyrl-RS','0'),('74','Страница','sr-Cyrl-RS','1'),('75','Користи <em>основне странице</em> за статичне садржаје, као што је страница ''О нама''.','sr-Cyrl-RS','0'),('77','Администратор','sr-Cyrl-RS','0'),('78','Непознати корисник','sr-Cyrl-RS','0'),('79','Регистровани корисник','sr-Cyrl-RS','0'),('81','Анонимни','sr-Cyrl-RS','0'),('88','Пун коментар','sr-Cyrl-RS','0'),('96','Подразумевано','sr-Cyrl-RS','0'),('103','енглески','sr-Cyrl-RS','0');
INSERT INTO `locales_target` VALUES ('106','Пун садржај','sr-Cyrl-RS','0'),('114','Постави садржај на насловну страну','sr-Cyrl-RS','0'),('115','Објави садржај','sr-Cyrl-RS','0'),('117','Уклони садржај са насловне стране','sr-Cyrl-RS','0'),('120','<em>HTML</em> тип датума','sr-Cyrl-RS','0'),('121','<em>HTML</em> тип датум/време','sr-Cyrl-RS','0'),('122','<em>HTML</em> тип месеца','sr-Cyrl-RS','0'),('124','<em>HTML</em> тип седмице','sr-Cyrl-RS','0'),('125','<em>HTML</em> тип године','sr-Cyrl-RS','0'),('126','<em>HTML</em> тип датума без године','sr-Cyrl-RS','0'),('127','Подразумевани дуги тип датума','sr-Cyrl-RS','0'),('131','Подразумевани кратки тип датума','sr-Cyrl-RS','0'),('133','@site је тренутно на одржавању. Ускоро би требало да буде враћен у функцију. Хвала на стрпљењу.','sr-Cyrl-RS','0'),('134','Мени корисничког налога','sr-Cyrl-RS','0'),('138','Подножје','sr-Cyrl-RS','0'),('140','Главна навигација','sr-Cyrl-RS','1'),('141','Главна навигација','sr-Cyrl-RS','1'),('151','Укини налоге изабраних корисника','sr-Cyrl-RS','0'),('152','Одблокирај изабране корисникe','sr-Cyrl-RS','0'),('153','Поднет је захтев за гашење налога [user:display-name] на сајту [site:name]','sr-Cyrl-RS','0'),('155','Креирајте нове лозинке за налог [user:display-name] на сајту [site:name]','sr-Cyrl-RS','0'),('156','[user:display-name],\r\n\r\nПоднели сте захтев за промену лозинке на сајту: [site:name].\r\n\r\nМожете се пријавити кликом на линк испод или ако исти копирате у бровсер:\r\n\r\n[user:one-time-login-url]\r\n\r\nОвај линк се може искористити само једном. Он ће вас одвести на страницу где ћете моћи изменити лозинку. Он ће истећи за 1 дан и ништа се неће десити ако га не искористите\r\n\r\n--  [site:name] tim.','sr-Cyrl-RS','0');
INSERT INTO `locales_target` VALUES ('157','Администратор је креирао налог за Вас на [site:name]','sr-Cyrl-RS','0'),('158','[user:display-name],\r\n\r\nАдминистратор [site:name] је направио налог за вас. Сада се можете пријавити кликом на линк испод:\r\n\r\n[user:one-time-login-url]\r\n\r\nОвај линк се може искористити само једном. Он ће вас одвести до странице где ћете морати унети лозинку за овај сајт.\r\n\r\nКада подесите лозинку, бићете у могућности да се пријавите на сајту, корисећи исту.\r\n\r\nАдреса за пријавлјиванје: [site:login-url]\r\n\r\nкорисничко име: [user:name]\r\nлозинка: Лозинка коју сте унели на предходном линку\r\n\r\n--  [site:name] тим','sr-Cyrl-RS','0'),('159','Детаљи налога [user:display-name] на [site:name]','sr-Cyrl-RS','0'),('160','[user:display-name],\r\n\r\nХвала што сте се регистровали на сајт [site:name]. Сада се можете пријавити кликом на линк испод.\r\n\r\n[user:one-time-login-url]\r\n\r\nОвај линк се може користити само једном и он ће вас одвести на страницу где ћете подесити своју лозинку за приступ овом сајту.\r\n\r\nНакон што подесите лозинку, можете се пријавити овде: [site:login-url] користећи следеће податке:\r\n\r\nкорисничко име: [user:name]\r\nлозинка: Лозинка коју сте поставили на горњем линку\r\n\r\n--  [site:name] тим.','sr-Cyrl-RS','0'),('161','Налог за корисничко име [user:display-name] на [site:name] (чека на одобренје)','sr-Cyrl-RS','0');
INSERT INTO `locales_target` VALUES ('163','[user:display-name] се пријавио за отваранје налога.\r\n\r\n[user:edit-url]','sr-Cyrl-RS','0'),('164','Детаљи налога [user:display-name] на [site:name] (одобрен)','sr-Cyrl-RS','0'),('165','[user:display-name],\r\n\r\nВаш налог на сајту [site:name] је активан.\r\n\r\nСада се можете пријавити на кликом на линк испод:\r\n\r\n[user:one-time-login-url]\r\n\r\nОвај линк се може искористити само једном. Он ће вас одвести до странице где ћете морати унети лозинку за овај сајт.\r\n\r\nНакон што подесите лозинку, можете се пријавити овде: [site:login-url] користећи следеће податке:\r\n\r\nкорисничко име: [user:account-name]\r\nлозинка: Лозинка коју сте поставили на горњем линку\r\n\r\n--  [site:name] тим.','sr-Cyrl-RS','0'),('166','Налог [user:display-name] на [site:name] (је блокиран)','sr-Cyrl-RS','0'),('167','[user:display-name],\r\n\r\nВаш налог на сајту [site:name] је блокиран.\r\n\r\n--  [site:name] тим','sr-Cyrl-RS','0'),('168','Налог за  [user:display-name] на [site:name] (је обрисан)','sr-Cyrl-RS','0'),('169','[user:display-name],\r\n\r\nVaš nalog na sajtu [site:name] je obrisan.\r\n\r\n--  [site:name] tim.','sr-Cyrl-RS','0'),('174','Опис блока','sr-Cyrl-RS','0'),('178','Операције','sr-Cyrl-RS','0'),('186','Сортирај по','sr-Cyrl-RS','0'),('194','Акција','sr-Cyrl-RS','0'),('195','Предмет','sr-Cyrl-RS','0'),('196','Аутор','sr-Cyrl-RS','0'),('202','Филтрирај','sr-Cyrl-RS','0'),('205','Језик','sr-Cyrl-RS','0'),('206','још','sr-Cyrl-RS','0'),('214','Последњи коментари','sr-Cyrl-RS','0'),('215','Последњи коментари.','sr-Cyrl-RS','0');
