INSERT INTO `search_dataset` VALUES ('128','sr-Cyrl-RS','node_search',' кц младост футог кц младост футог admin wed 5282025 1203 културно информативни центар младост футог основан је 1974 године с циљем да организује културни живот у месту центар се налази у лепој старој згради у центру футога у главној улици цара лазара 42 оснивач центра је скупштина града новог сада већ више од тридесет година киц младост својим програмима настоји да оплемени и учини садржајнијим свакодневицу својих суграђана посебно оних најмлађих у оквиру центра делују ансамбл народних песама и игара тамбурашки оркестар школа тамбуре студио модерног плеса мирослав батак мићко драмски студио макса вругић галерија нижа музичка школа одсеци гитара хармоника и флаута школа енглеског језика за децу и одрасле радио футог 995 мхз клубкантина центар у складу са својом делатношћу организује бројне програме и манифестације манифестације  божићне чаролије најлепше ускршње јаје футоко лето фестивал ношњи накита и оглавља бисерна грана етно манифестација купусијада  програми  концертни програми изложбе драмски програми позоришне представе за децу и одрасле радионице трибине предавања промоције јануар  велика зимска бајка 3 5 јануар велика зимска бајка новогодишња манифестација за децу на којој у празничној атмосфери деца могу да уживају у различитим садржајима позоришним представама са новогодишњом тематиком концертима плесним изведбама дружењу са аниматорима да учествују у ликовним и литерарним радионицама да се друже са писцима и др у оквиру ове манифестације ансамбл народних песама и игара изводи свој традиционални божићни концерт светосавска свечаност сваке године центар у сарадњи са основним школама у футогу и црквеном општином у футогу обележава дан светог саве уз представу концерт и светосавску академију фебруар дан светог трифуна дан заљубљених 14фебруар дан светог трифуна дан заљубљених вече поезије евергрин музике март дамама на дар 7 март 2009 дамама на дар програм за све наше маме и све даме први глас футога такмичење певача аматера традиционално такмичење које промовише младе талентоване певаче април најлепше ускршње јаје најлепше ускршње јаје је програм намењен најмлађим суграђанима који се на велику суботу припремају да дочекају најрадоснији хришћански празник ускрс деца учествују у радионици осликавања ускршњих јаја у позоришној представи и дружењу са аниматорима мај меморијал мирослав батак мићко плесни студио киц младост већ годинама организује плесни спектакл меморијал мирослав батак мићко који окупља плесне студије из новог сада и земље меморијал није такмичарског карактера већ има за циљ да плесни студији представе свој рад и тако промовишу плес не само као уметност већ као начин здравог живљења јун футошко лето последња седмица у јуну футошко лето је још један од програма центра намењен превасходно најмлађима радионицедружионице позоришне представе концерти изложбе маскенбали укључени су у програме ове радо посећене манифестације септембар фестивал ношње накита и оглавља бисерна грана бисерна грана је фестивал којим желимо да укажемо на значај очувања материјалног фолклорног наслеђа и да наше фолклорно благо народне ношње и оглавља прикажемо ван класичног наступа на сцени програми фестивала изложба отворене трибине радионице ревија народних ношњи и оглавља концерт октобар дечја недеља манифестација је посвећена заштити права деце и афирмацији конвенције о заштити права детета сваке године се бира тема манифестације и организују се програми намењени деци школског и предшколског узраста спортске активности ликовне изложбе позоришне и музичке представе и др ликовна колонија черевићка колонија окупља ликовне ствараоце из земље и окружења који боравећи у футогу бележе његове знаменитости настала дела по завршетку колоније излажу се у галерији центра новембар етно манифестација купусијада манифестација чији је циљ промоција купуса као најзначајнијег пољопривредног производа футога футог многи с правом називају престоницом купуса захваљујући овом поврћу за футог се чуло далеко изван граница наше земље јер како футожани воле да кажу футошки купус је за класу испред свихорганизују се такмичења у припремању јела од купуса и избор најтеже главице купуса уз богат културнозабавни програм децембар новогодишњи програми установа чији је оснивач град нови сад ','0');
INSERT INTO `search_dataset` VALUES ('128','sr-Latn-RS','node_search',' kc mladost futog kc mladost futog admin wed 5282025 1204 kulturno informativni centar mladost futog osnovan je 1974 godine s ciljem da organizuje kulturni zivot u mestu centar se nalazi u lepoj staroj zgradi u centru futoga u glavnoj ulici cara lazara 42 osnivac centra je skupstina grada novog sada vec vise od trideset godina kic mladost svojim programima nastoji da oplemeni i ucini sadrzajnijim svakodnevicu svojih sugradana posebno onih najmladih u okviru centra deluju ansambl narodnih pesama i igara tamburaski orkestar skola tambure studio modernog plesa miroslav batak micko dramski studio maksa vrugic galerija niza muzicka skola odseci gitara harmonika i flauta skola engleskog jezika za decu i odrasle radio futog 995 mhz klubkantina centar u skladu sa svojom delatnoscu organizuje brojne programe i manifestacije manifestacije  bozicne carolije najlepse uskrsnje jaje futoko leto festival nosnji nakita i oglavlja biserna grana etno manifestacija kupusijada  programi  koncertni programi izlozbe dramski programi pozorisne predstave za decu i odrasle radionice tribine predavanja promocije januar  velika zimska bajka 3 5 januar velika zimska bajka novogodisnja manifestacija za decu na kojoj u praznicnoj atmosferi deca mogu da uzivaju u razlicitim sadrzajima pozorisnim predstavama sa novogodisnjom tematikom koncertima plesnim izvedbama druzenju sa animatorima da ucestvuju u likovnim i literarnim radionicama da se druze sa piscima i dr u okviru ove manifestacije ansambl narodnih pesama i igara izvodi svoj tradicionalni bozicni koncert svetosavska svecanost svake godine centar u saradnji sa osnovnim skolama u futogu i crkvenom opstinom u futogu obelezava dan svetog save uz predstavu koncert i svetosavsku akademiju februar dan svetog trifuna dan zaljubljenih 14februar dan svetog trifuna dan zaljubljenih vece poezije evergrin muzike mart damama na dar 7 mart 2009 damama na dar program za sve nase mame i sve dame prvi glas futoga takmicenje pevaca amatera tradicionalno takmicenje koje promovise mlade talentovane pevace april najlepse uskrsnje jaje najlepse uskrsnje jaje je program namenjen najmladim sugradanima koji se na veliku subotu pripremaju da docekaju najradosniji hriscanski praznik uskrs deca ucestvuju u radionici oslikavanja uskrsnjih jaja u pozorisnoj predstavi i druzenju sa animatorima maj memorijal miroslav batak micko plesni studio kic mladost vec godinama organizuje plesni spektakl memorijal miroslav batak micko koji okuplja plesne studije iz novog sada i zemlje memorijal nije takmicarskog karaktera vec ima za cilj da plesni studiji predstave svoj rad i tako promovisu ples ne samo kao umetnost vec kao nacin zdravog zivljenja jun futosko leto poslednja sedmica u junu futosko leto je jos jedan od programa centra namenjen prevashodno najmladima radionicedruzionice pozorisne predstave koncerti izlozbe maskenbali ukljuceni su u programe ove rado posecene manifestacije septembar festival nosnje nakita i oglavlja biserna grana biserna grana je festival kojim zelimo da ukazemo na znacaj ocuvanja materijalnog folklornog nasleda i da nase folklorno blago narodne nosnje i oglavlja prikazemo van klasicnog nastupa na sceni programi festivala izlozba otvorene tribine radionice revija narodnih nosnji i oglavlja koncert oktobar decja nedelja manifestacija je posvecena zastiti prava dece i afirmaciji konvencije o zastiti prava deteta svake godine se bira tema manifestacije i organizuju se programi namenjeni deci skolskog i predskolskog uzrasta sportske aktivnosti likovne izlozbe pozorisne i muzicke predstave i dr likovna kolonija cerevicka kolonija okuplja likovne stvaraoce iz zemlje i okruzenja koji boraveci u futogu beleze njegove znamenitosti nastala dela po zavrsetku kolonije izlazu se u galeriji centra novembar etno manifestacija kupusijada manifestacija ciji je cilj promocija kupusa kao najznacajnijeg poljoprivrednog proizvoda futoga futog mnogi s pravom nazivaju