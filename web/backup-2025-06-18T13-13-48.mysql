INSERT INTO `locales_source` VALUES ('1317','Submitted by @author_name on @date','','10.4.8'),('1318','Account''s permissions','','none'),('1319','The hashed password','','none'),('1320','Existing password','','none'),('1321','Contains US ASCII characters only','','none'),('1322','Checkout complete! Thank you for your purchase.','','none'),('1323','Delete @language translation','','10.4.7'),('1324','Provides a link to add a new block.','','none'),('1325','Timestamp display format settings','','none'),('1326','Future format','','none'),('1327','Past format','','none'),('1328','Plural variants','','none'),('1329','The %language translation file could not be downloaded. <a href=":url">Choose a different language</a> or select English and translate your website later.','','none'),('1330','Check the messages and <a href=":retry">retry</a>, or you may choose to <a href=":cont">continue anyway</a>.','','none'),('1331','The following modules are required but were not found. Move them into the appropriate modules subdirectory, such as <em>/modules</em>. Missing modules: @modules','','none'),('1332','Updating @module','','none'),('1333','WARNING: You are not using an encrypted connection, so your password will be sent in plain text. <a href=":https-link">Learn more</a>.','','none'),('1334','The message that should be sent. You may include placeholders like [node:title], [user:account-name], [user:display-name] and [comment:body] to represent data that will be different each time message is sent. Not all placeholders will be available in all contexts.','','none'),('1335','The message to be displayed to the current user. You may include placeholders like [node:title], [user:account-name], [user:display-name] and [comment:body] to represent data that will be different each time message is sent. Not all placeholders will be available in all contexts.','','none'),('1336','<a href=":login">Log in</a> or <a href=":register">register</a> to post comments','','none'),('1337','<a href=